@echo off
setlocal EnableExtensions DisableDelayedExpansion
title GBC WorkHub CMC Agent Setup

set "INSTALL_DIR=C:\GBCWorkHub"
set "EXE=%INSTALL_DIR%\SessionAgent.exe"
set "TEMP_B64=%TEMP%\GBCWorkHub_CMC_Agent.b64"
set "TEMP_CS=%TEMP%\GBCWorkHub_CMC_Agent.cs"

echo.
echo ==========================================
echo   GBC WorkHub - CMC Agent Setup
echo ==========================================
echo.

net session >nul 2>&1
if not "%errorlevel%"=="0" (
    echo [ERROR] Administrator permission is required.
    echo Right-click this CMD and choose "Run as administrator".
    echo.
    pause
    exit /b 1
)

set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"

if not exist "%CSC%" (
    echo [ERROR] .NET Framework C# compiler was not found.
    pause
    exit /b 1
)

if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%"
if errorlevel 1 (
    echo [ERROR] Cannot create C:\GBCWorkHub.
    pause
    exit /b 1
)

echo [1/4] Extracting SessionAgent source...

> "%TEMP_B64%" (
    for /f "usebackq delims=" %%L in (`findstr /B /C:"AGENT64:" "%~f0"`) do (
        set "LINE=%%L"
        setlocal EnableDelayedExpansion
        echo(!LINE:~8!
        endlocal
    )
)

certutil -f -decode "%TEMP_B64%" "%TEMP_CS%" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Failed to extract embedded source.
    goto FAIL
)

echo [2/4] Building SessionAgent.exe...

"%CSC%" /nologo /target:exe /platform:anycpu ^
 /reference:System.dll ^
 /reference:System.Windows.Forms.dll ^
 /reference:System.Security.dll ^
 /out:"%EXE%" "%TEMP_CS%"

if errorlevel 1 (
    echo [ERROR] SessionAgent build failed.
    goto FAIL
)

if not exist "%EXE%" (
    echo [ERROR] SessionAgent.exe was not created.
    goto FAIL
)

echo [3/4] Starting setup...
echo.
"%EXE%" setup

if errorlevel 1 (
    echo.
    echo [ERROR] SessionAgent setup failed.
    goto FAIL
)

echo.
echo [4/4] Verifying scheduled tasks...

schtasks /Query /TN "GBCWorkHub_CMC_Connect" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] CONNECT scheduled task was not found.
    goto FAIL
)

schtasks /Query /TN "GBCWorkHub_CMC_Disconnect" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] DISCONNECT scheduled task was not found.
    goto FAIL
)

del /q "%TEMP_B64%" "%TEMP_CS%" >nul 2>&1

echo.
echo ==========================================
echo   INSTALL COMPLETE
echo ==========================================
echo.
echo C:\GBCWorkHub\SessionAgent.exe
echo C:\GBCWorkHub\TfsCredential.dat
echo.
echo You may delete this Setup_CMC.cmd after installation.
echo.
pause
exit /b 0

:FAIL
del /q "%TEMP_B64%" "%TEMP_CS%" >nul 2>&1
echo.
pause
exit /b 1

