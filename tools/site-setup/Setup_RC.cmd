@echo off
setlocal EnableExtensions DisableDelayedExpansion
title GBC WorkHub RC Agent Setup

set "INSTALL=C:\GBCWorkHub"
set "AGENT=%INSTALL%\SessionAgent.exe"

set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"

set "A64=%TEMP%\GBC_RC_Agent.b64"
set "ACS=%TEMP%\GBC_RC_Agent.cs"
set "H64=%TEMP%\GBC_RC_Helper.b64"
set "HCS=%TEMP%\GBC_RC_Helper.cs"
set "HEXE=%TEMP%\GBC_RC_Helper.exe"

echo.
echo ==========================================
echo   GBC WorkHub - RC Agent Setup
echo ==========================================
echo.

net session >nul 2>&1
if not "%errorlevel%"=="0" (
    echo [ERROR] Administrator permission is required.
    echo Run this CMD as administrator under the RC Windows user.
    echo.
    pause
    exit /b 1
)

if not exist "%CSC%" (
    echo [ERROR] csc.exe not found.
    echo .NET Framework 4.x is required.
    pause
    exit /b 1
)

if not exist "%INSTALL%" mkdir "%INSTALL%"
if errorlevel 1 (
    echo [ERROR] Cannot create C:\GBCWorkHub.
    pause
    exit /b 1
)

echo [1/5] Extracting RC Agent...

> "%A64%" (
    for /f "usebackq delims=" %%L in (`findstr /B /C:"AGENT64:" "%~f0"`) do (
        set "LINE=%%L"
        setlocal EnableDelayedExpansion
        echo(!LINE:~8!
        endlocal
    )
)

certutil -f -decode "%A64%" "%ACS%" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Agent extraction failed.
    goto FAIL
)

echo [2/5] Building SessionAgent.exe...

"%CSC%" ^
 /nologo ^
 /target:winexe ^
 /platform:anycpu ^
 /reference:System.dll ^
 /reference:System.Core.dll ^
 /reference:System.Windows.Forms.dll ^
 /reference:System.Security.dll ^
 /out:"%AGENT%" ^
 "%ACS%"

if errorlevel 1 (
    echo [ERROR] SessionAgent build failed.
    goto FAIL
)

if not exist "%AGENT%" (
    echo [ERROR] SessionAgent.exe was not created.
    goto FAIL
)

echo [3/5] Preparing RC setup...

> "%H64%" (
    for /f "usebackq delims=" %%L in (`findstr /B /C:"HELPER64:" "%~f0"`) do (
        set "LINE=%%L"
        setlocal EnableDelayedExpansion
        echo(!LINE:~9!
        endlocal
    )
)

certutil -f -decode "%H64%" "%HCS%" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Setup extraction failed.
    goto FAIL
)

"%CSC%" ^
 /nologo ^
 /target:exe ^
 /platform:anycpu ^
 /reference:System.dll ^
 /reference:System.Security.dll ^
 /out:"%HEXE%" ^
 "%HCS%"

if errorlevel 1 (
    echo [ERROR] Setup helper build failed.
    goto FAIL
)

echo.
echo [4/5] TFS credential and scheduler setup
echo.

"%HEXE%"
if errorlevel 1 (
    echo.
    echo [ERROR] RC setup failed.
    goto FAIL
)

echo.
echo [5/5] Verifying...

schtasks /Query /TN "GBCWorkHub_RC_Connect" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] CONNECT task was not found.
    goto FAIL
)

schtasks /Query /TN "GBCWorkHub_RC_Disconnect" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] DISCONNECT task was not found.
    goto FAIL
)

del /q "%A64%" "%ACS%" "%H64%" "%HCS%" "%HEXE%" >nul 2>&1

echo.
echo ==========================================
echo        INSTALL COMPLETE
echo ==========================================
echo.
echo Agent:
echo C:\GBCWorkHub\SessionAgent.exe
echo.
echo Credential:
echo C:\GBCWorkHub\TfsCredential.dat
echo.
echo Scheduled Tasks:
echo GBCWorkHub_RC_Connect
echo GBCWorkHub_RC_Disconnect
echo.
echo Reconnect to RC and test GBC WorkHub.
echo.
pause
exit /b 0

:FAIL
del /q "%A64%" "%ACS%" "%H64%" "%HCS%" "%HEXE%" >nul 2>&1
echo.
pause
exit /b 1

