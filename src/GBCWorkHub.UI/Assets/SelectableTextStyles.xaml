<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TextBlock처럼 보이지만 드래그 선택/Ctrl+C 복사가 되는 읽기 전용 TextBox. -->
    <Style x:Key="SelectableTextStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsUndoEnabled" Value="False" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- Assets/WorkLogStyles.xaml의 WorkLogInfoTileValue(TextBlock)와 동일한 서식의 TextBox 버전. -->
    <Style x:Key="WorkLogInfoTileValueSelectable" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- WorkLogStyles.xaml의 WorkLogInfoTileLabel/WorkLogDetailCardTitle(TextBlock)과 동일한 서식의 TextBox 버전. -->
    <Style x:Key="WorkLogInfoTileLabelSelectable" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="WorkLogDetailCardTitleSelectable" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- WorkLogStyles.xaml의 WorkLogChip*Text(TextBlock, 타입/카테고리/배포 칩)와 동일한 서식의 TextBox 버전. -->
    <Style x:Key="WorkLogChipTypeTextSelectable" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#C2410C" />
    </Style>
    <Style x:Key="WorkLogChipCategoryTextSelectable" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#047857" />
    </Style>
    <Style x:Key="WorkLogChipDeployTextSelectable" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1D4ED8" />
    </Style>

    <!-- WorkLogEditDialog의 변경 이력 ChangeDetailText(TextBlock)와 동일한 강조색 트리거의 TextBox 버전. -->
    <Style x:Key="WorkLogChangeDetailTextSelectable" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
        <Setter Property="Foreground" Value="#334155" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAppended}" Value="True">
                <Setter Property="Foreground" Value="#166534" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
