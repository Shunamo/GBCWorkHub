<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      ThemeConfig = Tailwind theme.fontSize / fontFamily
      Change numbers here to scale typography app-wide.

      Usage:
        FontSize="{StaticResource FontSize.Base}"
        FontFamily="{DynamicResource AppFontFamily}"
    -->

    <FontFamily x:Key="AppFontFamily">Segoe UI, Malgun Gothic</FontFamily>

    <!-- fontSize (px): xs sm base md lg xl xxl xxxl
         Pretendard는 맑은 고딕보다 작게 보여 Base를 13으로 둔다. -->
    <sys:Double x:Key="FontSize.Xs">11</sys:Double>
    <sys:Double x:Key="FontSize.Sm">12</sys:Double>
    <sys:Double x:Key="FontSize.Base">13</sys:Double>
    <sys:Double x:Key="FontSize.Md">14</sys:Double>
    <sys:Double x:Key="FontSize.Lg">15</sys:Double>
    <sys:Double x:Key="FontSize.Xl">16</sys:Double>
    <sys:Double x:Key="FontSize.Xxl">18</sys:Double>
    <sys:Double x:Key="FontSize.Xxxl">20</sys:Double>

</ResourceDictionary>
