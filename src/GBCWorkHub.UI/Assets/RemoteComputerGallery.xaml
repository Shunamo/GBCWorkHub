<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

    <SolidColorBrush x:Key="RemoteAvailableBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="RemoteConnectingBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="RemoteInUseBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="RemoteCheckRequiredBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="RemoteVpnReadyBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="RemoteAvailableFillBrush" Color="#D9F0FDF4" />
    <SolidColorBrush x:Key="RemoteInUseFillBrush" Color="#D9FEF2F2" />
    <SolidColorBrush x:Key="RemoteCheckRequiredFillBrush" Color="#D9F8FAFC" />
    <SolidColorBrush x:Key="RemoteSidebarBgBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="RemoteGalleryBgBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="RemoteCardBorderBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="RemoteCardSelectedBrush" Color="#4F67D8" />

    <Style x:Key="RemoteComputerSidebarButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="Accent" Width="3" HorizontalAlignment="Left"
                                    Background="Transparent" CornerRadius="2" Margin="-8,0,0,0" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCE8F0FF" />
                            <Setter TargetName="Accent" Property="Background" Value="#4F67D8" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#99FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RemoteComputerToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#A6FFFFFF" />
        <Setter Property="BorderBrush" Value="#F2FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RemoteComputerCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,8,12,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#66FFFFFF" />
                <Setter Property="CornerRadius" Value="16" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RemoteComputerStatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="#DCFCE7" />
    </Style>

    <Style x:Key="RemoteComputerPreviewStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="14,14,0,0" />
    </Style>

    <Style x:Key="RemoteComputerDisabledOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="CornerRadius" Value="14,14,0,0" />
    </Style>

    <!-- Used by RemoteWorkspaceView + MainWindow header (must be App-level) -->
    <Style x:Key="HeaderIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Opacity="{TemplateBinding Opacity}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Used by RemoteWorkspaceView (must be App-level; UserControl cannot see MainWindow.Resources) -->
    <Style x:Key="SiteTileStyle" TargetType="Button">
        <Setter Property="Background" Value="#A6FFFFFF" />
        <Setter Property="BorderBrush" Value="#F2FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.10" Color="#3B5070" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D9E8FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1E293B" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
