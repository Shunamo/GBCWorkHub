<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeConfig.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:BoolToVisibilityConverter x:Key="GlassBoolToVis" />
    <conv:MinWidthToVisibilityConverter x:Key="MinWidthToVis" />
    <conv:StringEqualsMultiConverter x:Key="GlassStringEquals" />
    <conv:OpenWhenVisibleConverter x:Key="OpenWhenVisible" />

    <!--
      Light Glassmorphism:
      - Background color must show through for frosted glass
      - Surface is frosted white, not fully opaque
    -->
    <SolidColorBrush x:Key="WlGlassBg0" Color="#F0F4F9" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassBg1" Color="#F5F7FB" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassOnDark" Color="#1E293B" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassOnDarkMuted" Color="#64748B" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassInk" Color="#1E293B" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassMuted" Color="#64748B" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassAccent" Color="#76ADFF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassNoteCardBg" Color="#F2FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassNoteCardBorder" Color="#D9FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassChipBg" Color="#EEF1F5" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassChipBorder" Color="#D9DFE8" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassChipText" Color="#4D596A" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassRowBg" Color="#C8FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassRowBorder" Color="#D9FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassRowHoverBg" Color="#D4E0EE" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassRowHoverBorder" Color="#B8C8DA" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassRowSelectedBg" Color="#D9E8FF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassRowSelectedBorder" Color="#CCFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassButtonHoverBg" Color="#D4DEEA" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassButtonHoverBorder" Color="#B8C6D6" po:Freeze="True" />

    <!-- ?? WorkLogDetailCard? ?? ?? ? (?? ??) -->
    <LinearGradientBrush x:Key="WlGlassTicketFill" StartPoint="0,0" EndPoint="0.18,1" po:Freeze="True">
        <GradientStop Color="#D9FFFFFF" Offset="0" />
        <GradientStop Color="#99FFFFFF" Offset="0.4" />
        <GradientStop Color="#66EEF3FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WlGlassTicketHoverFill" StartPoint="0,0" EndPoint="0.18,1" po:Freeze="True">
        <GradientStop Color="#D8E4F0" Offset="0" />
        <GradientStop Color="#C4D4E4" Offset="0.4" />
        <GradientStop Color="#B4C8DC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WlGlassTicketSelectedFill" StartPoint="0,0" EndPoint="0.2,1" po:Freeze="True">
        <GradientStop Color="#E6F0FF" Offset="0" />
        <GradientStop Color="#B8D9E8FF" Offset="0.45" />
        <GradientStop Color="#99C8D8FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WlGlassDeployDoneBg" Color="#E7F4EE" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassDeployDoneFg" Color="#246B4D" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassDeployBusyBg" Color="#FBF0DE" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassDeployBusyFg" Color="#8A5B19" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassDeployFocusBg" Color="#E9EEFF" po:Freeze="True" />
    <SolidColorBrush x:Key="WlGlassDeployFocusFg" Color="#405CC3" po:Freeze="True" />
