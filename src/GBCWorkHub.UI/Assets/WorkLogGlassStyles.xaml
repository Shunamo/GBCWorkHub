    <!-- (comment trimmed) -->
    <Style x:Key="GlassFilterExpander" TargetType="Expander">
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="#66FFFFFF" BorderBrush="#99FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="10,8" SnapsToDevicePixels="True">
                        <StackPanel>
                            <ToggleButton Cursor="Hand" Background="Transparent" BorderThickness="0"
                                          HorizontalContentAlignment="Stretch"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              RecognizesAccessKey="True" />
                                            <Image x:Name="Chevron" Grid.Column="1"
                                                   Width="8" Height="8" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Opacity="0.7" Stretch="Uniform"
                                                   Source="{StaticResource ExpandDownIcon}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Source" Value="{StaticResource ExpandUpIcon}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandContent" ContentSource="Content"
                                              Visibility="Collapsed" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassFilterExpanderHeader" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="True" />
