    <SolidColorBrush x:Key="WlTeamSupportWash" Color="#EEEAF6" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamSupportBar" Color="#8B7EB5" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamSupportFg" Color="#5C5280" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamNursingWash" Color="#E8EEF8" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamNursingBar" Color="#6B8FDB" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamNursingFg" Color="#405CC3" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamAdminWash" Color="#E7F1EC" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamAdminBar" Color="#5B9A7A" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamAdminFg" Color="#246B4D" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamEtcWash" Color="#F6F1DE" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamEtcBar" Color="#C9B056" po:Freeze="True" />
    <SolidColorBrush x:Key="WlTeamEtcFg" Color="#8A6B18" po:Freeze="True" />

    <LinearGradientBrush x:Key="WlGlassAtmosphereBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#F4F7FB" Offset="0" />
        <GradientStop Color="#EEF2F8" Offset="0.5" />
        <GradientStop Color="#E8EEF6" Offset="1" />
