    <!-- (comment trimmed) -->
    <Style x:Key="GlassSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="#A6FFFFFF" />
        <Setter Property="BorderBrush" Value="#F2FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.12" Color="#3B5070" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassTicketRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WlGlassTicketFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowBorder}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.12" Color="#2F4466" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WlGlassTicketHoverFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowHoverBorder}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource WlGlassTicketSelectedFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowSelectedBorder}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassChipStyle" TargetType="Border">
        <Setter Property="Background" Value="#B8FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GlassChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WlGlassChipText}" />
    </Style>

    <Style x:Key="GlassDeployChipStyle" TargetType="Border" BasedOn="{StaticResource GlassChipStyle}">
        <Setter Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
        <Setter Property="BorderBrush" Value="#C5D0F5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ListDeployText}" Value="???">
                <Setter Property="Background" Value="{StaticResource WlGlassDeployDoneBg}" />
                <Setter Property="BorderBrush" Value="#C5E4D5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ListDeployText}" Value="????">
                <Setter Property="Background" Value="{StaticResource WlGlassDeployBusyBg}" />
                <Setter Property="BorderBrush" Value="#F0DFC0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ListDeployText}" Value="?? PC">
                <Setter Property="Background" Value="{StaticResource WlGlassDeployBusyBg}" />
                <Setter Property="BorderBrush" Value="#F0DFC0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ListDeployText}" Value="??">
                <Setter Property="Background" Value="#F8EAEA" />
                <Setter Property="BorderBrush" Value="#E8C8C8" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassDeployChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GlassChipTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource WlGlassDeployFocusFg}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ListDeployText}" Value="???">
                <Setter Property="Foreground" Value="{StaticResource WlGlassDeployDoneFg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ListDeployText}" Value="????">
                <Setter Property="Foreground" Value="{StaticResource WlGlassDeployBusyFg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ListDeployText}" Value="?? PC">
                <Setter Property="Foreground" Value="{StaticResource WlGlassDeployBusyFg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ListDeployText}" Value="??">
                <Setter Property="Foreground" Value="#B65353" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 노트/폴더 상단 포스트잇 탭: 글자 너비, 왼쪽 정렬. 선택 시 눌린 느낌. -->
    <Style x:Key="NotebookTabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource WlGlassMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Margin="0,8,4,0"
                            CornerRadius="8,8,0,0"
                            Background="#66FFFFFF"
                            BorderBrush="#D9FFFFFF"
                            BorderThickness="1,1,1,0"
                            Padding="12,7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#88C8D8EA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,4,-1" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassAccent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WlGlassAccent}" />
                            <Setter TargetName="Bd" Property="Padding" Value="12,9,12,8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="On">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,4,-1" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassAccent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WlGlassAccent}" />
                            <Setter TargetName="Bd" Property="Padding" Value="12,9,12,8" />
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="On" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#5B9AEF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5B9AEF" />
                        </MultiTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#5B9AEF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5B9AEF" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 큰 폴더 안 작은 폴더 탭. 선택색은 바깥(#76ADFF)보다 연한 하늘색. -->
    <Style x:Key="NotebookInnerTabButton" TargetType="Button" BasedOn="{StaticResource NotebookTabButton}">
        <Setter Property="Foreground" Value="{StaticResource WlGlassMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Margin="0,6,3,0"
                            CornerRadius="6,6,0,0"
                            Background="#4DFFFFFF"
                            BorderBrush="#D9FFFFFF"
                            BorderThickness="1,1,1,0"
                            Padding="9,5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#77C0D0E4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Foreground" Value="#1E293B" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,3,-1" />
                            <Setter TargetName="Bd" Property="Background" Value="#D8FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E8FFFFFF" />
                            <Setter TargetName="Bd" Property="Padding" Value="9,6,9,6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="On">
                            <Setter Property="Foreground" Value="#1E293B" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,3,-1" />
                            <Setter TargetName="Bd" Property="Background" Value="#D8FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E8FFFFFF" />
                            <Setter TargetName="Bd" Property="Padding" Value="9,6,9,6" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

