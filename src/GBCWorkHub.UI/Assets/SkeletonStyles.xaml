<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Soft pulse shimmer for glass surfaces (storyboard inlined per style — shared SB is unsafe) -->
    <Style x:Key="SkeletonBoneStyle" TargetType="Border">
        <Setter Property="Background" Value="#C8D8E4F2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.42" To="0.92" Duration="0:0:0.85">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SkeletonBoneSoftStyle" TargetType="Border" BasedOn="{StaticResource SkeletonBoneStyle}">
        <Setter Property="Background" Value="#A6FFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="SkeletonWorkLogRowStyle" TargetType="Border">
        <Setter Property="Background" Value="#99FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SkeletonPcCardStyle" TargetType="Border">
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="150" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
