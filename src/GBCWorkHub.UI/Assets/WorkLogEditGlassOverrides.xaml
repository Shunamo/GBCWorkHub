<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- WorkLogEditDialog 전용: 목록 Glass와 같은 톤으로 상세 스킨 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogGlassStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="EditChromeBg" Color="#99FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="EditChromeBorder" Color="#BFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="EditPanelBg" Color="#8CFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="EditSearchBg" Color="#B3FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="EditSplitterBg" Color="#40A8C0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="EditTreeSelectedBg" Color="#B8D9E8FF" po:Freeze="True" />
    <SolidColorBrush x:Key="EditTreeHoverBg" Color="#99FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="EditTreeGuideBg" Color="#88A8C0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="EditHeaderAccentBorder" Color="#B88EA4E8" po:Freeze="True" />
    <SolidColorBrush x:Key="EditHeaderSubBorder" Color="#99FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="EditTreeAppendedBg" Color="#A8E7F4EE" po:Freeze="True" />
    <SolidColorBrush x:Key="EditTreeAppendedActiveBg" Color="#99D1FAE5" po:Freeze="True" />

    <!-- 유리: 위 하이라이트 → 아래 쿨톤 투과 -->
    <LinearGradientBrush x:Key="EditGlassFill" StartPoint="0,0" EndPoint="0.12,1" po:Freeze="True">
        <GradientStop Color="#E6FFFFFF" Offset="0" />
        <GradientStop Color="#B3FFFFFF" Offset="0.35" />
        <GradientStop Color="#73F2F6FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EditGlassFillSoft" StartPoint="0,0" EndPoint="0.18,1" po:Freeze="True">
        <GradientStop Color="#D9FFFFFF" Offset="0" />
        <GradientStop Color="#99FFFFFF" Offset="0.4" />
        <GradientStop Color="#66EEF3FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EditGlassSheen" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="EditHeaderChrome" TargetType="Border">
        <Setter Property="Padding" Value="18,14,20,14" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="Background" Value="{StaticResource EditGlassFill}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Margin" Value="12,12,12,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.16" Color="#2F4466" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditHeaderField" TargetType="Border">
        <Setter Property="Background" Value="#99FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Color="#2F4466" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditHeaderFieldSub" TargetType="Border" BasedOn="{StaticResource EditHeaderField}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="EditTreePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EditGlassFillSoft}" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="16" />
        <!-- Top 16 = 우측 ReadFormScroll Padding과 맞춤 -->
        <Setter Property="Margin" Value="12,16,6,12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.14" Color="#2F4466" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditTreeSearchField" TargetType="Border">
        <Setter Property="Background" Value="#99FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#3B5070" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditFooterBar" TargetType="Border">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{StaticResource EditGlassFillSoft}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Margin" Value="0,8,12,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="#2F4466" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkLogDetailCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EditGlassFillSoft}" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.13" Color="#2F4466" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 소스 파일: 이름 너비만 + 카드와 같은 radius -->
    <Style x:Key="WorkLogSourceRow" TargetType="Border">
        <Setter Property="Background" Value="#99FFFFFF" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B8D0E0" />
                <Setter Property="BorderBrush" Value="#A0B8CC" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#B8D9E8FF" />
                <Setter Property="BorderBrush" Value="#CCFFFFFF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAppended}" Value="True">
                <Setter Property="Background" Value="#A8E7F4EE" />
                <Setter Property="BorderBrush" Value="#B8D1FAE5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                <Setter Property="BorderBrush" Value="#F97316" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkLogInfoTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EditGlassFillSoft}" />
        <Setter Property="BorderBrush" Value="#D9FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,14" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.12" Color="#2F4466" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkLogInfoTileLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WlGlassMuted}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="WorkLogInfoTileValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WorkLogGhostButton" TargetType="Button" BasedOn="{StaticResource GlassGhostButton}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="WorkLogPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassAccentButton}">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="WorkLogIconButton" TargetType="Button" BasedOn="{StaticResource GlassToolbarIconButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="#B8FFFFFF" />
        <Setter Property="BorderBrush" Value="#BFFFFFFF" />
    </Style>

    <!-- Menu/Work 페이지 좌·우 화살표: 배경 없이 아이콘 색(투명도)만 -->
    <Style x:Key="WorkLogStepNavButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.18" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkLogInput" TargetType="TextBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- TextBoxBase가 PART_ContentHost에 Padding을 복사함. Border에는 Padding 넣지 말 것. -->
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
        <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
        <Setter Property="CaretBrush" Value="{StaticResource WlGlassAccent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="#99FFFFFF"
                            BorderBrush="#D9FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#2F4466" />
                        </Border.Effect>
                        <Grid>
                            <!--
                              Watermark Margin = TextBox.Padding
                              ScrollViewer.Padding 은 TextBoxBase가 런타임에 TextBox.Padding으로 덮어씀
                              → 둘 다 같은 inset → 커서/placeholder 시작점 일치
                            -->
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="#94A3B8"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="TextAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" Value="Center">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="TextAlignment" Value="Center" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" Value="Right">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="TextAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          Background="Transparent"
                                          Focusable="False"
                                          CanContentScroll="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B8FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkLogDateInput" TargetType="TextBox" BasedOn="{StaticResource WorkLogInput}">
        <Setter Property="Width" Value="108" />
        <Setter Property="MaxLength" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Tag" Value="0000-00-00" />
    </Style>

    <!-- Tree / left panel -->
    <Style x:Key="TreeNodeBorder" TargetType="Border">
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource EditTreeSelectedBg}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource EditTreeHoverBg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 트리 아이콘: 여러 줄 제목일 때 첫 줄 높이에 맞춤 (Center면 블록 중간으로 뜸) -->
    <Style x:Key="TreeIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.28" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TreePlusButton" TargetType="Button" BasedOn="{StaticResource TreeIconButton}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="ToolTip" Value="하위 추가" />
    </Style>

    <!-- Left panel "+ MENU": 배경 없음, 눌릴 때 scale만 -->
    <Style x:Key="TreeAddMenuButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,8,8,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="Menu 추가" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#334155" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WorkLogGlassCheckButton / ticket digits: WorkLogEditDialog.Resources 에 정의 -->

    <Style x:Key="WorkLogFieldTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Lg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="WorkLogFieldError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#DC2626" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TreeToggleButton" TargetType="Button" BasedOn="{StaticResource TreeIconButton}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="ToolTip" Value="펼치기/접기" />
    </Style>

    <Style x:Key="TreeRowIconButton" TargetType="Button" BasedOn="{StaticResource TreeIconButton}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="TreeGuideVertical" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="MaxWidth" Value="1" />
        <Setter Property="Background" Value="{DynamicResource EditTreeGuideBg}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="TreeGuideVerticalMenu" TargetType="Border" BasedOn="{StaticResource TreeGuideVertical}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="12,22,0,0" />
        <Setter Property="Panel.ZIndex" Value="20" />
    </Style>

    <Style x:Key="TreeGuideVerticalNode" TargetType="Border" BasedOn="{StaticResource TreeGuideVertical}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="12,23,0,0" />
        <Setter Property="Panel.ZIndex" Value="20" />
    </Style>

    <Style x:Key="TreeGuideVerticalType" TargetType="Border" BasedOn="{StaticResource TreeGuideVerticalNode}">
        <Setter Property="Margin" Value="12.5,23,0,0" />
    </Style>

    <Style x:Key="TreeSourceRowBorder" TargetType="Border" BasedOn="{StaticResource TreeNodeBorder}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource EditTreeSelectedBg}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAppended}" Value="True">
                <Setter Property="Background" Value="{DynamicResource EditTreeAppendedBg}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True" />
                    <Condition Binding="{Binding IsAppended}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource EditTreeAppendedActiveBg}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
