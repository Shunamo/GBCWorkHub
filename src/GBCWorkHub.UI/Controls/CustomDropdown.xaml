<UserControl x:Class="GBCWorkHub.UI.Controls.CustomDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
             x:Name="Root"
             MinHeight="36"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel MinWidth="0" HorizontalAlignment="Stretch">
        <Border x:Name="PART_RootBorder"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="36"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                Cursor="Hand"
                MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">
            <Grid Margin="10,6" MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PART_DisplayText" Grid.Column="0"
                           VerticalAlignment="Center" Text="선택하세요" Foreground="#94A3B8"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />
                <Image x:Name="PART_Arrow" Grid.Column="1"
                       Width="9" Height="9"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.75" Stretch="Uniform" IsHitTestVisible="False">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{StaticResource ExpandDownIcon}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=Root}" Value="True">
                                    <Setter Property="Source" Value="{StaticResource ExpandUpIcon}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>
        </Border>

        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=PART_RootBorder}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="Popup_Closed"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                    Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=PART_RootBorder}"
                    MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBox x:Name="PART_SearchBox" Margin="8,8,8,4" Padding="8,6"
                             MinWidth="0" HorizontalAlignment="Stretch"
                             HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding IsSearchEnabled, ElementName=Root, Converter={StaticResource BoolToVis}}"
                             Text="{Binding SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="PART_EmptyText" Margin="12,10" Foreground="#94A3B8" FontSize="12"
                               Text="{Binding EmptyText, ElementName=Root}" Visibility="Collapsed" />
                    <ListBox x:Name="PART_ListBox"
                             ItemsSource="{Binding ItemsSource, ElementName=Root}"
                             DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
                             SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                             SelectionChanged="ListBox_SelectionChanged"
                             BorderThickness="0"
                             MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <DockPanel>
                                                    <Image DockPanel.Dock="Right" x:Name="CheckMark"
                                                           Source="{StaticResource DoneLightIcon}"
                                                           Width="14" Height="14" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <ContentPresenter />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#EFF6FF" />
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>

        <TextBlock x:Name="PART_ValidationText" FontSize="11" Foreground="#C2410C" Margin="2,4,0,0"
                   Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
