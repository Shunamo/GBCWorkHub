<UserControl x:Class="GBCWorkHub.UI.Controls.DateRangePickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DpPickerCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#3B5070" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DpNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DpDayButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DpDayItemTemplate">
            <Button Style="{StaticResource DpDayButton}"
                    IsEnabled="{Binding IsCurrentMonth}"
                    Click="DayButton_Click" Tag="{Binding Date}">
                <Grid Width="32" Height="32">
                    <Border Margin="1,4" Background="#3376ADFF">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RangeFillMid}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="CornerRadius" Value="0" />
                                        <Setter Property="Margin" Value="0,4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RangeFillFromStart}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="CornerRadius" Value="4,0,0,4" />
                                        <Setter Property="Margin" Value="1,4,0,4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RangeFillToEnd}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="CornerRadius" Value="0,4,4,0" />
                                        <Setter Property="Margin" Value="0,4,1,4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Width="26" Height="26" CornerRadius="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTodayOnly}" Value="True">
                                        <Setter Property="BorderBrush" Value="#76ADFF" />
                                        <Setter Property="Background" Value="#2276ADFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEndpoint}" Value="True">
                                        <Setter Property="Background" Value="#76ADFF" />
                                        <Setter Property="BorderBrush" Value="#76ADFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding DayText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTodayOnly}" Value="True">
                                        <Setter Property="Foreground" Value="#76ADFF" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEndpoint}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="Toggle" Width="26" Height="26" Background="Transparent" BorderThickness="0"
                      Cursor="Hand" ToolTip="달력에서 기간 선택">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="#F4F6F9" CornerRadius="8">
                        <Image Source="{StaticResource DateRangeFillIcon}" Width="14" Height="14" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
            <Border Style="{StaticResource DpPickerCard}" Width="268">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource DpNavButton}" ToolTip="이전 달" Click="PrevMonth_Click">
                                <Image Source="{StaticResource ExpandLeftIcon}" Width="9" Height="9" Opacity="0.45" />
                            </Button>
                            <Button Style="{StaticResource DpNavButton}" ToolTip="다음 달" Click="NextMonth_Click">
                                <Image Source="{StaticResource ExpandRightIcon}" Width="9" Height="9" Opacity="0.45" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="MonthTitleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Columns="7" Margin="0,0,0,2">
                        <TextBlock Text="일" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="월" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="화" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="수" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="목" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="금" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="토" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                    </UniformGrid>
                    <ItemsControl x:Name="DaysItemsControl" ItemTemplate="{StaticResource DpDayItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
