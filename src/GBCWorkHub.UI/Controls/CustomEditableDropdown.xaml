<UserControl x:Class="GBCWorkHub.UI.Controls.CustomEditableDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="36"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             ClipToBounds="True">
    <Grid MinWidth="0" ClipToBounds="True">
        <Border x:Name="PART_RootBorder" Background="#CCFFFFFF" BorderBrush="#F2FFFFFF"
                BorderThickness="1.5" CornerRadius="10" MinHeight="36" MinWidth="0"
                HorizontalAlignment="Stretch" ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent"
                         Padding="10,7" VerticalContentAlignment="Center"
                         MinWidth="0" HorizontalAlignment="Stretch"
                         TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="TextBox_TextChanged" GotFocus="TextBox_GotFocus"
                         ToolTip="직접 입력하거나 후보에서 선택" />
                <Image Grid.Column="1"
                       Width="9" Height="9"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.75" Stretch="Uniform" Cursor="Hand"
                       MouseLeftButtonUp="Arrow_MouseLeftButtonUp">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{StaticResource ExpandDownIcon}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=Root}" Value="True">
                                    <Setter Property="Source" Value="{StaticResource ExpandUpIcon}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>
        </Border>
        <Popup IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=PART_RootBorder}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Closed="Popup_Closed">
            <Border Background="#F2FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1.5" CornerRadius="12"
                    Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=PART_RootBorder}"
                    MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.14" Color="#3B5070" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="PART_EmptyText" Margin="12,10" Foreground="#94A3B8" FontSize="12"
                               Text="{Binding EmptyText, ElementName=Root}" TextWrapping="Wrap" />
                    <ListBox x:Name="PART_ListBox" BorderThickness="0"
                             ItemsSource="{Binding ItemsSource, ElementName=Root}"
                             SelectionChanged="ListBox_SelectionChanged"
                             MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
