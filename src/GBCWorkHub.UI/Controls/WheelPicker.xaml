<UserControl x:Class="GBCWorkHub.UI.Controls.WheelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40"
             Height="72"
             Focusable="True"
             Background="Transparent"
             ClipToBounds="True"
             MouseWheel="OnMouseWheel"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseMove="OnPreviewMouseMove"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
             LostMouseCapture="OnLostMouseCapture">
    <Grid>
        <Border Height="24" VerticalAlignment="Center"
                Background="#3376ADFF" CornerRadius="4"
                IsHitTestVisible="False" />
        <ItemsControl x:Name="ItemHost" IsHitTestVisible="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Focusable="False"
                            Click="OnItemClick"
                            Tag="{Binding Value}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="{Binding FontSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="{Binding Opacity}"
                                               FontWeight="{Binding Weight}"
                                               Foreground="#000000" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
