<UserControl x:Class="GBCWorkHub.UI.Controls.InlineSuggestionField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="36"
             MinWidth="0"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             ClipToBounds="True">
    <Grid MinWidth="0" HorizontalAlignment="Stretch" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="PART_RootBorder" Grid.Row="0"
                Background="#FFFFFF" BorderBrush="#D8DEE8"
                BorderThickness="1" CornerRadius="8" MinHeight="36" MinWidth="0"
                HorizontalAlignment="Stretch" ClipToBounds="True">
            <TextBox x:Name="PART_TextBox"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="12,8"
                     FontSize="13"
                     MinWidth="0"
                     HorizontalAlignment="Stretch"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Center"
                     TextChanged="TextBox_TextChanged" />
        </Border>
        <WrapPanel x:Name="PART_Options" Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0" />
    </Grid>
</UserControl>
