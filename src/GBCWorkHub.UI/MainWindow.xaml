<Window x:Class="GBCWorkHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wl="clr-namespace:GBCWorkHub.UI.Views.WorkLog"
        xmlns:imp="clr-namespace:GBCWorkHub.UI.Views.Improvement"
        xmlns:views="clr-namespace:GBCWorkHub.UI.Views"
        Title="GBC WorkHub"
        Height="760" Width="1180"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WlGlassAtmosphereBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{StaticResource FontSize.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Closed="Window_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#F4F6F9" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#D8DEE8" />
        <SolidColorBrush x:Key="TextBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 헤더: 체크인 가져오기 자동 팝업 on/off -->
        <Style x:Key="HeaderCheckinFetchSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="ToolTip" Value="Fetch TFS — 원격 종료 후 체크인 가져오기 팝업" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="{Binding CheckinFetchToggleLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Grid Width="36" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        CornerRadius="10"
                                        Background="#D1D5DB"
                                        SnapsToDevicePixels="True" />
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.25" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Atmosphere blobs (remote + glass worklog share the same plane) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="0">
            <Ellipse Width="520" Height="520" Fill="#338BB4E0"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-240,-180,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" Fill="#288FBFB8"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-180">
                <Ellipse.Effect>
                    <BlurEffect Radius="80" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!--
          통합 헤더.
          Glass(원격/업무기록): 별도 행 배경이 아니라 본문 atmosphere 위에 오버레이
          (행을 나누면 Window 배경색 띠가 생김)
        -->
        <Border Grid.Row="0" Panel.ZIndex="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="0,12,20,12" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMainGlassOverlay}" Value="True">
                            <Setter Property="Grid.RowSpan" Value="2" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <!-- Transparent는 빈 영역도 클릭을 가로챔. null이면 버튼/텍스트만 히트 -->
                            <Setter Property="Background" Value="{x:Null}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="24,16,24,12" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Top 정렬: Glass 오버레이 시 빈 영역 클릭이 본문으로 통과 -->
            <!-- 뒤로가기 슬롯/탭바는 화면 전환 시에도 자리 고정 → 제목·우측 컨트롤 이질감 방지 -->
            <DockPanel LastChildFill="False" VerticalAlignment="Top">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="16,0,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMainGlassOverlay}" Value="True">
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Width="25" Height="25" Margin="0,0,10,0">
                        <Button Style="{StaticResource HeaderIconButton}"
                                Command="{Binding BackToSitesCommand}" ToolTip="사이트 목록으로"
                                Visibility="{Binding IsGalleryVisible, Converter={StaticResource BoolToVis}}">
                            <Image Source="{StaticResource ExpandLeftIcon}" Width="15" Height="15" />
                        </Button>
                        <Button Style="{StaticResource HeaderIconButton}"
                                Command="{Binding WorkLogBackCommand}" ToolTip="뒤로"
                                Visibility="{Binding IsHeaderBackVisible, Converter={StaticResource BoolToVis}}">
                            <Image Source="{StaticResource ExpandLeftIcon}" Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="{StaticResource FontSize.Xl}" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource HeaderCheckinFetchSwitch}"
                                  IsChecked="{Binding IsCheckinFetchEnabled, Mode=TwoWay}"
                                  Margin="0,0,16,0"
                                  Visibility="{Binding IsUserShellVisible, Converter={StaticResource BoolToVis}}" />
                    <views:MainTabBar VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource HeaderIconButton}"
                            Command="{Binding RefreshCommand}" ToolTip="새로고침">
                        <Image Source="{StaticResource RefreshLightIcon}" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- App version: site picker (main home) only, soft top-left -->
        <TextBlock Grid.Row="0" Grid.RowSpan="2"
                   Panel.ZIndex="3"
                   IsHitTestVisible="False"
                   Text="{Binding CurrentAppVersion, StringFormat=v{0}}"
                   FontSize="11"
                   Foreground="#A8B0BC"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="14,10,0,0"
                   Visibility="{Binding IsSitePickerVisible, Converter={StaticResource BoolToVis}}" />

        <!-- 원격 PC feature -->
        <Grid Grid.Row="1" Panel.ZIndex="1"
              Visibility="{Binding IsRemoteTab, Converter={StaticResource BoolToVis}}">
            <views:RemoteWorkspaceView DataContext="{Binding RemoteWorkspace}" />
        </Grid>

        <!-- TFS 형상관리 탭 UI는 업무기록 TFS 가져오기 팝업으로 통합. VM/수신 파이프는 유지. -->

        <!-- 업무기록 (Glass면 전체 행을 채워 헤더 뒤까지 atmosphere) -->
        <Grid Panel.ZIndex="1" Visibility="{Binding IsWorkLogTab, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorkLogGlassOverlay}" Value="True">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.RowSpan" Value="2" />
                            <Setter Property="Background" Value="Transparent" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <wl:WorkLogListView DataContext="{Binding WorkLogList}" />
        </Grid>

        <Grid Grid.Row="1" Panel.ZIndex="1"
              Visibility="{Binding IsMeTab, Converter={StaticResource BoolToVis}}">
            <views:MyPageView DataContext="{Binding MyPage}" />
        </Grid>

        <!-- 개선사항 요청 (업무일지와 동일하게 전체 행을 채워 헤더 뒤까지 글래스 배경이 비침) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1" Background="Transparent"
              Visibility="{Binding IsImprovementTab, Converter={StaticResource BoolToVis}}">
            <imp:ImprovementListView DataContext="{Binding Improvement}" />
        </Grid>

        <!-- 관리자 전용 셸 (헤더 ZIndex 아래 — 원격 갤러리와 동일) -->
        <Grid Grid.Row="1" Panel.ZIndex="1"
              Visibility="{Binding IsAdminShellVisible, Converter={StaticResource BoolToVis}}">
            <views:AdminView DataContext="{Binding Admin}" />
            <!-- 관리자에서 연 업무기록 상세(수정/삭제 포함) -->
            <Grid Panel.ZIndex="40"
                  Visibility="{Binding IsAdminWorkLogEditVisible, Converter={StaticResource BoolToVis}}">
                <wl:WorkLogListView DataContext="{Binding WorkLogList}" />
            </Grid>
        </Grid>

        <Grid x:Name="PopupOverlayHost" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="200"
              Background="Transparent"
              Visibility="Collapsed" ClipToBounds="True" />

        <!-- In-app update banner (bottom-left) -->
        <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="150"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,16,16" Padding="14,12"
                CornerRadius="10"
                Background="#F0FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Direction="270" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="업데이트"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,6"
                            MinHeight="28"
                            Command="{Binding UpdateCommand}" />
                    <Button Content="✕"
                            Style="{StaticResource HeaderIconButton}"
                            Margin="4,0,0,0"
                            ToolTip="닫기"
                            Command="{Binding DismissUpdateCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerText}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#1E293B"
                               TextWrapping="Wrap" MaxWidth="280" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
