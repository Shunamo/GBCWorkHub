<Application x:Class="GBCWorkHub.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
             <!-- StartupUri removed: OnStartup creates MainWindow with try/catch for XamlParse diagnostics -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 타이포/테마 토큰 먼저 (tailwind.config 역할) -->
                <ResourceDictionary Source="Assets/ThemeConfig.xaml" />
                <ResourceDictionary Source="Assets/Icons.xaml" />
                <ResourceDictionary Source="Assets/WorkLogGlassStyles.xaml" />
                <ResourceDictionary Source="Assets/SkeletonStyles.xaml" />
                <ResourceDictionary Source="Assets/RemoteComputerGallery.xaml" />
                <ResourceDictionary Source="Assets/WorkLogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>

            <!-- 스크롤 가능하되 스크롤바는 숨김 -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="0" />
                <Setter Property="Height" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                <!-- Hidden이면 가로 infinite measure로 입력칸이 화면을 넘어감 → Disabled로 너비 제한 -->
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
