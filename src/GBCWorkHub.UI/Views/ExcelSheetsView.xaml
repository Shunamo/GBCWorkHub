<UserControl x:Class="GBCWorkHub.UI.Views.ExcelSheetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogGlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ResourceKeyToImageConverter x:Key="KeyToImage" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringEmptyToVisibilityConverter x:Key="ErrorToVis" />

            <!-- 팝업(바로가기 추가)의 GlassPromptInput과 같은 느낌으로 통일한 인라인 입력 스타일. -->
            <Style x:Key="GlassInlineInput" TargetType="TextBox">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
                <Setter Property="CaretBrush" Value="{StaticResource WlGlassAccent}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="#F4F6F9"
                                    BorderBrush="#D8DEE8"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 리스트 한 줄 — 아이콘 + 이름을 누르면 바로가기가 열리는 영역. -->
            <Style x:Key="ExcelShortcutOpenButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,6">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource WlGlassAtmosphereBrush}" ClipToBounds="True">
        <Ellipse Width="520" Height="520" Fill="#338BB4E0"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-240,-180,0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="90" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="460" Height="460" Fill="#288FBFB8"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-200,0,0,-180" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="80" />
            </Ellipse.Effect>
        </Ellipse>

        <Border HorizontalAlignment="Center" VerticalAlignment="Stretch"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                MaxWidth="900" Margin="24,68,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,0,0,16" LastChildFill="False">
                    <TextBlock Text="엑셀 시트 바로가기" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}"
                            ToolTip="바로가기 추가" Command="{Binding AddExcelShortcutCommand}">
                        <Image Source="{StaticResource AddRingIcon}" Width="20" Height="20" />
                    </Button>
                    <Button DockPanel.Dock="Right" Margin="0,0,4,0"
                            Command="{Binding ToggleExcelShortcutsEditModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
                                <Setter Property="ToolTip" Value="전체 수정" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExcelShortcutsEditMode}" Value="True">
                                        <Setter Property="ToolTip" Value="저장" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Image Source="{StaticResource EditFillIcon}" Width="18" Height="18"
                                   Visibility="{Binding IsExcelShortcutsEditMode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <Image Source="{StaticResource SaveFillIcon}" Width="18" Height="18"
                                   Visibility="{Binding IsExcelShortcutsEditMode, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                </DockPanel>
                <ScrollViewer Grid.Row="1" Style="{StaticResource GlassScrollViewer}">
                    <ItemsControl ItemsSource="{Binding ExcelShortcuts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Margin="0,4" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 보기 모드: 아이콘 + 파일명, 누르면 바로가기 열림. -->
                                        <Button Grid.Column="0" Style="{StaticResource ExcelShortcutOpenButton}"
                                                Visibility="{Binding DataContext.IsExcelShortcutsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                                Command="{Binding DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Url}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding IconKey, Converter={StaticResource KeyToImage}}"
                                                       Width="22" Height="22" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WlGlassInk}"
                                                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Button>

                                        <!-- 전체 수정 모드: 파일명/URL 인라인 입력 (이 줄도 같이 바뀐다). -->
                                        <StackPanel Grid.Column="0" Orientation="Vertical"
                                                    Visibility="{Binding DataContext.IsExcelShortcutsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="파일명" FontSize="11" Width="40"
                                                           Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource GlassInlineInput}"
                                                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="220" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="URL" FontSize="11" Width="40"
                                                           Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource GlassInlineInput}"
                                                         Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="420" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D23C3C" FontSize="11"
                                                       Margin="40,4,0,0"
                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource ErrorToVis}}" />
                                        </StackPanel>

                                        <!-- 전체 수정 모드일 때만 줄마다 삭제 아이콘. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.IsExcelShortcutsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <Button Width="24" Height="24" Padding="0"
                                                    Style="{StaticResource HeaderIconButton}"
                                                    ToolTip="삭제"
                                                    Command="{Binding DataContext.DeleteExcelShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Image Source="{StaticResource TrashDuotoneIcon}" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
