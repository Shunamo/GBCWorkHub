<UserControl x:Class="GBCWorkHub.UI.Views.MyPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wl="clr-namespace:GBCWorkHub.UI.Views.WorkLog"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls"
             x:Name="MyPageRoot"
             Background="Transparent"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogGlassStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogEditGlassOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MyPageModuleStyle" TargetType="Border">
                <Setter Property="Background" Value="#B8FFFFFF" />
                <Setter Property="BorderBrush" Value="#E6FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.08" Color="#3B5070" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MyPageIconCircle" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MyPageRowButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource WlGlassNoteCardBg}"
                                    BorderBrush="{StaticResource WlGlassNoteCardBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,8"
                                    MinHeight="56"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </Border.RenderTransform>
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassButtonHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C5D8EC" />
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Opacity" Value="0.85" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </Style>

            <Style x:Key="MyPageScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource GlassScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="MyPageHeaderIconButton" TargetType="Button" BasedOn="{StaticResource GlassToolbarIconButton}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="ToolTipService.Placement" Value="Bottom" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            </Style>
            <Style x:Key="MyPageSearchField" TargetType="Border">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="196" />
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#D5DEE8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="MyPageSearchBox" TargetType="TextBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,0,8,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
            </Style>
            <Style x:Key="MyPageSearchPlaceholder" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#94A3B8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style x:Key="MyPagePickerCard" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#D5DEE8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#3B5070" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MyPagePickerGhostButton" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#D5DEE8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MyPagePickerAccentButton" TargetType="Button" BasedOn="{StaticResource MyPagePickerGhostButton}">
                <Setter Property="Background" Value="#76ADFF" />
                <Setter Property="BorderBrush" Value="#76ADFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>
            <Style x:Key="MyPageCalendarDayButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.28" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource WlGlassAtmosphereBrush}" ClipToBounds="True">
        <Ellipse Width="520" Height="520" Fill="#338BB4E0"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-240,-180,0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="90" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="460" Height="460" Fill="#288FBFB8"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-200,0,0,-180" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="80" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="24,68,24,24" MaxWidth="980" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource UserCircleIcon}"
                               Width="28" Height="28" Margin="0,0,8,0" Stretch="Uniform"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OccupancyDisplayName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GlassToolbarIconButton}"
                                Width="26" Height="26" Margin="2,0,0,0"
                                ToolTip="이름 수정"
                                Command="{Binding ChangeNameCommand}"
                                VerticalAlignment="Center">
                            <Image Source="{StaticResource EditFillIcon}" Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource GlassToolbarIconButton}"
                                Width="Auto" Height="26" Margin="6,0,0,0" Padding="10,0"
                                ToolTip="비밀번호 변경"
                                Command="{Binding ChangePasswordCommand}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Center">
                            <TextBlock Text="비밀번호 변경" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Inbox.Sites}"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Bottom" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NotebookTabButton}"
                                    Command="{Binding DataContext.SelectSharedSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding SiteCode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding SiteCode}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WlGlassMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Margin="5,0,0,0"
                                               Text="{Binding CountLabel}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WlGlassAccent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Style="{StaticResource NotebookBodyBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding InboxRowHeight}" />
                        <RowDefinition Height="{Binding BottomRowHeight}" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Grid.RowSpan" Value="1" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInboxExpanded}" Value="True">
                                        <Setter Property="Grid.RowSpan" Value="2" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowInboxSection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding InboxBodyRowHeight}" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,0" LastChildFill="True">
                            <Image DockPanel.Dock="Left" Source="{StaticResource ArchiveLoadFillIcon}"
                                   Width="18" Height="18" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MyPageSearchField}" Margin="0,0,10,0"
                                        Visibility="{Binding IsInboxSearchOpen, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource MyPageHeaderIconButton}"
                                                Width="32" Height="32"
                                                ToolTip="검색 닫기"
                                                Command="{Binding ToggleInboxSearchCommand}">
                                            <Image Source="{StaticResource SearchLightIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBox x:Name="InboxSearchBox"
                                                     Style="{StaticResource MyPageSearchBox}"
                                                     Text="{Binding Inbox.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsVisibleChanged="SearchBox_IsVisibleChanged" />
                                            <TextBlock Text="CS, 코멘트, 작성자, PC">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MyPageSearchPlaceholder}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Inbox.SearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Inbox.SearchText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <Button Style="{StaticResource MyPageHeaderIconButton}"
                                        Margin="0,0,10,0"
                                        ToolTip="체크인 검색"
                                        Command="{Binding ToggleInboxSearchCommand}"
                                        Visibility="{Binding IsInboxSearchOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <Image Source="{StaticResource SearchLightIcon}" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource MyPageHeaderIconButton}"
                                        ToolTip="{Binding InboxExpandToolTip}"
                                        Command="{Binding ToggleExpandCommand}" CommandParameter="Inbox">
                                    <Image Source="{StaticResource FullScreenCornerIcon}" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="체크인 보관함" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <Button Command="{Binding Inbox.SetFilterCommand}" CommandParameter="waiting">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Inbox.IsFilterWaiting}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Run Text="대기" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Inbox.SiteWaitingCount, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding Inbox.SetFilterCommand}" CommandParameter="skipped">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Inbox.IsFilterSkipped}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Run Text="스킵" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Inbox.SiteSkippedCount, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding Inbox.SetFilterCommand}" CommandParameter="reported">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Inbox.IsFilterReported}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Run Text="작성 완료" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Inbox.SiteReportedCount, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" Padding="8"
                                MinHeight="{Binding InboxBodyMinHeight}"
                                MaxHeight="{Binding InboxBodyMaxHeight}"
                                VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource NotebookInnerBodyBorder}">
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock Text="가져온 체크인이 없습니다."
                                           Foreground="{StaticResource WlGlassMuted}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Visibility="{Binding HasInboxRows, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <wl:TfsCheckinInboxView VerticalAlignment="Stretch"
                                                        CompactList="{Binding IsInboxCompact}"
                                                        Visibility="{Binding HasInboxRows, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="Grid.RowSpan" Value="1" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkLogExpanded}" Value="True">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="2" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowWorkLogSection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,0" LastChildFill="True">
                            <Image DockPanel.Dock="Left" Source="{StaticResource FileDockFillIcon}"
                                   Width="18" Height="18" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MyPageSearchField}" Margin="0,0,10,0"
                                        Visibility="{Binding IsWorkLogSearchOpen, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource MyPageHeaderIconButton}"
                                                Width="32" Height="32"
                                                ToolTip="검색 닫기"
                                                Command="{Binding ToggleWorkLogSearchCommand}">
                                            <Image Source="{StaticResource SearchLightIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBox x:Name="WorkLogSearchBox"
                                                     Style="{StaticResource MyPageSearchBox}"
                                                     Text="{Binding WorkLogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsVisibleChanged="SearchBox_IsVisibleChanged" />
                                            <TextBlock Text="제목, 티켓, 메뉴">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MyPageSearchPlaceholder}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WorkLogSearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WorkLogSearchText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <Button Style="{StaticResource MyPageHeaderIconButton}"
                                        Margin="0,0,10,0"
                                        ToolTip="업무기록 검색"
                                        Command="{Binding ToggleWorkLogSearchCommand}"
                                        Visibility="{Binding IsWorkLogSearchOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <Image Source="{StaticResource SearchLightIcon}" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource MyPageHeaderIconButton}"
                                        ToolTip="{Binding WorkLogExpandToolTip}"
                                        Command="{Binding ToggleExpandCommand}" CommandParameter="WorkLog">
                                    <Image Source="{StaticResource FullScreenCornerIcon}" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding WorkLogSectionTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <Button Command="{Binding SetWorkLogWriteFilterCommand}" CommandParameter="draft">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkLogFilterDraft}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Run Text="임시저장" />
                                    <Run Text=" " />
                                    <Run Text="{Binding WorkLogFilterDraftCount, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding SetWorkLogWriteFilterCommand}" CommandParameter="completed">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkLogFilterCompleted}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Run Text="작성 완료" />
                                    <Run Text=" " />
                                    <Run Text="{Binding WorkLogFilterCompletedCount, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource NotebookInnerBodyBorder}" Padding="8">
                            <Grid>
                                <TextBlock Text="내가 작성한 업무기록이 없습니다."
                                           Foreground="{StaticResource WlGlassMuted}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasWorkLogs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <ScrollViewer Style="{StaticResource MyPageScrollViewer}"
                                              VerticalAlignment="Top"
                                              Visibility="{Binding HasWorkLogs, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding WorkLogDateGroups}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding DateHeader}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource WlGlassInk}"
                                                               Margin="2,0,0,6" />
                                                    <Border Height="1" Background="#80FFFFFF" Margin="0,0,8,8" />
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MyPageRowButton}"
                                                                        Command="{Binding DataContext.OpenWorkLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <DockPanel LastChildFill="True">
                                                                        <StackPanel MinWidth="0">
                                                                            <TextBlock FontWeight="SemiBold" FontSize="13"
                                                                                       Foreground="{StaticResource WlGlassInk}"
                                                                                       Text="{Binding ListTitleText}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0">
                                                                                <Run Text="{Binding ListMenuText, Mode=OneWay}" />
                                                                                <Run Text=" · " />
                                                                                <Run Text="{Binding TicketDisplay, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="Grid.RowSpan" Value="1" />
                                <Setter Property="Margin" Value="8,0,0,0" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionExpanded}" Value="True">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="2" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowSessionSection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,0" LastChildFill="True">
                            <Image DockPanel.Dock="Left" Source="{StaticResource DesktopFillIcon}"
                                   Width="18" Height="18" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource MyPageHeaderIconButton}"
                                    ToolTip="{Binding SessionExpandToolTip}"
                                    Command="{Binding ToggleExpandCommand}" CommandParameter="Session">
                                <Image Source="{StaticResource FullScreenCornerIcon}" Width="16" Height="16" />
                            </Button>
                            <TextBlock Text="{Binding SessionSectionTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding ToggleSessionSearchCommand}"
                                    HorizontalAlignment="Left" ToolTip="날짜·시간 조회">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionSearchOpen}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAppliedSessionRange}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource DateRangeFillIcon}" Width="16" Height="16"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Text="{Binding SessionPeriodTabText}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="2,0,0,4" Padding="0" Width="22" Height="22"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="날짜·시간 조건 지우기"
                                    Command="{Binding ClearSessionDateFilterCommand}"
                                    Visibility="{Binding HasAppliedSessionRange, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="×" FontSize="13" Foreground="#64748B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource NotebookInnerBodyBorder}" Padding="8">
                            <Grid>
                                <TextBlock Text="{Binding SessionEmptyText}"
                                           Foreground="{StaticResource WlGlassMuted}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <ScrollViewer Style="{StaticResource MyPageScrollViewer}"
                                              VerticalAlignment="Top"
                                              Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding SessionDateGroups}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding DateHeader}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource WlGlassInk}"
                                                               Margin="2,0,0,6" />
                                                    <Border Height="1" Background="#80FFFFFF" Margin="0,0,8,8" />
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,8,8" Padding="12,10" CornerRadius="10"
                                                                        MinHeight="56"
                                                                        VerticalAlignment="Top"
                                                                        Background="{StaticResource WlGlassNoteCardBg}"
                                                                        BorderBrush="{StaticResource WlGlassNoteCardBorder}"
                                                                        BorderThickness="1">
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock DockPanel.Dock="Right" FontSize="11"
                                                                                   Foreground="{StaticResource WlGlassMuted}"
                                                                                   Text="{Binding DurationDisplay}" />
                                                                        <StackPanel MinWidth="0">
                                                                            <TextBlock FontWeight="SemiBold" FontSize="13"
                                                                                       Foreground="{StaticResource WlGlassInk}"
                                                                                       Text="{Binding RemotePcDisplay}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                                                                                       Text="{Binding WindowDisplay}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </Border>
        </Grid>

        <Grid Panel.ZIndex="80"
              Visibility="{Binding IsSessionSearchOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#00000000" MouseLeftButtonDown="SessionPickerScrim_MouseLeftButtonDown" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource MyPagePickerCard}" Width="248">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MyPageHeaderIconButton}"
                                        Width="24" Height="24" ToolTip="이전 달"
                                        Command="{Binding PrevCalendarMonthCommand}">
                                    <Image Source="{StaticResource ExpandLeftIcon}" Width="9" Height="9" Opacity="0.45" />
                                </Button>
                                <Button Style="{StaticResource MyPageHeaderIconButton}"
                                        Width="24" Height="24" ToolTip="다음 달"
                                        Command="{Binding NextCalendarMonthCommand}">
                                    <Image Source="{StaticResource ExpandRightIcon}" Width="9" Height="9" Opacity="0.45" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding CalendarMonthTitle}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource WlGlassInk}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid Columns="7" Margin="0,0,0,2">
                            <TextBlock Text="일" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="월" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="화" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="수" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="목" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="금" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="토" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MyPageCalendarDayButton}"
                                            Width="32" Height="32"
                                            IsEnabled="{Binding IsCurrentMonth}"
                                            Command="{Binding DataContext.SelectCalendarDayCommand, ElementName=MyPageRoot}"
                                            CommandParameter="{Binding Date}">
                                        <Grid Width="32" Height="32">
                                            <Border Margin="1,4" Background="#3376ADFF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RangeFillMid}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="CornerRadius" Value="0" />
                                                                <Setter Property="Margin" Value="0,4" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RangeFillFromStart}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="CornerRadius" Value="4,0,0,4" />
                                                                <Setter Property="Margin" Value="1,4,0,4" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RangeFillToEnd}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="CornerRadius" Value="0,4,4,0" />
                                                                <Setter Property="Margin" Value="0,4,1,4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border Width="26" Height="26" CornerRadius="4"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTodayOnly}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#76ADFF" />
                                                                <Setter Property="Background" Value="#2276ADFF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEndpoint}" Value="True">
                                                                <Setter Property="Background" Value="#76ADFF" />
                                                                <Setter Property="BorderBrush" Value="#76ADFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding DayText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTodayOnly}" Value="True">
                                                                <Setter Property="Foreground" Value="#76ADFF" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEndpoint}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MyPagePickerCard}" Margin="8,0,0,0" MinWidth="148">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="시작" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ctrl:WheelPicker Value="{Binding DraftStartHour, Mode=TwoWay}"
                                              Minimum="0" Maximum="23" Step="1" />
                            <TextBlock Text=":" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                            <ctrl:WheelPicker Value="{Binding DraftStartMinute, Mode=TwoWay}"
                                              Minimum="0" Maximum="50" Step="10" />
                        </StackPanel>
                        <TextBlock Text="종료" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" Margin="0,8,0,2" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ctrl:WheelPicker Value="{Binding DraftEndHour, Mode=TwoWay}"
                                              Minimum="0" Maximum="23" Step="1" />
                            <TextBlock Text=":" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                            <ctrl:WheelPicker Value="{Binding DraftEndMinute, Mode=TwoWay}"
                                              Minimum="0" Maximum="50" Step="10" />
                        </StackPanel>
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="#76ADFF" FontSize="12" Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding ResetSessionDateDraftCommand}"
                                Content="재설정" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

