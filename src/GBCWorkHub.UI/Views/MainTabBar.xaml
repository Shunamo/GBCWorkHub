<UserControl x:Class="GBCWorkHub.UI.Views.MainTabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="TabBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassButtonHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="원격 PC"
                Command="{Binding SelectMainTabCommand}" CommandParameter="Remote"
                Visibility="{Binding IsUserShellVisible, Converter={StaticResource BoolToVis}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TabBarButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRemoteTab}" Value="True">
                            <Setter Property="Background" Value="#CCE8F0FF" />
                            <Setter Property="Foreground" Value="#1E293B" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="업무 기록" Margin="6,0,0,0"
                Command="{Binding SelectMainTabCommand}" CommandParameter="WorkLog"
                Visibility="{Binding IsUserShellVisible, Converter={StaticResource BoolToVis}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TabBarButton}">
                    <Setter Property="Content" Value="업무 기록" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorkLogTab}" Value="True">
                            <Setter Property="Background" Value="#CCE8F0FF" />
                            <Setter Property="Foreground" Value="#1E293B" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WorkLogList.HasNewCandidates}" Value="True">
                            <Setter Property="Content" Value="업무 기록 ●" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button Content="개선사항 요청" Margin="6,0,0,0"
                Command="{Binding SelectMainTabCommand}" CommandParameter="Improvement"
                Visibility="{Binding IsUserShellVisible, Converter={StaticResource BoolToVis}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TabBarButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImprovementTab}" Value="True">
                            <Setter Property="Background" Value="#CCE8F0FF" />
                            <Setter Property="Foreground" Value="#1E293B" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Me / Login + logout (same tab chrome, pastel red fill) -->
        <Grid Margin="6,0,0,0" VerticalAlignment="Center">
            <Button x:Name="MeTabButton"
                    Command="{Binding MeTabCommand}"
                    ToolTip="내 페이지 / 로그인"
                    HorizontalAlignment="Left">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabBarButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMeTab}" Value="True">
                                <Setter Property="Background" Value="#CCE8F0FF" />
                                <Setter Property="Foreground" Value="#1E293B" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource UserCircleIcon}" Width="16" Height="16"
                           Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                           Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding MeTabLabel}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="120" />
                </StackPanel>
            </Button>
            <Popup IsOpen="{Binding IsLogoutMenuOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=MeTabButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   HorizontalOffset="0"
                   VerticalOffset="4">
                <Button Content="로그아웃"
                        Command="{Binding LogoutCommand}"
                        Width="{Binding ActualWidth, ElementName=MeTabButton}"
                        Height="{Binding ActualHeight, ElementName=MeTabButton}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBarButton}">
                            <!-- 선택 탭(#CCE8F0FF)과 같은 fill 톤, 파스텔 레드 -->
                            <Setter Property="Background" Value="#CCF5E8E8" />
                            <Setter Property="Foreground" Value="#C48989" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E8D0D0" />
                                                <Setter Property="Foreground" Value="#B87474" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="Foreground" Value="#94A3B8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Popup>
            <Popup IsOpen="{Binding IsLoginGreetingVisible, Mode=OneWay}"
                   PlacementTarget="{Binding ElementName=MeTabButton}"
                   Placement="Bottom"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   IsHitTestVisible="False"
                   HorizontalOffset="0"
                   VerticalOffset="4">
                <TextBlock Text="{Binding LoginGreetingText}"
                           Foreground="#16A34A"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Padding="2,0" />
            </Popup>
        </Grid>
    </StackPanel>
</UserControl>
