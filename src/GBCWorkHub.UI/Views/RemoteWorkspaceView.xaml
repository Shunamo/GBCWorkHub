<UserControl x:Class="GBCWorkHub.UI.Views.RemoteWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GBCWorkHub.UI.ViewModels"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
             x:Name="RemoteWorkspaceRoot">
    <UserControl.Resources>
        <conv:StringEqualsMultiConverter x:Key="GroupFilterEquals" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style x:Key="RemoteUsageHistoryScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource GlassScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <DataTemplate x:Key="RemoteComputerCardTemplate">
            <Border Style="{StaticResource RemoteComputerCardStyle}"
                    Margin="16" Padding="8"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    MouseLeftButtonUp="RemoteComputerCard_MouseLeftButtonUp">
                <StackPanel HorizontalAlignment="Stretch">
                    <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image Width="96" Height="96" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource PcMonitorIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOwnedByOtherUser}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding IsInUse}" Value="False" />
                                                <Condition Binding="{Binding IsConnecting}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Opacity" Value="0.52" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Ellipse Width="10" Height="10" Fill="#FACC15"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                 ToolTip="AGENT 설치 완료"
                                 Visibility="{Binding AgentInstalled, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource RemoteAvailableBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource RemoteInUseBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource RemoteInUseBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCheckRequired}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource RemoteCheckRequiredBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Grid Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                              Visibility="{Binding HasVpnReadyBadge, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteVpnReadyBrush}" />
                            <TextBlock Text="V" FontSize="6" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#0F172A" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplaySubtitle}" FontSize="12" Foreground="#64748B"
                               Margin="0,4,0,0" TextAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding HasDisplaySubtitle, Converter={StaticResource BoolToVis}}" />
                    <!-- 도메인 1개: 한 줄(길면 축소) -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Stretch" Margin="2,2,2,0"
                             Visibility="{Binding HasSinglePcDomain, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PcDomainDisplay}" FontSize="11" Foreground="#94A3B8"
                                   TextAlignment="Center" TextWrapping="NoWrap" />
                    </Viewbox>
                    <!-- 도메인 2개+: 줄바꿈 -->
                    <TextBlock Text="{Binding PcDomainDisplay}" FontSize="11" Foreground="#94A3B8"
                               Margin="4,2,4,0" TextAlignment="Center" HorizontalAlignment="Stretch"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasMultiplePcDomains, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding OccupantText}" FontSize="12" Foreground="#475569" Margin="0,4,0,0"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding HasOccupant, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RemoteComputerListRowTemplate">
            <Border Padding="10,12" Margin="4,0,4,6" Cursor="Hand"
                    CornerRadius="10" BorderThickness="0"
                    MouseLeftButtonUp="RemoteComputerCard_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding IsInUse}" Value="False" />
                                    <Condition Binding="{Binding IsConnecting}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#331E293B" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image Width="36" Height="36">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource PcMonitorIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding IsInUse}" Value="False" />
                                                <Condition Binding="{Binding IsConnecting}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Opacity" Value="0.52" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Ellipse Width="6" Height="6" Fill="#FACC15"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                 ToolTip="AGENT 설치 완료"
                                 Visibility="{Binding AgentInstalled, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource RemoteAvailableBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource RemoteInUseBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource RemoteInUseBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCheckRequired}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource RemoteCheckRequiredBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Grid Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasVpnReadyBadge, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteVpnReadyBrush}" />
                                <TextBlock Text="V" FontSize="6" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-0.5,0,0" />
                            </Grid>
                            <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"
                                       Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"
                                   Text="{Binding DisplaySubtitle}"
                                   Visibility="{Binding HasDisplaySubtitle, Converter={StaticResource BoolToVis}}" />
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Left" Margin="0,2,0,0"
                                 Visibility="{Binding HasSinglePcDomain, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11" Foreground="#94A3B8"
                                       Text="{Binding PcDomainDisplay}"
                                       TextWrapping="NoWrap" />
                        </Viewbox>
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                   Text="{Binding PcDomainDisplay}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasMultiplePcDomains, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="12" Foreground="#475569"
                               Text="{Binding OccupantText}"
                               Visibility="{Binding HasOccupant, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="RemotePcGroupItemsStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate" Value="{StaticResource RemoteComputerCardTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ctrl:UniformWrapPanel MinItemWidth="160" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsListViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource RemoteComputerListRowTemplate}" />
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- 원격: 사이트 선택 — 헤더 여백은 동일, 타일은 중앙·화면 크기에 맞춤 -->
        <Grid Margin="24,68,24,24" Panel.ZIndex="1"
              Visibility="{Binding IsSitePickerVisible, Converter={StaticResource BoolToVis}}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     MaxWidth="720" MaxHeight="440"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <UniformGrid Rows="2" Columns="2" Width="720" Height="440">
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsAuroraSiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="AURORA">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuroraSiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="AURORA" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuroraSiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="준비 중" FontSize="12" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuroraSiteEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsCmcSiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="CMC">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCmcSiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="CMC" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCmcSiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="준비 중" FontSize="12" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCmcSiteEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsRcSiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="RC">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRcSiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="RC" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRcSiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="준비 중" FontSize="12" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRcSiteEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsMNGHASiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="MNGHA">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMNGHASiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="MNGHA" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMNGHASiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="준비 중" FontSize="12" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMNGHASiteEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </UniformGrid>
            </Viewbox>
        </Grid>
        <!-- 원격: 사이트별 PC 갤러리 (헤더는 상단 통합 헤더 사용) -->
        <Grid Margin="24,68,24,24" Panel.ZIndex="1"
              Visibility="{Binding IsGalleryVisible, Converter={StaticResource BoolToVis}}"
              Background="Transparent"
              PreviewMouseLeftButtonDown="GalleryRoot_PreviewMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassSurfaceStyle}"
                    Padding="10,14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,16,8,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteAvailableBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="사용 가능" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Grid Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteVpnReadyBrush}" />
                                <TextBlock Text="V" FontSize="6" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-0.5,0,0" />
                            </Grid>
                            <TextBlock Text="VPN 연결" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteInUseBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="사용 중" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <RadioButton Style="{StaticResource RemoteComputerSidebarButtonStyle}"
                                         IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringEquals}, ConverterParameter=ALL, Mode=OneWay}"
                                         Command="{Binding SelectStatusFilterCommand}" CommandParameter="ALL">
                                <Grid>
                                    <TextBlock Text="전체" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding TotalCount}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RemoteComputerSidebarButtonStyle}"
                                         IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringEquals}, ConverterParameter=AVAILABLE, Mode=OneWay}"
                                         Command="{Binding SelectStatusFilterCommand}" CommandParameter="AVAILABLE">
                                <Grid>
                                    <TextBlock Text="사용 가능" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding AvailableCount}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RemoteComputerSidebarButtonStyle}"
                                         IsChecked="{Binding SelectedStatusFilter, Converter={StaticResource StringEquals}, ConverterParameter=IN_USE, Mode=OneWay}"
                                         Command="{Binding SelectStatusFilterCommand}" CommandParameter="IN_USE">
                                <Grid>
                                    <TextBlock Text="사용 중" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding InUseCount}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                            </RadioButton>

                            <Border Height="1" Background="#E2E8F0" Margin="16,10,16,8" Opacity="0.7" />

                            <ItemsControl ItemsSource="{Binding SiteShortcuts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SiteShortcutSidebarButtonStyle}"
                                                IsEnabled="{Binding CanNavigate}"
                                                Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding SiteCode}"
                                                ToolTip="이 사이트로 이동">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{StaticResource RemoteAvailableBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SiteCode}" Foreground="#1E293B"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="(현재)" FontSize="11" Foreground="#94A3B8"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext" />

            <Grid x:Name="GalleryBodyGrid" Grid.Column="2" Background="Transparent"
                  SizeChanged="GalleryBodyGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,0,4,8" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 카드형 → 리스트 아이콘 / 리스트형 → 대시보드(카드) 아이콘 -->
                        <Button Style="{StaticResource HeaderIconButton}" Margin="0,0,4,0"
                                ToolTip="목록으로 보기"
                                Command="{Binding ChangeViewModeCommand}" CommandParameter="List"
                                Visibility="{Binding IsCardViewMode, Converter={StaticResource BoolToVis}}">
                            <Image Source="{StaticResource ListViewIcon}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource HeaderIconButton}" Margin="0,0,4,0"
                                ToolTip="카드로 보기"
                                Command="{Binding ChangeViewModeCommand}" CommandParameter="Card"
                                Visibility="{Binding IsListViewMode, Converter={StaticResource BoolToVis}}">
                            <Image Source="{StaticResource DashboardViewIcon}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource HeaderIconButton}" Margin="8,0,0,0"
                                ToolTip="PC 추가 (관리자)"
                                Command="{Binding AddRemotePcCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="＋" FontSize="16" FontWeight="SemiBold" Foreground="#15803D"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#A6FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1.5"
                            CornerRadius="12" Padding="10,6" Width="280" HorizontalAlignment="Right">
                        <Grid>
                            <TextBlock Text="PC 이름, IP 또는 사용자 검색"
                                       Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="13" />
                        </Grid>
                    </Border>

                    <!-- PC의 소속 그룹(진료지원/진료간호/원무 등) 필터. 사이드바 대신 검색창 옆에 둬서
                         옵션이 많아져도 스크롤 없이 항상 바로 보이게 한다. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasGroupFilterOptions, Converter={StaticResource BoolToVis}}">
                        <Button x:Name="GroupFilterButton" Style="{StaticResource GlassSiteLabelButton}"
                                Command="{Binding ToggleGroupFilterCommand}" ToolTip="그룹 필터">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedGroupFilter}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1E293B" VerticalAlignment="Center" />
                                <Image Width="8" Height="8" Margin="5,1,0,0" VerticalAlignment="Center" Opacity="0.7" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="{StaticResource ExpandDownIcon}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroupFilterOpen}" Value="True">
                                                    <Setter Property="Source" Value="{StaticResource ExpandUpIcon}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </StackPanel>
                        </Button>
                        <Popup IsOpen="{Binding IsGroupFilterOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=GroupFilterButton}"
                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="6"
                               AllowsTransparency="True" PopupAnimation="None" StaysOpen="False">
                            <Border Background="Transparent" BorderThickness="0" Padding="2,4,0,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#3B5070" />
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding GroupFilterOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GlassSiteChipButton}" Content="{Binding}"
                                                    Command="{Binding DataContext.SelectGroupFilterCommand, ElementName=RemoteWorkspaceRoot}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </StackPanel>
                </DockPanel>

                <!-- PC gallery skeleton -->
                <ctrl:UniformWrapPanel Grid.Row="1" Margin="0,4,0,0" MinItemWidth="160"
                           Visibility="{Binding IsGalleryLoading, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="88" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="64" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="96" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="56" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="80" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="70" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="92" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="60" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="84" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="66" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="100" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="52" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ctrl:UniformWrapPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGalleryLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding GalleryGroups}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#475569" Margin="16,12,16,4"
                                               Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Computers}"
                                                  Style="{StaticResource RemotePcGroupItemsStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="UsageHistoryHost" Grid.Row="2" Style="{StaticResource GlassSurfaceStyle}"
                        Padding="12,10" Margin="4,8,4,0"
                        Visibility="{Binding HasSelectedRemoteComputer, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource HeaderIconButton}"
                                            ToolTip="접속 정보 수정"
                                            Command="{Binding BeginEditPcAccessCommand}"
                                            Visibility="{Binding ShowPcAccessEditButton, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{StaticResource EditFillIcon}" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource HeaderIconButton}"
                                            Margin="4,0,0,0"
                                            ToolTip="저장"
                                            Command="{Binding SavePcAccessCommand}"
                                            Visibility="{Binding ShowPcAccessSaveButton, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{StaticResource SaveFillIcon}" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource HeaderIconButton}"
                                            Margin="4,0,0,0"
                                            ToolTip="수정 취소"
                                            Command="{Binding CancelEditPcAccessCommand}"
                                            Visibility="{Binding ShowPcAccessSaveButton, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="✕" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Style="{StaticResource HeaderIconButton}"
                                            Margin="8,0,0,0"
                                            ToolTip="PC 삭제 (관리자)"
                                            Command="{Binding DeleteRemotePcCommand}"
                                            Visibility="{Binding ShowAdminDeletePcButton, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="삭제" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#C48989" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding RemoteComputerName}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1E293B" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,8"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="IP" Width="40" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AdminEditPcIp}" FontSize="12.5" Foreground="#1E293B"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPcAccessReadOnly, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Text="{Binding AdminEditPcIp, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="140" Padding="4,2" FontSize="12.5"
                                             Visibility="{Binding IsPcAccessEditing, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="소속" Width="40" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AdminEditTeamName}" FontSize="12.5" Foreground="#1E293B"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPcAccessReadOnly, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Text="{Binding AdminEditTeamName, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="140" Padding="4,2" FontSize="12.5"
                                             Visibility="{Binding IsPcAccessEditing, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{Binding SelectedPcAccessSections}"
                                          Margin="0,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Grid.IsSharedSizeScope="True"
                                          Visibility="{Binding HasSelectedPcAccessSections, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RemoteUsageHistoryRowStyle}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch"
                                                Margin="0,0,8,0">
                                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource RemoteUsageHistoryColHeader}"
                                                           FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Fields}"
                                                              HorizontalAlignment="Left">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,2" HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PcAccLbl" MinWidth="28" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Height="24" VerticalAlignment="Top" Margin="0,0,10,0"
                                                                        HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#64748B"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Lines}"
                                                                              HorizontalAlignment="Left">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Height="24" Margin="0,0,0,2"
                                                                                  HorizontalAlignment="Left">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Value}"
                                                                                           FontSize="12.5"
                                                                                           Foreground="#1E293B"
                                                                                           VerticalAlignment="Center"
                                                                                           TextWrapping="NoWrap"
                                                                                           TextTrimming="None"
                                                                                           Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                         FontSize="12.5"
                                                                                         Foreground="#1E293B"
                                                                                         VerticalContentAlignment="Center"
                                                                                         HorizontalAlignment="Left"
                                                                                         MinWidth="80"
                                                                                         BorderThickness="1"
                                                                                         BorderBrush="#D9FFFFFF"
                                                                                         Background="#66FFFFFF"
                                                                                         Padding="4,0"
                                                                                         Height="24"
                                                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                                                         IsTabStop="{Binding IsEditing}" />
                                                                                <Grid Grid.Column="1" Width="24" Height="24" Margin="6,0,0,0"
                                                                                      VerticalAlignment="Center"
                                                                                      Visibility="{Binding DataContext.IsPcAccessReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                                                    <Button Style="{StaticResource HeaderIconButton}"
                                                                                            VerticalAlignment="Center"
                                                                                            HorizontalAlignment="Center"
                                                                                            ToolTip="복사됨"
                                                                                            IsHitTestVisible="False"
                                                                                            Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}}">
                                                                                        <Image Source="{StaticResource DoneLightIcon}" Width="14" Height="14" />
                                                                                    </Button>
                                                                                    <Button Style="{StaticResource HeaderIconButton}"
                                                                                            VerticalAlignment="Center"
                                                                                            HorizontalAlignment="Center"
                                                                                            ToolTip="{Binding Value, StringFormat=복사: {0}}"
                                                                                            Command="{Binding CopyCommand}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Visibility="{Binding ShowCopyIcon, Converter={StaticResource BoolToVis}}">
                                                                                        <Image Source="{StaticResource CopyAltIcon}" Width="14" Height="14" />
                                                                                    </Button>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource RemoteUsageHistoryRowStyle}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Margin="0,0,0,0"
                                    Visibility="{Binding ShowPcAccessCommentColumn, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Stretch" MaxWidth="280">
                                    <TextBlock Text="COMMENT"
                                               Style="{StaticResource RemoteUsageHistoryColHeader}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedPcComment}"
                                               FontSize="12.5"
                                               Foreground="#1E293B"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Stretch"
                                               Visibility="{Binding IsPcAccessReadOnly, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Text="{Binding SelectedPcComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="120"
                                             MinHeight="24"
                                             VerticalAlignment="Stretch"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             BorderThickness="1"
                                             BorderBrush="#D9FFFFFF"
                                             Background="#66FFFFFF"
                                             Padding="4,2"
                                             Foreground="#1E293B"
                                             FontSize="12.5"
                                             VerticalScrollBarVisibility="Disabled"
                                             HorizontalScrollBarVisibility="Disabled"
                                             Visibility="{Binding IsPcAccessEditing, Converter={StaticResource BoolToVis}}"
                                             IsTabStop="{Binding IsPcAccessEditing}"
                                             ToolTip="연필 아이콘으로 수정 후 저장하세요." />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="최근 접속 내역이 없습니다."
                                   FontSize="13" Foreground="#94A3B8" Margin="2,8,0,0"
                                   Visibility="{Binding HasRecentUsageLogs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasRecentUsageLogs, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="4,0,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="72" />
                                    <ColumnDefinition Width="1*" MinWidth="64" />
                                    <ColumnDefinition Width="1.4*" MinWidth="88" />
                                    <ColumnDefinition Width="1.3*" MinWidth="96" />
                                    <ColumnDefinition Width="1.1*" MinWidth="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="접속자" Style="{StaticResource RemoteUsageHistoryColHeader}"
                                           HorizontalAlignment="Stretch" TextAlignment="Left" Padding="8,0" Margin="0,0,0,6" />
                                <TextBlock Grid.Column="1" Text="소속" Style="{StaticResource RemoteUsageHistoryColHeader}"
                                           HorizontalAlignment="Stretch" TextAlignment="Left" Padding="8,0" Margin="0,0,0,6" />
                                <TextBlock Grid.Column="2" Text="로컬 PC" Style="{StaticResource RemoteUsageHistoryColHeader}"
                                           HorizontalAlignment="Stretch" TextAlignment="Left" Padding="8,0" Margin="0,0,0,6" />
                                <TextBlock Grid.Column="3" Text="접속 날짜" Style="{StaticResource RemoteUsageHistoryColHeader}"
                                           HorizontalAlignment="Stretch" TextAlignment="Left" Padding="8,0" Margin="0,0,0,6" />
                                <TextBlock Grid.Column="4" Text="점유 시간" Style="{StaticResource RemoteUsageHistoryColHeader}"
                                           HorizontalAlignment="Stretch" TextAlignment="Left" Padding="8,0" Margin="0,0,0,6" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentUsageLogs, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RemoteUsageHistoryRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*" MinWidth="72" />
                                                    <ColumnDefinition Width="1*" MinWidth="64" />
                                                    <ColumnDefinition Width="1.4*" MinWidth="88" />
                                                    <ColumnDefinition Width="1.3*" MinWidth="96" />
                                                    <ColumnDefinition Width="1.1*" MinWidth="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding OccupantNameDisplay}"
                                                           Style="{StaticResource RemoteUsageHistoryColText}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Stretch" TextAlignment="Left"
                                                           Padding="8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding AffiliationDisplay}"
                                                           Style="{StaticResource RemoteUsageHistoryColText}"
                                                           Foreground="#475569"
                                                           HorizontalAlignment="Stretch" TextAlignment="Left"
                                                           Padding="8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding LocalPcDisplay}"
                                                           Style="{StaticResource RemoteUsageHistoryColText}"
                                                           Foreground="#475569"
                                                           HorizontalAlignment="Stretch" TextAlignment="Left"
                                                           Padding="8,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding OccupancyDateDisplay}"
                                                           Style="{StaticResource RemoteUsageHistoryColText}"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Stretch" TextAlignment="Left"
                                                           Padding="8,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding OccupancySpanDisplay}"
                                                           Style="{StaticResource RemoteUsageHistoryColText}"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Stretch" TextAlignment="Left"
                                                           Padding="8,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>