<UserControl x:Class="GBCWorkHub.UI.Views.RemoteWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GBCWorkHub.UI.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="RemoteComputerCardTemplate">
            <Border Style="{StaticResource RemoteComputerCardStyle}"
                    Margin="16" Padding="8"
                    MouseLeftButtonUp="RemoteComputerCard_MouseLeftButtonUp">
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{StaticResource PcMonitorIcon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                        <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOwnedByOtherUser}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" MaxWidth="160">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource RemoteAvailableBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource RemoteInUseBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource RemoteInUseBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCheckRequired}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource RemoteCheckRequiredBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Grid Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                              Visibility="{Binding HasVpnReadyBadge, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteVpnReadyBrush}" />
                            <TextBlock Text="V" FontSize="6" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplaySubtitle}" FontSize="12" Foreground="#64748B"
                               Margin="0,4,0,0" TextAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="140" />
                    <TextBlock Text="{Binding OccupantText}" FontSize="12" Foreground="#475569" Margin="0,4,0,0"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="140"
                               Visibility="{Binding HasOccupant, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RemoteComputerListRowTemplate">
            <Border Padding="10,12" Margin="0,0,0,6" Cursor="Hand"
                    CornerRadius="8" BorderThickness="2"
                    MouseLeftButtonUp="RemoteComputerCard_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{StaticResource RemoteAvailableBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource RemoteInUseBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource RemoteInUseBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCheckRequired}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource RemoteCheckRequiredBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{StaticResource PcMonitorIcon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                        <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Source" Value="{StaticResource PcMonitorIconInUse}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasVpnReadyBadge, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteVpnReadyBrush}" />
                                <TextBlock Text="V" FontSize="6" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-0.5,0,0" />
                            </Grid>
                            <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"
                                       Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0"
                                   Text="{Binding DisplaySubtitle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="12" Foreground="#475569"
                               Text="{Binding OccupantText}"
                               Visibility="{Binding HasOccupant, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <!-- 원격: 사이트 선택 — 헤더 여백은 동일, 타일은 중앙·화면 크기에 맞춤 -->
        <Grid Margin="24,68,24,24" Panel.ZIndex="1"
              Visibility="{Binding IsSitePickerVisible, Converter={StaticResource BoolToVis}}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     MaxWidth="720" MaxHeight="440"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <UniformGrid Rows="2" Columns="2" Width="720" Height="440">
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsAuroraSiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="AURORA">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuroraSiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="AURORA" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuroraSiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="준비 중" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuroraSiteEnabled}" Value="True">
                                            <Setter Property="Text" Value="사용 가능" />
                                            <Setter Property="Foreground" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsCmcSiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="CMC">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCmcSiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="CMC" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCmcSiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="준비 중" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCmcSiteEnabled}" Value="True">
                                            <Setter Property="Text" Value="사용 가능" />
                                            <Setter Property="Foreground" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsRcSiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="RC">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRcSiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="RC" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRcSiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="준비 중" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRcSiteEnabled}" Value="True">
                                            <Setter Property="Text" Value="사용 가능" />
                                            <Setter Property="Foreground" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SiteTileStyle}"
                        IsEnabled="{Binding IsMNGHASiteEnabled}"
                        Command="{Binding OpenSiteCommand}" CommandParameter="MNGHA">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="56" Height="56" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource SiteIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMNGHASiteEnabled}" Value="True">
                                            <Setter Property="Source" Value="{StaticResource SiteIconActive}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="MNGHA" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMNGHASiteEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#1E293B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="준비 중" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMNGHASiteEnabled}" Value="True">
                                            <Setter Property="Text" Value="사용 가능" />
                                            <Setter Property="Foreground" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </UniformGrid>
            </Viewbox>
        </Grid>
        <!-- 원격: 사이트별 PC 갤러리 (헤더는 상단 통합 헤더 사용) -->
        <Grid Margin="24,68,24,24" Panel.ZIndex="1"
              Visibility="{Binding IsGalleryVisible, Converter={StaticResource BoolToVis}}"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassSurfaceStyle}"
                    Padding="10,14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,16,8,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteAvailableBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="사용 가능" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Grid Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteVpnReadyBrush}" />
                                <TextBlock Text="V" FontSize="6" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-0.5,0,0" />
                            </Grid>
                            <TextBlock Text="VPN 연결" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteInUseBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="사용 중" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RemoteCheckRequiredBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="확인 필요" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <RadioButton Style="{StaticResource RemoteComputerSidebarButtonStyle}"
                                         GroupName="StatusFilter" IsChecked="True"
                                         Command="{Binding SelectStatusFilterCommand}" CommandParameter="ALL">
                                <Grid>
                                    <TextBlock Text="전체" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding TotalCount}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RemoteComputerSidebarButtonStyle}"
                                         GroupName="StatusFilter"
                                         Command="{Binding SelectStatusFilterCommand}" CommandParameter="AVAILABLE">
                                <Grid>
                                    <TextBlock Text="사용 가능" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding AvailableCount}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RemoteComputerSidebarButtonStyle}"
                                         GroupName="StatusFilter"
                                         Command="{Binding SelectStatusFilterCommand}" CommandParameter="IN_USE">
                                <Grid>
                                    <TextBlock Text="사용 중" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding InUseCount}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RemoteComputerSidebarButtonStyle}"
                                         GroupName="StatusFilter"
                                         Command="{Binding SelectStatusFilterCommand}" CommandParameter="CHECK_REQUIRED">
                                <Grid>
                                    <TextBlock Text="확인 필요" Foreground="#1E293B" />
                                    <TextBlock Text="{Binding CheckRequiredCount}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,0,4,8" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 카드형 → 리스트 아이콘 / 리스트형 → 대시보드(카드) 아이콘 -->
                        <Button Style="{StaticResource HeaderIconButton}" Margin="0,0,4,0"
                                ToolTip="목록으로 보기"
                                Command="{Binding ChangeViewModeCommand}" CommandParameter="List"
                                Visibility="{Binding IsCardViewMode, Converter={StaticResource BoolToVis}}">
                            <Image Source="{StaticResource ListViewIcon}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource HeaderIconButton}" Margin="0,0,4,0"
                                ToolTip="카드로 보기"
                                Command="{Binding ChangeViewModeCommand}" CommandParameter="Card"
                                Visibility="{Binding IsListViewMode, Converter={StaticResource BoolToVis}}">
                            <Image Source="{StaticResource DashboardViewIcon}" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#A6FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1.5"
                            CornerRadius="12" Padding="10,6" Width="280" HorizontalAlignment="Right">
                        <Grid>
                            <TextBlock Text="PC 이름, IP 또는 사용자 검색"
                                       Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="13" />
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- PC gallery skeleton -->
                <WrapPanel Grid.Row="1" Margin="0,4,0,0"
                           Visibility="{Binding IsGalleryLoading, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="88" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="64" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="96" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="56" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="80" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="70" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="92" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="60" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="84" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="66" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SkeletonPcCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonBoneSoftStyle}" Width="72" Height="72" CornerRadius="12" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="100" Height="12" Margin="0,14,0,0" />
                            <Border Style="{StaticResource SkeletonBoneStyle}" Width="52" Height="10" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCardViewMode}" Value="True" />
                                        <Condition Binding="{Binding IsGalleryLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding FilteredRemoteComputers}"
                                  ItemTemplate="{StaticResource RemoteComputerCardTemplate}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsListViewMode}" Value="True" />
                                        <Condition Binding="{Binding IsGalleryLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding FilteredRemoteComputers}"
                                  ItemTemplate="{StaticResource RemoteComputerListRowTemplate}"
                                  Margin="0,0,0,8" />
                </ScrollViewer>

                <Expander Grid.Row="2" Header="선택 PC 상세 · 최근 접속 3건" IsExpanded="False"
                          Background="Transparent" BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0" Padding="4,8">
                    <Grid MaxHeight="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Margin="0,8,12,0">
                            <StackPanel Margin="0,0,24,8" MinWidth="140">
                                <TextBlock Text="원격 PC" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding RemoteComputerName}" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="상태" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CurrentStatus}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#2563EB" Margin="0,0,0,8" />
                            </StackPanel>
                            <StackPanel MinWidth="140">
                                <TextBlock Text="사용자" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding WorkHubUserAccount}" Style="{StaticResource FieldValue}" />
                                <TextBlock Text="접속 PC" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding WorkHubClientPc}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                        </WrapPanel>
                        <DataGrid Grid.Column="1" Margin="0,8,0,0"
                                  ItemsSource="{Binding RecentUsageLogs, Mode=OneWay}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="#F8FAFC"
                                  IsReadOnly="True" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="접속자" Binding="{Binding UserDisplay}" Width="90" />
                                <DataGridTextColumn Header="접속 PC" Binding="{Binding ClientDisplay}" Width="*" />
                                <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplay}" Width="70" />
                                <DataGridTextColumn Header="시작" Binding="{Binding RequestedAtDisplay}" Width="90" />
                                <DataGridTextColumn Header="종료" Binding="{Binding EndedAtDisplay}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</UserControl>