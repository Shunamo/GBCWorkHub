<Window x:Class="GBCWorkHub.UI.Views.Popup.PopupHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 전체 화면 딤 -->
    <Grid Background="#990F172A">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="14" Padding="24" MinWidth="380" MaxWidth="480"
                Margin="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" Margin="0,0,12,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding IconGlyph}" FontWeight="Bold" FontSize="16"
                                   Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                               Foreground="#1E293B" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="13.5" Foreground="#334155"
                           TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Text="{Binding Detail}" FontSize="12.5" Foreground="#64748B"
                           TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="3" Margin="0,8,0,8"
                            Visibility="{Binding IsProgress, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ProgressStepText}" FontSize="13" Foreground="#475569"
                               TextWrapping="Wrap" />
                    <Button Content="취소" Margin="0,16,0,0" HorizontalAlignment="Right"
                            MinWidth="88" MinHeight="34" Padding="14,7"
                            Command="{Binding CancelProgressCommand}"
                            Visibility="{Binding ShowCancelOnProgress, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ItemsControl Grid.Row="4" ItemsSource="{Binding Buttons}" Margin="0,12,0,0"
                              Visibility="{Binding IsConfirmOrResult, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}" Margin="8,0,0,0" MinWidth="100" MinHeight="34"
                                    Padding="14,7" Cursor="Hand"
                                    Command="{Binding DataContext.ButtonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Foreground" Value="#1E293B" />
                                        <Setter Property="BorderBrush" Value="#D8DEE8" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
