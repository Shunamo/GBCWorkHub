<UserControl x:Class="GBCWorkHub.UI.Views.Popup.PopupHostWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
             Focusable="True"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="Host_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogGlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="GlassPromptInput" TargetType="TextBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
                <Setter Property="CaretBrush" Value="{StaticResource WlGlassAccent}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="#F4F6F9"
                                    BorderBrush="#D8DEE8"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Color="#2F4466" />
                                </Border.Effect>
                                <Grid>
                                    <!-- 힌트는 오른쪽 / 캐럿은 왼쪽(12) -->
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               Margin="18,0,14,0"
                                               VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="#94A3B8"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="12,0,14,0"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassPromptPassword" TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
                <Setter Property="CaretBrush" Value="{StaticResource WlGlassAccent}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="#F4F6F9"
                                    BorderBrush="#D8DEE8"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Color="#2F4466" />
                                </Border.Effect>
                                <Grid>
                                    <TextBlock x:Name="Placeholder"
                                               Text="{TemplateBinding Tag}"
                                               Margin="18,0,14,0"
                                               VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="#94A3B8"
                                               IsHitTestVisible="False" />
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="12,0,14,0"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#660F172A" ClipToBounds="True">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F4F6FA"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24" MinWidth="380" MaxWidth="500" Margin="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.14" Color="#2F4466" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" Margin="0,0,12,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding IconGlyph}" FontWeight="Bold" FontSize="16"
                                   Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                               Foreground="#1E293B" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="13.5" Foreground="#334155"
                           TextWrapping="Wrap" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Message}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="2" Visibility="{Binding ShowPromptFields, Converter={StaticResource BoolToVis}}">
                    <StackPanel Visibility="{Binding ShowInput, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="이름" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                        <TextBox x:Name="PromptInputBox"
                                 Style="{StaticResource GlassPromptInput}"
                                 Tag="ex) 김ㅇㅇ"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowAffiliationInput, Converter={StaticResource BoolToVis}}"
                                Margin="0,10,0,0">
                        <TextBlock Text="소속" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                        <TextBox x:Name="AffiliationInputBox"
                                 Style="{StaticResource GlassPromptInput}"
                                 Tag="ex) 진료지원"
                                 Text="{Binding AffiliationText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowSecondaryInput, Converter={StaticResource BoolToVis}}"
                                Margin="0,10,0,0">
                        <TextBlock Text="{Binding SecondaryInputLabel}" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                        <TextBox x:Name="SecondaryInputBox"
                                 Style="{StaticResource GlassPromptInput}"
                                 Text="{Binding SecondaryInputText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowCurrentPasswordInput, Converter={StaticResource BoolToVis}}"
                                Margin="0,10,0,0">
                        <TextBlock Text="현재 비밀번호" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PromptCurrentPasswordBox"
                                     Style="{StaticResource GlassPromptPassword}"
                                     Tag="영문·숫자만"
                                     InputMethod.IsInputMethodEnabled="False"
                                     PreviewTextInput="PromptCurrentPasswordBox_PreviewTextInput"
                                     PreviewKeyDown="PromptCurrentPasswordBox_PreviewKeyDown"
                                     PasswordChanged="PromptCurrentPasswordBox_PasswordChanged" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowPasswordInput, Converter={StaticResource BoolToVis}}"
                                Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding PasswordFieldLabel, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                            <TextBlock Text=" (비워두면 변경 안 함)" FontSize="12" Foreground="#94A3B8"
                                       Visibility="{Binding ShowPasswordOptionalHint, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <PasswordBox x:Name="PromptPasswordBox"
                                     Style="{StaticResource GlassPromptPassword}"
                                     Tag="영문·숫자만"
                                     InputMethod.IsInputMethodEnabled="False"
                                     PreviewTextInput="PromptPasswordBox_PreviewTextInput"
                                     PreviewKeyDown="PromptPasswordBox_PreviewKeyDown"
                                     PasswordChanged="PromptPasswordBox_PasswordChanged" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowPasswordConfirm, Converter={StaticResource BoolToVis}}"
                                Margin="0,10,0,0">
                        <TextBlock Text="비밀번호 확인" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PromptPasswordConfirmBox"
                                     Style="{StaticResource GlassPromptPassword}"
                                     Tag="영문·숫자만"
                                     InputMethod.IsInputMethodEnabled="False"
                                     PreviewTextInput="PromptPasswordConfirmBox_PreviewTextInput"
                                     PreviewKeyDown="PromptPasswordConfirmBox_PreviewKeyDown"
                                     PasswordChanged="PromptPasswordConfirmBox_PasswordChanged" />
                    </StackPanel>
                    <TextBlock Text="{Binding InputError}" FontSize="12" Foreground="#DC2626" Margin="0,6,0,0"
                               Visibility="{Binding HasInputError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Border Grid.Row="3" Margin="0,14,0,0" Padding="12,10" CornerRadius="12"
                        Background="#EEF1F5" BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding HasPromptInfo, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="PC IP" FontSize="12" Foreground="#64748B" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding InfoIp}" FontSize="13.5" Foreground="#1E293B" Margin="0,0,0,8" />
                        <TextBlock Text="Windows 계정" FontSize="12" Foreground="#64748B" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding InfoWindowsAccount}" FontSize="13.5" Foreground="#1E293B" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Text="{Binding Detail}" FontSize="12.5" Foreground="#64748B"
                           TextWrapping="Wrap" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="4" Margin="0,8,0,0"
                            Visibility="{Binding IsProgress, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ProgressStepText}" FontSize="13" Foreground="#475569"
                               TextWrapping="Wrap" />
                    <Button Content="취소" Margin="0,16,0,0" HorizontalAlignment="Right"
                            MinWidth="88" MinHeight="34" Padding="14,7"
                            Command="{Binding CancelProgressCommand}"
                            Visibility="{Binding ShowCancelOnProgress, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ItemsControl Grid.Row="5" ItemsSource="{Binding Buttons}" Margin="0,16,0,0"
                              Visibility="{Binding IsConfirmOrResult, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}" Margin="8,0,0,0" MinWidth="100" MinHeight="34"
                                    Padding="14,7" Cursor="Hand"
                                    Command="{Binding DataContext.ButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Foreground" Value="#1E293B" />
                                        <Setter Property="BorderBrush" Value="#D8DEE8" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                            <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
