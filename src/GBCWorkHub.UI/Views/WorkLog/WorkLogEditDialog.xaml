<UserControl x:Class="GBCWorkHub.UI.Views.WorkLog.WorkLogEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GBCWorkHub.UI.Views"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogGlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 노션 스타일 세모 토글 — 이전엔 헤더의 ON/OFF 스위치와 같은 모양이었는데,
                 여닫는 느낌이 드는 세모 화살표(펼치면 아래, 접으면 오른쪽) 방식으로 바꿔달라는 요청. -->
            <Style x:Key="CheckinMessageSwitch" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Image x:Name="Chevron" Source="{StaticResource ExpandRightIcon}"
                                       Width="9" Height="9" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBlock Text="TFS 체크인 메시지"
                                           FontSize="{StaticResource FontSize.Xs}"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Source" Value="{StaticResource ExpandDownIcon}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WorkLogGlassCheckButton" TargetType="Button">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Width="18" Height="18"
                                    Background="#99FFFFFF"
                                    BorderBrush="#D9FFFFFF"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.10" Color="#2F4466" />
                                </Border.Effect>
                                <Image x:Name="Mark"
                                       Source="{DynamicResource DoneLightIcon}"
                                       Width="12" Height="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#B8D0E0" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#A0B8CC" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Checked">
                                    <Setter TargetName="Bd" Property="Background" Value="#B8CFE0FF" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#994F67D8" />
                                    <Setter TargetName="Mark" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TreeNodeBorder" TargetType="Border">
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EditTreeSelectedBg}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EditTreeHoverBg}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TreeToggleSquare" TargetType="Border">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- (comment trimmed) -->
            <Style x:Key="TreePlusButton" TargetType="Button" BasedOn="{StaticResource WorkLogIconButton}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="하위 추가" />
            </Style>

            <Style x:Key="TreeAddMenuButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <!-- ItemsControl(메뉴 목록)과 동일 좌측 시작: Margin 8 -->
                <Setter Property="Margin" Value="8,8,8,4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTip" Value="Menu 추가" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#334155" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TreeToggleButton" TargetType="Button" BasedOn="{StaticResource WorkLogIconButton}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="펼치기/접기" />
            </Style>

            <Style x:Key="TreeRowIconButton" TargetType="Button" BasedOn="{StaticResource WorkLogIconButton}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="TreeNodeTitleText" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#1E293B" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaceholderTitle}" Value="True">
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TreeSourceSquareSlot" TargetType="Border">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="TreeSourceRowBorder" TargetType="Border" BasedOn="{StaticResource TreeNodeBorder}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EditTreeSelectedBg}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAppended}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource EditTreeAppendedBg}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActive}" Value="True" />
                            <Condition Binding="{Binding IsAppended}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource EditTreeAppendedActiveBg}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- (comment trimmed) -->
            <Style x:Key="TreeGuideVertical" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="MinWidth" Value="1" />
                <Setter Property="MaxWidth" Value="1" />
                <Setter Property="Background" Value="{DynamicResource EditTreeGuideBg}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Opacity" Value="0.28" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <!-- (comment trimmed) -->
            <Style x:Key="TreeGuideVerticalMenu" TargetType="Border" BasedOn="{StaticResource TreeGuideVertical}">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="12,22,0,0" />
                <Setter Property="Panel.ZIndex" Value="20" />
            </Style>

            <!-- (comment trimmed) -->
            <Style x:Key="TreeGuideVerticalNode" TargetType="Border" BasedOn="{StaticResource TreeGuideVertical}">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="12,23,0,0" />
                <Setter Property="Panel.ZIndex" Value="20" />
            </Style>

            <!-- (comment trimmed) -->
            <Style x:Key="TreeGuideVerticalType" TargetType="Border" BasedOn="{StaticResource TreeGuideVerticalNode}">
                <Setter Property="Margin" Value="12.5,23,0,0" />
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="CanContentScroll" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" ItemsSource="{Binding ImportGroupSlots}"
                      Margin="16,8,16,0" HorizontalAlignment="Left"
                      Visibility="{Binding HasImportGroups, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectImportGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Foreground="#16A34A"
                                       Visibility="{Binding ShowGreenCheck, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Foreground="#94A3B8"
                                       Visibility="{Binding ShowGrayCheck, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ticket/save chrome lives in the right pane (same layout as detail). -->
        <Grid x:Name="EditBodyGrid" Grid.Row="1" MinWidth="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32*" MinWidth="160" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="68*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: tree panel — height follows content (scroll when taller than body) -->
            <Border Grid.Column="0" Style="{DynamicResource EditTreePanel}"
                    VerticalAlignment="Top"
                    MaxHeight="{Binding ActualHeight, ElementName=EditBodyGrid}">
                <Grid>
                    <Border Height="22" VerticalAlignment="Top"
                            CornerRadius="16,16,0,0" Background="{DynamicResource EditGlassSheen}"
                            IsHitTestVisible="False" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                    <Border Padding="12,12,12,10" BorderBrush="{DynamicResource EditChromeBorder}" BorderThickness="0,0,0,1">
                            <Grid MinHeight="34">
                                <Border Style="{DynamicResource EditTreeSearchField}" />
                                <Grid Margin="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox BorderThickness="0" Background="Transparent"
                                                 Padding="10,0,4,0" FontSize="{StaticResource FontSize.Base}"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="메뉴/프로젝트/소스 검색" IsHitTestVisible="False"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="#94A3B8" FontSize="{StaticResource FontSize.Base}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TreeSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TreeSearchText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Image Grid.Column="1" Source="{StaticResource SearchLightIcon}"
                                           Width="14" Height="14" Margin="0,0,10,0"
                                           VerticalAlignment="Center" Opacity="0.65"
                                           IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                    </Border>

                    <Button Style="{DynamicResource TreeAddMenuButton}"
                            Command="{Binding AddMenuCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="+ MENU" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center" />
                    </Button>

                        <ItemsControl ItemsSource="{Binding Tree.MenuSections}" Margin="8,4,8,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel>
                                        <!-- Menu -->
                                        <Border Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,0,2"
                                                Panel.ZIndex="0"
                                                Style="{DynamicResource TreeNodeBorder}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Style="{DynamicResource TreeToggleButton}"
                                                                Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Ticket Contents">
                                                            <Image Source="{StaticResource LabelDuotoneFillIcon}" Width="14" Height="14">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                <Setter Property="Opacity" Value="0.4" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Button>
                                                        <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                                MinWidth="0" VerticalAlignment="Top">
                                                            <Border.InputBindings>
                                                                <MouseBinding Gesture="LeftClick"
                                                                              Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}" />
                                                            </Border.InputBindings>
                                                            <TextBlock Text="{Binding Title}" Style="{DynamicResource TreeNodeTitleText}" />
                                                        </Border>
                                                        <Button Grid.Column="2" Style="{DynamicResource TreePlusButton}"
                                                                ToolTip="Type 추가"
                                                                Command="{Binding DataContext.AddChildCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                            <Image Source="{StaticResource AddRingIcon}" Width="14" Height="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Button>
                                                        <Button Grid.Column="3" Style="{DynamicResource TreeRowIconButton}"
                                                                Width="18" Height="18" VerticalAlignment="Top" ToolTip="Menu 삭제"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                            <Image Source="{StaticResource RemoveDuotoneLineIcon}" Width="14" Height="14" />
                                                        </Button>
                                                    </Grid>
                                        </Border>

                                        <!-- (comment trimmed) -->
                                        <ItemsControl ItemsSource="{Binding Types}"
                                                      Margin="18,0,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <StackPanel>
                                                        <!-- Type -->
                                                        <Border Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}"
                                                                Margin="0,1" Style="{DynamicResource TreeNodeBorder}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0" Style="{DynamicResource TreeToggleButton}"
                                                                                Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" ToolTip="Type">
                                                                            <Image Source="{StaticResource Box3dFillIcon}" Width="14" Height="14">
                                                                                <Image.Style>
                                                                                    <Style TargetType="Image">
                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                                <Setter Property="Opacity" Value="0.4" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
                                                                            </Image>
                                                                        </Button>
                                                                        <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                                                MinWidth="0" VerticalAlignment="Top">
                                                                            <Border.InputBindings>
                                                                                <MouseBinding Gesture="LeftClick"
                                                                                              Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                              CommandParameter="{Binding}" />
                                                                            </Border.InputBindings>
                                                                            <TextBlock Text="{Binding Title}" Style="{DynamicResource TreeNodeTitleText}" />
                                                                        </Border>
                                                                        <Button Grid.Column="2" Style="{DynamicResource TreePlusButton}"
                                                                                ToolTip="Category 추가"
                                                                                Command="{Binding DataContext.AddChildCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                                            <Image Source="{StaticResource AddRingIcon}" Width="14" Height="14"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Button>
                                                                        <Button Grid.Column="3" Style="{DynamicResource TreeRowIconButton}"
                                                                                Width="18" Height="18" VerticalAlignment="Top" ToolTip="Type 삭제"
                                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                                Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                                            <Image Source="{StaticResource RemoveDuotoneLineIcon}" Width="14" Height="14" />
                                                                        </Button>
                                                                    </Grid>
                                                        </Border>

                                                        <ItemsControl ItemsSource="{Binding Categories}"
                                                                      Margin="18,0,0,0"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <StackPanel>
                                                                        <!-- Category -->
                                                                        <Border Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}"
                                                                                Margin="0,1" Style="{DynamicResource TreeNodeBorder}">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Button Grid.Column="0" Style="{DynamicResource TreeToggleButton}"
                                                                                                Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                CommandParameter="{Binding}" ToolTip="Category">
                                                                                            <Image Source="{StaticResource ArchiveFillIcon}" Width="14" Height="14">
                                                                                                <Image.Style>
                                                                                                    <Style TargetType="Image">
                                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                                                <Setter Property="Opacity" Value="0.4" />
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Image.Style>
                                                                                            </Image>
                                                                                        </Button>
                                                                                        <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                                                                MinWidth="0" VerticalAlignment="Top">
                                                                                            <Border.InputBindings>
                                                                                                <MouseBinding Gesture="LeftClick"
                                                                                                              Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                              CommandParameter="{Binding}" />
                                                                                            </Border.InputBindings>
                                                                                            <TextBlock Text="{Binding Title}" Style="{DynamicResource TreeNodeTitleText}" />
                                                                                        </Border>
                                                                                        <Button Grid.Column="2" Style="{DynamicResource TreePlusButton}"
                                                                                                ToolTip="Project 추가"
                                                                                                Command="{Binding DataContext.AddChildCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                                                            <Image Source="{StaticResource AddRingIcon}" Width="14" Height="14"
                                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                        </Button>
                                                                                        <Button Grid.Column="3" Style="{DynamicResource TreeRowIconButton}"
                                                                                                Width="18" Height="18" VerticalAlignment="Top" ToolTip="Category 삭제"
                                                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                                                Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                                                            <Image Source="{StaticResource RemoveDuotoneLineIcon}" Width="14" Height="14" />
                                                                                        </Button>
                                                                                    </Grid>
                                                                        </Border>

                                                                        <ItemsControl ItemsSource="{Binding Projects}"
                                                                                      Margin="18,0,0,0"
                                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid>
                                                                                        <StackPanel>
                                                                                        <!-- Project -->
                                                                                        <Border Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}"
                                                                                                Margin="0,1" Style="{DynamicResource TreeNodeBorder}">
                                                                                                    <Grid>
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                            <ColumnDefinition Width="Auto" />
                                                                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                                                                            <ColumnDefinition Width="Auto" />
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <Button Grid.Column="0" Style="{DynamicResource TreeToggleButton}"
                                                                                                                Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                                CommandParameter="{Binding}" ToolTip="Project">
                                                                                                            <Image Source="{StaticResource FolderLineIcon}" Width="14" Height="14">
                                                                                                                <Image.Style>
                                                                                                                    <Style TargetType="Image">
                                                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                                                        <Style.Triggers>
                                                                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                                                                <Setter Property="Opacity" Value="0.4" />
                                                                                                                            </DataTrigger>
                                                                                                                        </Style.Triggers>
                                                                                                                    </Style>
                                                                                                                </Image.Style>
                                                                                                            </Image>
                                                                                                        </Button>
                                                                                                        <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                                                                                MinWidth="0" VerticalAlignment="Top">
                                                                                                            <Border.InputBindings>
                                                                                                                <MouseBinding Gesture="LeftClick"
                                                                                                                              Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                                              CommandParameter="{Binding}" />
                                                                                                            </Border.InputBindings>
                                                                                                            <TextBlock Text="{Binding Title}"
                                                                                                                       ToolTip="{Binding Title}"
                                                                                                                       Style="{DynamicResource TreeNodeTitleText}" />
                                                                                                        </Border>
                                                                                                        <Button Grid.Column="2" Style="{DynamicResource TreeRowIconButton}"
                                                                                                                Width="18" Height="18" VerticalAlignment="Top" ToolTip="Project 삭제"
                                                                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                                                                Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                                CommandParameter="{Binding}"
                                                                                                                Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                                                                            <Image Source="{StaticResource RemoveDuotoneLineIcon}" Width="14" Height="14" />
                                                                                                        </Button>
                                                                                                    </Grid>
                                                                                        </Border>

                                                                                        <ItemsControl ItemsSource="{Binding Sources}"
                                                                                                      Margin="18,0,0,0"
                                                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Border Margin="0,1">
                                                                                                        <Border.InputBindings>
                                                                                                            <MouseBinding Gesture="LeftClick"
                                                                                                                          Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                                          CommandParameter="{Binding}" />
                                                                                                        </Border.InputBindings>
                                                                                                            <Border Style="{DynamicResource TreeSourceRowBorder}">
                                                                                                                <Grid>
                                                                                                                    <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                                        <ColumnDefinition Width="*" MinWidth="0" />
                                                                                                                    </Grid.ColumnDefinitions>
                                                                                                                    <Border Grid.Column="0" Style="{DynamicResource TreeSourceSquareSlot}">
                                                                                                                        <Image Source="{StaticResource CodeLightIcon}"
                                                                                                                               Width="14" Height="14"
                                                                                                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                                                                    </Border>
                                                                                                                    <TextBlock Grid.Column="1"
                                                                                                                               Text="{Binding TreeTitle}"
                                                                                                                               FontSize="{StaticResource FontSize.Base}"
                                                                                                                               VerticalAlignment="Top"
                                                                                                                               TextTrimming="CharacterEllipsis"
                                                                                                                               TextWrapping="NoWrap"
                                                                                                                               ToolTip="{Binding OriginalPath}">
                                                                                                                        <TextBlock.Style>
                                                                                                                            <Style TargetType="TextBlock">
                                                                                                                                <Setter Property="Foreground" Value="#64748B" />
                                                                                                                                <Style.Triggers>
                                                                                                                                    <DataTrigger Binding="{Binding IsPlaceholderTitle}" Value="True">
                                                                                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                                                                                    </DataTrigger>
                                                                                                                                    <DataTrigger Binding="{Binding IsAppended}" Value="True">
                                                                                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                                                                    </DataTrigger>
                                                                                                                                </Style.Triggers>
                                                                                                                            </Style>
                                                                                                                        </TextBlock.Style>
                                                                                                                    </TextBlock>
                                                                                                                </Grid>
                                                                                                            </Border>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                        </StackPanel>
                                                                                        <Border Style="{DynamicResource TreeGuideVerticalNode}"
                                                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        </StackPanel>
                                                                        <Border Style="{DynamicResource TreeGuideVerticalNode}"
                                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        </StackPanel>
                                                        <Border Style="{DynamicResource TreeGuideVerticalType}"
                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>

                                        <!-- (comment trimmed) -->
                                        <Border Style="{DynamicResource TreeGuideVerticalMenu}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource EditSplitterBg}"
                          ShowsPreview="True" ResizeBehavior="PreviousAndNext" />

            <!-- Right pane -->
            <Grid Grid.Column="2" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- READ-ONLY detail -->
                <ScrollViewer x:Name="ReadFormScroll" Grid.Row="0" Padding="16"
                              Background="Transparent"
                              Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Width="{Binding ViewportWidth, ElementName=ReadFormScroll}">

                        <Border Style="{DynamicResource WorkLogDetailCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" MinWidth="0" ClipToBounds="True">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderTicketLine}"
                                                   FontSize="{StaticResource FontSize.Xxxl}" FontWeight="Bold" Foreground="#0F172A"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <WrapPanel VerticalAlignment="Center">
                                            <Border Style="{StaticResource WorkLogChipType}"
                                                    Visibility="{Binding HasDetailTypeChip, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DetailTypeChip}" Style="{StaticResource WorkLogChipTypeText}" />
                                            </Border>
                                            <Border Style="{StaticResource WorkLogChipCategory}"
                                                    Visibility="{Binding HasDetailCategoryChip, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DetailCategoryChip}" Style="{StaticResource WorkLogChipCategoryText}" />
                                            </Border>
                                            <Border Style="{StaticResource WorkLogChipDeploy}"
                                                    Visibility="{Binding HasDetailDeployChip, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DetailDeployChip}" Style="{StaticResource WorkLogChipDeployText}" />
                                            </Border>
                                        </WrapPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding HeaderCommentLine}" FontSize="{StaticResource FontSize.Base}" Foreground="#475569"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding HasHeaderComment, Converter={StaticResource BoolToVis}}" />
                                    <ToggleButton Style="{StaticResource CheckinMessageSwitch}"
                                                  IsChecked="{Binding ShowTfsOriginal, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  Visibility="{Binding HasChangeset, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Margin="0,0,0,14"
                                                Visibility="{Binding ShowTfsOriginal, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="{StaticResource FontSize.Base}" Foreground="#94A3B8">
                                            <Run Text="{Binding ChangesetDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding CheckedInDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding OriginalTfsComment}"
                                                   FontSize="{StaticResource FontSize.Base}" Foreground="#475569"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasOriginalTfsComment, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DetailPersonMeta}" FontSize="{StaticResource FontSize.Base}" Foreground="#64748B"
                                                   VerticalAlignment="Center" />
                                        <Border Width="1" Height="12" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DetailPeriodMeta}" FontSize="{StaticResource FontSize.Base}" Foreground="#64748B"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                            Panel.ZIndex="1">
                                    <Button Style="{DynamicResource WorkLogIconButton}" Padding="4" Width="28" Height="28"
                                            Margin="0,0,6,0" ToolTip="업무기록 삭제"
                                            Command="{Binding DeleteWorkLogCommand}"
                                            Visibility="{Binding ShowDeleteButton, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{StaticResource TrashDuotoneIcon}" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{DynamicResource WorkLogIconButton}" Padding="4" Width="28" Height="28"
                                            Margin="0" ToolTip="수정"
                                            Command="{Binding EnterEditModeCommand}"
                                            Visibility="{Binding ShowEnterEditButton, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{StaticResource EditFillIcon}" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border Style="{DynamicResource WorkLogInfoTile}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="#668EA4E8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="MENU" Style="{DynamicResource WorkLogInfoTileLabel}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailMenu}" Style="{DynamicResource WorkLogInfoTileValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource WorkLogInfoTile}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="#66F59E0B" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="PC" Style="{DynamicResource WorkLogInfoTileLabel}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailIp}" Style="{DynamicResource WorkLogInfoTileValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource WorkLogInfoTile}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="#6610B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Deployment" Style="{DynamicResource WorkLogInfoTileLabel}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailDeployDate}" Style="{DynamicResource WorkLogInfoTileValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource WorkLogInfoTile}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="#668B5CF6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="PROJECT" Style="{DynamicResource WorkLogInfoTileLabel}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailProject}" Style="{DynamicResource WorkLogInfoTileValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{DynamicResource WorkLogDetailCard}"
                                Visibility="{Binding HasCommentBlocks, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="COMMENT" Style="{StaticResource WorkLogDetailCardTitle}" Foreground="#1E40AF" />
                                <ItemsControl ItemsSource="{Binding CommentBlocks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" HorizontalAlignment="Center" Width="16">
                                                    <Rectangle Width="2" Fill="#BFDBFE" HorizontalAlignment="Center" />
                                                    <Ellipse Width="8" Height="8" Fill="#3B82F6"
                                                             VerticalAlignment="Top" Margin="0,4,0,0" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3"
                                                            HorizontalAlignment="Left" Margin="0,0,0,6"
                                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="{StaticResource FontSize.Sm}"
                                                                   FontWeight="SemiBold" Foreground="#1D4ED8" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Body}" FontSize="{StaticResource FontSize.Md}" Foreground="#334155"
                                                               TextWrapping="Wrap" LineHeight="20"
                                                               Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource WorkLogDetailCard}"
                                Visibility="{Binding HasDetailSources, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailSourceHeader}" Style="{StaticResource WorkLogDetailCardTitle}"
                                           Foreground="#1E40AF" />
                                <ItemsControl ItemsSource="{Binding DetailSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource WorkLogSourceRow}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource CodeLightIcon}"
                                                           Width="14" Height="14" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ChangeDetailText}" FontSize="{StaticResource FontSize.Base}"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding OriginalPath}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#334155" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAppended}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== EDIT: Menu / Work / Source pages ========== -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>

                        <!-- 이전: 좌측 중앙 (자리 고정, 숨길 때 Opacity만 0) -->
                        <Button Grid.Column="0"
                                Command="{Binding PrevStepCommand}"
                                ToolTip="이전"
                                Margin="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WorkLogStepNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPrevStepButton}" Value="False">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{StaticResource ExpandLeftIcon}" Width="22" Height="22" />
                        </Button>

                        <ScrollViewer x:Name="EditFormScroll" Grid.Column="1" Padding="8,16,8,28"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel MinWidth="0"
                                        HorizontalAlignment="Stretch"
                                        Width="{Binding ViewportWidth, ElementName=EditFormScroll}">

                            <!-- Ticket header: mirror detail card (right pane) -->
                            <Border Style="{DynamicResource WorkLogDetailCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" MinWidth="0" ClipToBounds="True">
                                        <!-- Ticket: TN- 고정 + 숫자칸 + 내부/미등록 커스텀 체크 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                            <Border Style="{DynamicResource EditHeaderField}" Padding="8,4" Margin="0,0,10,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="TN-" FontSize="{StaticResource FontSize.Xl}" FontWeight="Bold"
                                                               Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <Grid MinWidth="120" Width="168" Height="24">
                                                        <TextBox FontSize="{StaticResource FontSize.Lg}" FontWeight="SemiBold"
                                                                 Foreground="#0F172A" BorderThickness="0" Background="Transparent"
                                                                 Padding="0" VerticalContentAlignment="Center"
                                                                 FocusVisualStyle="{x:Null}"
                                                                 IsEnabled="{Binding IsTicketNumberMode}"
                                                                 Text="{Binding TicketNumberDigits, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Ticket Number" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Button Command="{Binding ToggleTicketInternalCommand}" ToolTip="내부">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource WorkLogGlassCheckButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTicketInternal}" Value="True">
                                                                    <Setter Property="Tag" Value="Checked" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock Text="내부" FontSize="{StaticResource FontSize.Md}" Foreground="#475569"
                                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding ToggleTicketUnregisteredCommand}" ToolTip="미등록">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource WorkLogGlassCheckButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTicketUnregistered}" Value="True">
                                                                    <Setter Property="Tag" Value="Checked" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock Text="미등록" FontSize="{StaticResource FontSize.Md}" Foreground="#475569"
                                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Ticket comment: TN과 동일 높이(한 줄) -->
                                        <TextBox Style="{DynamicResource WorkLogInput}"
                                                 MinHeight="28"
                                                 Tag="Ticket Comment를 입력하세요."
                                                 Text="{Binding TicketComment, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Ticket Comment" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                                Panel.ZIndex="1">
                                        <Button Style="{DynamicResource WorkLogIconButton}" Padding="4" Width="28" Height="28"
                                                Margin="0,0,6,0" ToolTip="업무기록 삭제"
                                                Command="{Binding DeleteWorkLogCommand}"
                                                Visibility="{Binding ShowDeleteButton, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{StaticResource TrashDuotoneIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{DynamicResource WorkLogIconButton}" Padding="4" Width="28" Height="28"
                                                Margin="0,0,6,0" ToolTip="임시저장"
                                                Command="{Binding SaveDraftCommand}"
                                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{StaticResource LoadListAltFillIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{DynamicResource WorkLogIconButton}" Padding="4" Width="28" Height="28"
                                                Margin="0" ToolTip="작성 완료"
                                                Command="{Binding SaveCommand}">
                                            <Image Source="{StaticResource SaveFillIcon}" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Menu page -->
                            <StackPanel MinWidth="0" HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsStepMenu, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Style="{DynamicResource WorkLogFieldTitle}" Margin="0">
                                            <Run Text="Site" /><Run Text=" *" Foreground="#DC2626" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding SiteFieldError}" Style="{DynamicResource WorkLogFieldError}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasSiteFieldError, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <ctrl:InlineOptionPicker ItemsSource="{Binding SiteOptions}"
                                                             SelectedItem="{Binding SiteCode, Mode=TwoWay}"
                                                             Placeholder="사이트 선택" />
                                </StackPanel>

                                <!-- Site 선택 시 바로 아래 PC -->
                                <StackPanel MinWidth="0" Margin="0,0,0,14"
                                            Visibility="{Binding HasSiteCode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="PC" Style="{DynamicResource WorkLogFieldTitle}" />
                                    <ctrl:InlineOptionPicker Margin="0,0,0,6"
                                                             ItemsSource="{Binding PcOptions}"
                                                             SelectedItem="{Binding ActiveMenu.Pc, Mode=TwoWay}"
                                                             IsEnabled="{Binding HasActiveMenu}"
                                                             Placeholder="PC 선택" />
                                    <TextBlock Text="이 사이트에 등록된 PC가 없습니다."
                                               FontSize="{StaticResource FontSize.Sm}" Foreground="#94A3B8"
                                               Visibility="{Binding ShowEmptyPcHint, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <StackPanel MinWidth="0" Visibility="{Binding HasActiveMenu, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Menu" Style="{DynamicResource WorkLogFieldTitle}" />
                                    <TextBox Style="{DynamicResource WorkLogInput}" Margin="0,0,0,14"
                                             AcceptsReturn="True" MinHeight="28"
                                             Tag="메뉴명을 입력하세요."
                                             Text="{Binding ActiveMenu.MenuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Style="{DynamicResource WorkLogFieldTitle}" Margin="0">
                                                <Run Text="Person in charge" /><Run Text=" *" Foreground="#DC2626" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding PersonInChargeFieldError}" Style="{DynamicResource WorkLogFieldError}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasPersonInChargeFieldError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <!-- 기본 좁게, 여러 명 입력 시 폭 증가 -->
                                        <Grid HorizontalAlignment="Left" MinWidth="168" MaxWidth="520">
                                            <TextBlock FontSize="{StaticResource FontSize.Base}"
                                                       Margin="10,0" Padding="0,0,20,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="Hidden">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ActiveMenu.PersonInCharge}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveMenu.PersonInCharge}" Value="">
                                                                <Setter Property="Text" Value="담당자를 입력하세요." />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActiveMenu.PersonInCharge}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="담당자를 입력하세요." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Style="{DynamicResource WorkLogInput}"
                                                     HorizontalAlignment="Stretch"
                                                     MinWidth="168"
                                                     Tag="담당자를 입력하세요."
                                                     Text="{Binding ActiveMenu.PersonInCharge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14"
                                                Visibility="{Binding ShowLocalPcIp, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Local PC IP" Style="{DynamicResource WorkLogFieldTitle}" />
                                        <TextBlock Text="{Binding LocalPcIp}" FontSize="{StaticResource FontSize.Md}" Foreground="#64748B"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Style="{DynamicResource WorkLogFieldTitle}" Margin="0">
                                                <Run Text="Period" /><Run Text=" *" Foreground="#DC2626" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding PeriodFieldError}" Style="{DynamicResource WorkLogFieldError}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasPeriodFieldError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Style="{DynamicResource WorkLogDateInput}"
                                                     Text="{Binding ActiveMenu.StartDateText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="~" FontSize="{StaticResource FontSize.Base}" Foreground="#64748B"
                                                       Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Style="{DynamicResource WorkLogDateInput}"
                                                     Text="{Binding ActiveMenu.EndDateText, UpdateSourceTrigger=PropertyChanged}" />
                                            <ctrl:DateRangePickerButton Margin="4,0,0,0"
                                                                        StartDate="{Binding ActiveMenu.StartDate, Mode=TwoWay}"
                                                                        EndDate="{Binding ActiveMenu.EndDate, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Work page: Type → Category → Name → Deploy → Date → Comment -->
                            <StackPanel x:Name="WorkFormStackPanel" MinWidth="0" HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsStepWork, Converter={StaticResource BoolToVis}}">
                                <StackPanel Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Style="{DynamicResource WorkLogFieldTitle}" Margin="0">
                                                <Run Text="Type" /><Run Text=" *" Foreground="#DC2626" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding TypeFieldError}" Style="{DynamicResource WorkLogFieldError}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasTypeFieldError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <ctrl:InlineOptionPicker ItemsSource="{Binding TypeOptions}"
                                                                 SelectedItem="{Binding ActiveProject.Type, Mode=TwoWay}"
                                                                 EmptyItemDisplay="미선택" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowWorkCategorySection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Category" Style="{DynamicResource WorkLogFieldTitle}" />
                                        <ctrl:InlineOptionPicker Margin="0,0,0,14"
                                                                 ItemsSource="{Binding FilteredCategories}"
                                                                 SelectedItem="{Binding ActiveProject.Category, Mode=TwoWay}"
                                                                 EmptyItemDisplay="미선택"
                                                                 SelectionCommitted="WorkCategoryPicker_SelectionCommitted" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowWorkProjectNameSection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Project Name" Style="{DynamicResource WorkLogFieldTitle}" />
                                        <TextBox Style="{DynamicResource WorkLogInput}" Margin="0,0,0,14"
                                                 Tag="프로젝트명을 입력하세요."
                                                 Text="{Binding ActiveProject.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowWorkDeployStatusSection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Deployment Status" Style="{DynamicResource WorkLogFieldTitle}" />
                                        <ctrl:InlineOptionPicker Margin="0,0,0,14"
                                                                 ItemsSource="{Binding DeploymentStatusOptions}"
                                                                 SelectedItem="{Binding ActiveProject.DeploymentStatus, Mode=TwoWay}"
                                                                 EmptyItemDisplay="미선택" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowWorkDeployDateSection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Deployment Date" Style="{DynamicResource WorkLogFieldTitle}" />
                                        <TextBox Style="{DynamicResource WorkLogDateInput}"
                                                 Margin="0,0,0,14"
                                                 Text="{Binding ActiveProject.DeploymentDateText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowWorkCommentSection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Comment" Style="{DynamicResource WorkLogFieldTitle}" />
                                        <TextBox Style="{DynamicResource WorkLogInput}" MinHeight="64" AcceptsReturn="True"
                                                 Tag="코멘트를 입력하세요."
                                                 Text="{Binding ActiveProject.Comment, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Source: Work 필드 아래 동일 페이지 -->
                                    <StackPanel Margin="0,18,0,0"
                                                Visibility="{Binding ShowSourceFormStack, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Style="{DynamicResource WorkLogFieldTitle}" Margin="0">
                                                <Run Text="Source" /><Run Text=" *" Foreground="#DC2626" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding SourceFieldError}" Style="{DynamicResource WorkLogFieldError}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasSourceFieldError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding ActiveProject.Sources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10"
                                                            MinWidth="0" HorizontalAlignment="Stretch">
                                                        <DockPanel LastChildFill="True" MinWidth="0">
                                                            <Image DockPanel.Dock="Left" Source="{StaticResource CodeLightIcon}"
                                                                   Width="14" Height="14" Margin="0,0,8,0"
                                                                   VerticalAlignment="Center" />
                                                            <Border DockPanel.Dock="Left" Background="#DBEAFE" CornerRadius="4"
                                                                    Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasTfsOrigin, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="TFS" FontSize="{StaticResource FontSize.Xs}" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                                            </Border>
                                                            <Button DockPanel.Dock="Right" Style="{DynamicResource WorkLogIconButton}"
                                                                    Margin="8,0,0,0" Width="22" Height="22" ToolTip="소스 제거"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Image Source="{StaticResource RemoveDuotoneLineIcon}" Width="14" Height="14" />
                                                            </Button>
                                                            <TextBox BorderThickness="0" Background="Transparent" Padding="0"
                                                                     FontSize="{StaticResource FontSize.Md}" Foreground="#1E293B"
                                                                     MinWidth="0" HorizontalAlignment="Stretch"
                                                                     TextWrapping="Wrap"
                                                                     HorizontalScrollBarVisibility="Disabled"
                                                                     Text="{Binding ChangeDetailText, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="{Binding OriginalPath}" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,12,0,0" HorizontalAlignment="Left"
                                                Padding="0" BorderThickness="0" Background="Transparent"
                                                Cursor="Hand" ToolTip="소스코드 추가"
                                                Command="{Binding AddSourceCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource AddRingIcon}" Width="20" Height="20" Margin="0,0,6,0" />
                                                <TextBlock Text="Source 추가" FontSize="{StaticResource FontSize.Base}"
                                                           Foreground="#2563EB" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <StackPanel Visibility="{Binding Tree.IsTypeSelected, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Style="{DynamicResource WorkLogFieldTitle}" Margin="0">
                                                <Run Text="Type" /><Run Text=" *" Foreground="#DC2626" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding TypeFieldError}" Style="{DynamicResource WorkLogFieldError}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasTypeFieldError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <ctrl:InlineOptionPicker ItemsSource="{Binding TypeOptions}"
                                                                 SelectedItem="{Binding Tree.SelectedTypeNode.Type, Mode=TwoWay}"
                                                                 EmptyItemDisplay="미선택" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding Tree.IsCategorySelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Category" Style="{DynamicResource WorkLogFieldTitle}" />
                                        <ctrl:InlineOptionPicker ItemsSource="{Binding FilteredCategories}"
                                                                 SelectedItem="{Binding Tree.SelectedCategoryNode.Category, Mode=TwoWay}"
                                                                 EmptyItemDisplay="미선택" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 다음: 우측 중앙 (자리 고정) -->
                        <Button Grid.Column="2"
                                Command="{Binding NextStepCommand}"
                                ToolTip="다음"
                                Margin="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WorkLogStepNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowNextStepButton}" Value="False">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{StaticResource ExpandRightIcon}" Width="22" Height="22" />
                        </Button>
                    </Grid>

                    <!-- 필드 없는 시스템 메시지만 (필드 검증은 해당 입력 아래) -->
                    <Border Grid.Row="1" Style="{DynamicResource EditFooterBar}"
                            Visibility="{Binding HasEditFooterMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#C2410C" FontSize="{StaticResource FontSize.Base}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
