<UserControl x:Class="GBCWorkHub.UI.Views.WorkLog.TfsCheckinInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogGlassStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogEditGlassOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Opacity" Value="0.85" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </Style>

            <Style x:Key="InboxCompactButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource WlGlassChipBg}" />
                <Setter Property="Foreground" Value="{StaticResource WlGlassChipText}" />
                <Setter Property="BorderBrush" Value="{StaticResource WlGlassChipBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassButtonHoverBg}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C5D0E0" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassRowSelectedBg}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InboxCompactAccentButton" TargetType="Button" BasedOn="{StaticResource InboxCompactButton}">
                <Setter Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
                <Setter Property="Foreground" Value="{StaticResource WlGlassDeployFocusFg}" />
                <Setter Property="BorderBrush" Value="#CCD6F5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassRowSelectedBg}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WlGlassAccent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C8D9FF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource WlGlassMuted}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassChipBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InboxScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource GlassScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource EditGlassFill}" />
                <Setter Property="BorderBrush" Value="#D9FFFFFF" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowInboxCloseButton}" Value="False">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="InboxListRow" Height="*" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True" Margin="0,0,0,8"
                       Visibility="{Binding ShowInboxCloseButton, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource GlassGhostButton}"
                        Content="닫기" Padding="10,4" FontSize="11" Margin="0"
                        Command="{Binding DataContext.CloseInboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding ShowInboxCloseButton, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="체크인 보관함" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,0"
                       Visibility="{Binding ShowInboxSiteTabs, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Command="{Binding Inbox.SetFilterCommand}" CommandParameter="waiting">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Inbox.IsFilterWaiting}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Run Text="대기" />
                            <Run Text=" " />
                            <Run Text="{Binding Inbox.SiteWaitingCount, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                    <Button Command="{Binding Inbox.SetFilterCommand}" CommandParameter="skipped">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Inbox.IsFilterSkipped}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Run Text="스킵" />
                            <Run Text=" " />
                            <Run Text="{Binding Inbox.SiteSkippedCount, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                    <Button Command="{Binding Inbox.SetFilterCommand}" CommandParameter="reported">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NotebookInnerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Inbox.IsFilterReported}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Run Text="작성 완료" />
                            <Run Text=" " />
                            <Run Text="{Binding Inbox.SiteReportedCount, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Inbox.Sites}"
                              HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NotebookTabButton}"
                                Command="{Binding DataContext.Inbox.SelectSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding SiteCode}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding SiteCode}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WlGlassMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Margin="5,0,0,0"
                                           Text="{Binding CountLabel}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WlGlassAccent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </DockPanel>

            <!-- 목록 + 우측 하단 고정 액션(공간 미할당, 내부 패딩 기준 overlay) -->
            <Border Grid.Row="2" Padding="8" VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource NotebookBodyBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowInboxSiteTabs}" Value="False">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="가져온 체크인이 없습니다."
                               Foreground="{StaticResource WlGlassMuted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding Inbox.HasRows, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ScrollViewer x:Name="InboxListScroll"
                                  Style="{StaticResource InboxScrollViewer}"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding Inbox.HasRows, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Inbox.Rows}"
                                      MinHeight="0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Padding="10,10,10,8" CornerRadius="8"
                                                MinHeight="96"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource WlGlassNoteCardBg}"
                                                BorderBrush="{StaticResource WlGlassNoteCardBorder}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Top">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource WlGlassAccent}"
                                                               Text="{Binding ChangesetId, StringFormat=CS {0}}" />
                                                    <TextBlock Text="{Binding Comment}" FontSize="12"
                                                               Foreground="{StaticResource WlGlassInk}"
                                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding PcName, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding AuthorName, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </ScrollViewer>

                    <!-- 내부 Padding(8) 기준 우측 하단 fixed — 행 높이 차지하지 않음 -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,0"
                            Padding="6"
                            CornerRadius="8"
                            Background="#E8F0F8FA"
                            BorderBrush="#C5D0E0"
                            BorderThickness="1"
                            Panel.ZIndex="20"
                            Visibility="{Binding Inbox.HasCheckedRows, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource InboxCompactButton}" Content="스킵" Margin="0"
                                    Command="{Binding Inbox.SkipCheckedCommand}"
                                    Visibility="{Binding Inbox.HasCheckedWaiting, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource InboxCompactButton}" Content="대기하기"
                                    Command="{Binding Inbox.WaitCheckedCommand}"
                                    Visibility="{Binding Inbox.HasCheckedSkipped, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource InboxCompactAccentButton}" Content="일지작성"
                                    Command="{Binding Inbox.WriteCheckedCommand}"
                                    Visibility="{Binding Inbox.HasCheckedWritable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
