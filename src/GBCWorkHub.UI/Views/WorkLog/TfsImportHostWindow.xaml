<Window x:Class="GBCWorkHub.UI.Views.WorkLog.TfsImportHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wl="clr-namespace:GBCWorkHub.UI.Views.WorkLog"
        Title="체크인 가져오기"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogGlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#990F172A">
        <Grid Margin="32,28">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent"
                    CornerRadius="14"
                    MinWidth="720"
                    MaxWidth="1200"
                    MinHeight="480"
                    MaxHeight="860"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="#3B5070" />
                </Border.Effect>
                <Border x:Name="CardBorder"
                        Style="{StaticResource GlassSurfaceStyle}"
                        Effect="{x:Null}"
                        Padding="0"
                        CornerRadius="14"
                        ClipToBounds="True"
                        SizeChanged="CardBorder_SizeChanged"
                        Loaded="CardBorder_SizeChanged">
                    <wl:TfsImportDialog Background="Transparent" />
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
