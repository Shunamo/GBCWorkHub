<UserControl x:Class="GBCWorkHub.UI.Views.WorkLog.WorkLogListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wl="clr-namespace:GBCWorkHub.UI.Views.WorkLog"
             Background="Transparent"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogGlassStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogEditGlassOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--
          Glass / Classic 전환:
          App.config → <add key="WorkLog.UseGlassmorphism" value="true|false" />
          또는 코드 → WorkLogUiOptions.UseGlassmorphism = false;
          앱 재시작 후 적용(UseGlassmorphism은 목록 VM 생성 시 읽힘).
        -->
        <Grid Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <wl:WorkLogListGlassView
                Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}}" />
            <wl:WorkLogListClassicView
                Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

            <!--
              TFS 가져오기: 업무상세와 같은 글래스 카드
            -->
            <Grid Panel.ZIndex="20"
                  Visibility="{Binding IsImportOpen, Converter={StaticResource BoolToVis}}"
                  Background="#660F172A"
                  MouseLeftButtonDown="ImportOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent"
                        CornerRadius="16"
                        Margin="24"
                        MouseLeftButtonDown="OverlayCard_MouseLeftButtonDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="MinWidth" Value="400" />
                            <Setter Property="MaxWidth" Value="520" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MaxHeight" Value="720" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImportDialog.HasCandidates}" Value="True">
                                    <Setter Property="Width" Value="860" />
                                    <Setter Property="MinWidth" Value="720" />
                                    <Setter Property="MaxWidth" Value="980" />
                                    <Setter Property="Height" Value="560" />
                                    <Setter Property="MinHeight" Value="420" />
                                    <Setter Property="MaxHeight" Value="720" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.16" Color="#2F4466" />
                    </Border.Effect>
                    <Border x:Name="ImportCardBorder"
                            CornerRadius="16"
                            ClipToBounds="True"
                            SizeChanged="ImportCardBorder_SizeChanged"
                            Loaded="ImportCardBorder_SizeChanged">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource EditGlassFill}" />
                                <Setter Property="BorderBrush" Value="#D9FFFFFF" />
                                <Setter Property="BorderThickness" Value="1.5" />
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="Effect" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImportDialog.HasCandidates}" Value="True">
                                        <Setter Property="Background" Value="#A6FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#F2FFFFFF" />
                                        <Setter Property="Padding" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <wl:TfsImportDialog Background="Transparent"
                                            DataContext="{Binding ImportDialog}" />
                    </Border>
                </Border>
            </Grid>

            <Grid Panel.ZIndex="21"
                  Visibility="{Binding IsInboxOpen, Converter={StaticResource BoolToVis}}"
                  Background="#660F172A"
                  MouseLeftButtonDown="InboxOverlay_MouseLeftButtonDown">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="800" MaxWidth="920" MinWidth="560"
                        Height="560" MaxHeight="680" Margin="24"
                        Background="Transparent"
                        MouseLeftButtonDown="OverlayCard_MouseLeftButtonDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.16" Color="#2F4466" />
                    </Border.Effect>
                    <wl:TfsCheckinInboxView />
                </Border>
            </Grid>
        </Grid>
        <Grid Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseGlassmorphism}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WlGlassAtmosphereBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Ellipse Width="520" Height="520" Fill="#338BB4E0"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-240,-180,0" IsHitTestVisible="False"
                     Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}}">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" Fill="#288FBFB8"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-180" IsHitTestVisible="False"
                     Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}}">
                <Ellipse.Effect>
                    <BlurEffect Radius="80" />
                </Ellipse.Effect>
            </Ellipse>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseGlassmorphism}" Value="True">
                                <Setter Property="Margin" Value="12,52,12,12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <wl:WorkLogEditDialog DataContext="{Binding EditDialog}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
