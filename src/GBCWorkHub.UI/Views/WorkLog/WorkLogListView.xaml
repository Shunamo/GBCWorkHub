<UserControl x:Class="GBCWorkHub.UI.Views.WorkLog.WorkLogListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wl="clr-namespace:GBCWorkHub.UI.Views.WorkLog"
             Background="Transparent"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogGlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--
          Glass / Classic 전환:
          App.config → <add key="WorkLog.UseGlassmorphism" value="true|false" />
          또는 코드 → WorkLogUiOptions.UseGlassmorphism = false;
          앱 재시작 후 적용(UseGlassmorphism은 목록 VM 생성 시 읽힘).
        -->
        <Grid Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <wl:WorkLogListGlassView
                Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}}" />
            <wl:WorkLogListClassicView
                Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

            <!--
              TFS 가져오기: PopupHost와 같은 딤 + 중앙 글래스 카드
            -->
            <Grid Panel.ZIndex="20"
                  Visibility="{Binding IsImportOpen, Converter={StaticResource BoolToVis}}"
                  Background="#990F172A">
                <!-- 여백 안쪽에서만 크기 잡음 → 창모드에서도 라운드가 잘리지 않음 -->
                <Grid Margin="32,28">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent"
                            CornerRadius="14"
                            MinWidth="720"
                            MaxWidth="1200"
                            MinHeight="480"
                            MaxHeight="860"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="#3B5070" />
                        </Border.Effect>
                        <Border x:Name="ImportCardBorder"
                                Style="{StaticResource GlassSurfaceStyle}"
                                Effect="{x:Null}"
                                Padding="0"
                                CornerRadius="14"
                                ClipToBounds="True"
                                SizeChanged="ImportCardBorder_SizeChanged"
                                Loaded="ImportCardBorder_SizeChanged">
                            <wl:TfsImportDialog Background="Transparent"
                                                DataContext="{Binding ImportDialog}" />
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 상세: Glass면 목록과 같은 atmosphere(전체) + 앱 헤더 아래 콘텐츠 여백 -->
        <Grid Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseGlassmorphism}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WlGlassAtmosphereBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Ellipse Width="520" Height="520" Fill="#338BB4E0"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-240,-180,0" IsHitTestVisible="False"
                     Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}}">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" Fill="#288FBFB8"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-180" IsHitTestVisible="False"
                     Visibility="{Binding UseGlassmorphism, Converter={StaticResource BoolToVis}}">
                <Ellipse.Effect>
                    <BlurEffect Radius="80" />
                </Ellipse.Effect>
            </Ellipse>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseGlassmorphism}" Value="True">
                                <Setter Property="Margin" Value="12,52,12,12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <wl:WorkLogEditDialog DataContext="{Binding EditDialog}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
