<UserControl x:Class="GBCWorkHub.UI.Views.WorkLog.WorkLogListClassicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls"
             Background="#FFFFFF">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ListSidebarLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200" MaxWidth="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 좌측 필터 사이드바 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14,16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource WorkLogGhostButton}"
                                    Content="초기화" Padding="8,4" FontSize="11"
                                    Command="{Binding ResetFiltersCommand}" VerticalAlignment="Center" />
                            <TextBlock Text="필터" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1E293B" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,14,14,16">
                        <StackPanel>
                            <TextBlock Text="사이트" Style="{StaticResource ListSidebarLabel}" />
                            <ctrl:CustomDropdown Margin="0,0,0,16" Height="32"
                                                 ItemsSource="{Binding SiteFilterOptions}"
                                                 SelectedItem="{Binding FilterSite, Mode=TwoWay}"
                                                 Placeholder="사이트" />

                            <TextBlock Text="담당자" Style="{StaticResource ListSidebarLabel}" />
                            <ctrl:CustomDropdown Margin="0,0,0,16" Height="32"
                                                 ItemsSource="{Binding PersonOptions}"
                                                 SelectedItem="{Binding FilterPerson, Mode=TwoWay}"
                                                 Placeholder="담당자"
                                                 EmptyText="선택 가능한 담당자 정보가 없습니다." />

                            <TextBlock Text="소속" Style="{StaticResource ListSidebarLabel}" />
                            <ctrl:CustomDropdown Margin="0,0,0,16" Height="32"
                                                 ItemsSource="{Binding TeamFilterOptions}"
                                                 SelectedItem="{Binding FilterTeam, Mode=TwoWay}"
                                                 Placeholder="소속"
                                                 EmptyText="등록된 소속이 없습니다." />

                            <TextBlock Text="PC" Style="{StaticResource ListSidebarLabel}" />
                            <ctrl:CustomDropdown Margin="0,0,0,16" Height="32"
                                                 ItemsSource="{Binding PcOptions}"
                                                 SelectedItem="{Binding FilterPc, Mode=TwoWay}"
                                                 Placeholder="PC"
                                                 EmptyText="등록된 원격 PC가 없습니다." />

                            <TextBlock Text="Type" Style="{StaticResource ListSidebarLabel}" />
                            <ctrl:CustomDropdown Margin="0,0,0,16" Height="32"
                                                 ItemsSource="{Binding TypeFilterOptions}"
                                                 SelectedItem="{Binding FilterType, Mode=TwoWay}"
                                                 Placeholder="Type" />

                            <TextBlock Text="기간" Style="{StaticResource ListSidebarLabel}" />
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="8" Padding="8,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="시작일" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <Grid MinHeight="28" Margin="0,0,0,10">
                                        <TextBlock Text="0000-00-00" FontSize="12" Foreground="#CBD5E1"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilterFromText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FilterFromText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding FilterFromText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="6,0"
                                                 FontSize="12" VerticalContentAlignment="Center"
                                                 ToolTip="시작일 yyyy-MM-dd" />
                                    </Grid>
                                    <TextBlock Text="종료일" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <Grid MinHeight="28">
                                        <TextBlock Text="0000-00-00" FontSize="12" Foreground="#CBD5E1"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilterToText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FilterToText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding FilterToText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="6,0"
                                                 FontSize="12" VerticalContentAlignment="Center"
                                                 ToolTip="종료일 yyyy-MM-dd" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 우측 목록 영역 -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource WorkLogPrimaryButton}" Margin="0,0,6,0" Padding="10,5" FontSize="12"
                                    Content="{Binding ImportButtonLabel}"
                                    Command="{Binding OpenImportCommand}" />
                            <Button Style="{StaticResource WorkLogGhostButton}" Content="Excel 가져오기"
                                    Margin="0,0,6,0" Padding="10,5" FontSize="12" Command="{Binding ImportCsvCommand}" />
                            <Button Style="{StaticResource WorkLogGhostButton}" Content="새 업무기록"
                                    Padding="10,5" FontSize="12" Command="{Binding NewWorkLogCommand}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="240" Height="28" Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBlock Text="티켓/내용 검색" FontSize="12" Foreground="#94A3B8" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="8,0,4,0"
                                                 FontSize="12" VerticalContentAlignment="Center"
                                                 VerticalAlignment="Stretch" />
                                    </Grid>
                                    <Image Grid.Column="1" Source="{StaticResource SearchLightIcon}"
                                           Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Background="#FFFFFF">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="업무기록이 없습니다." FontSize="14" FontWeight="SemiBold"
                                   Foreground="#475569" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource WorkLogPrimaryButton}" Content="TFS 가져오기" Margin="0,14,0,0"
                                HorizontalAlignment="Center" Command="{Binding OpenImportCommand}" />
                    </StackPanel>

                    <StackPanel Margin="16,12"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14,12" Margin="0,0,0,8" MinHeight="72">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="120" Height="14" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="240" Height="11" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14,12" Margin="0,0,0,8" MinHeight="72">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="100" Height="14" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="200" Height="11" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14,12" Margin="0,0,0,8" MinHeight="72">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="140" Height="14" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="220" Height="11" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14,12" Margin="0,0,0,8" MinHeight="72">
                            <StackPanel>
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="110" Height="14" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonBoneStyle}" Width="260" Height="11" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12" Background="#FFFFFF"
                                  Visibility="{Binding ShowListContent, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding DateGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding DateHeader}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1E293B" Margin="4,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CommitRowBorder}" Padding="14,12" Margin="0,0,0,6"
                                                            Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick"
                                                                          Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding TicketNumberText}" FontSize="16"
                                                                           FontWeight="SemiBold" Foreground="#2563EB"
                                                                           Visibility="{Binding HasTicket, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="티켓 미확인" FontSize="15"
                                                                           FontWeight="SemiBold" Foreground="#94A3B8"
                                                                           Visibility="{Binding HasTicket, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                                <TextBlock Text="{Binding ContentsDisplay}" FontSize="13"
                                                                           Foreground="#334155" Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="800"
                                                                           HorizontalAlignment="Left"
                                                                           LineHeight="19"
                                                                           ToolTip="{Binding ContentsTooltip}" />
                                                                <TextBlock Text="{Binding ListRowMetaLine}" Margin="0,6,0,0"
                                                                           FontSize="12" Foreground="#64748B"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding WorkCommentDisplay}"
                                                                       FontSize="12" Foreground="#4338CA"
                                                                       TextWrapping="NoWrap"
                                                                       TextAlignment="Right"
                                                                       HorizontalAlignment="Right"
                                                                       MaxWidth="520"
                                                                       VerticalAlignment="Top"
                                                                       LineHeight="18"
                                                                       Visibility="{Binding HasWorkComment, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,12,0,16" VerticalAlignment="Bottom"
                            Visibility="{Binding ShowPagination, Converter={StaticResource BoolToVis}}">
                    <Button Width="32" Height="28" Padding="0" Margin="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding PrevPageCommand}" ToolTip="이전">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="{StaticResource ExpandLeftIcon}" Width="10" Height="10" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="0" Padding="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayText}"
                                        MinWidth="32" Height="32" Margin="0" Padding="0"
                                        FontSize="14" FontWeight="Normal" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#1E293B"
                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding PageNumber}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="#3B82F6" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Width="32" Height="28" Padding="0" Margin="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding NextPageCommand}" ToolTip="다음">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="{StaticResource ExpandRightIcon}" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
    </Grid>
</UserControl>
