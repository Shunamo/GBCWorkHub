<UserControl x:Class="GBCWorkHub.UI.Views.WorkLog.TfsImportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogGlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

                        <Style x:Key="ImportModeChip" TargetType="Button" BasedOn="{StaticResource GlassGhostButton}">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="MinHeight" Value="26" />
            </Style>

            <Style x:Key="GlassImportPanel" TargetType="Border">
                <Setter Property="Background" Value="#B8FFFFFF" />
                <Setter Property="BorderBrush" Value="#E6FFFFFF" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="ClipToBounds" Value="True" />
            </Style>

            <Style x:Key="GlassImportFileRow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource WlGlassRowBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- 전역 Hidden 가로 스크롤 때문에 Comment 줄바꿈이 막히므로 이 팝업만 재정의 -->
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource GlassScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="CanContentScroll" Value="False" />
            </Style>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />

            <Style x:Key="DoneCheckBox" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="#F5FFFFFF" BorderBrush="#C5D0E0" BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Image x:Name="Mark" Source="{StaticResource DoneLightIcon}"
                                       Width="12" Height="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#8EA4E8" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WlGlassAccent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,10,16,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                CornerRadius="14,14,0,0"
                Background="#B8FFFFFF">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="TFS 체크인 가져오기"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource WlGlassInk}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{StaticResource WlGlassAccent}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="각각 따로"
                            Command="{Binding SetImportModeCommand}" CommandParameter="Separate">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparateMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
                                        <Setter Property="BorderBrush" Value="#A8C0F0" />
                                        <Setter Property="Foreground" Value="{StaticResource WlGlassDeployFocusFg}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="전부 합치기"
                            Command="{Binding SetImportModeCommand}" CommandParameter="MergeAll">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMergeAllMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
                                        <Setter Property="BorderBrush" Value="#A8C0F0" />
                                        <Setter Property="Foreground" Value="{StaticResource WlGlassDeployFocusFg}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="그룹으로 합치기"
                            Command="{Binding SetImportModeCommand}" CommandParameter="CustomGroups"
                            Visibility="{Binding ShowCustomGroupsTab, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomGroupsMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
                                        <Setter Property="BorderBrush" Value="#A8C0F0" />
                                        <Setter Property="Foreground" Value="{StaticResource WlGlassDeployFocusFg}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="기존 기록과 병합"
                            Command="{Binding SetImportModeCommand}" CommandParameter="AppendExisting"
                            Visibility="{Binding HasAppendTargets, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppendExistingMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WlGlassDeployDoneBg}" />
                                        <Setter Property="BorderBrush" Value="#C5E4D5" />
                                        <Setter Property="Foreground" Value="{StaticResource WlGlassDeployDoneFg}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding ShowAppendTargetPicker, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SelectedAppendTargetSummary}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource WlGlassDeployDoneFg}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                               Visibility="{Binding HasSelectedAppendTarget, Converter={StaticResource BoolToVis}}" />

                    <!-- WorkLogListGlassView 검색바와 동일 -->
                    <Border Height="32" Background="#CCFFFFFF" BorderBrush="#BFFFFFFF"
                            BorderThickness="1" CornerRadius="16"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBlock Text="티켓·메뉴·프로젝트·소스·코멘트 검색" FontSize="{StaticResource FontSize.Base}" Foreground="#94A3B8"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AppendSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AppendSearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding AppendSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         Padding="12,0,4,0" FontSize="{StaticResource FontSize.Base}"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                            <Image Grid.Column="1" Source="{StaticResource SearchLightIcon}"
                                   Width="14" Height="14" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Opacity="0.65"
                                   IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GlassImportPanel}" MaxHeight="120" Padding="4,2" Margin="0,6,0,0"
                            Visibility="{Binding ShowAppendTargetList, Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding FilteredAppendTargets}"
                                 SelectedItem="{Binding SelectedAppendTarget}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Padding="8,5" CornerRadius="8"
                                                        Background="{StaticResource WlGlassRowBg}"
                                                        BorderBrush="{StaticResource WlGlassRowBorder}"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassRowHoverBg}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WlGlassRowHoverBorder}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassDeployDoneBg}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#C5E4D5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WlGlassInk}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailLabel}" FontSize="11"
                                                   Foreground="{StaticResource WlGlassMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14,10,14,10" MinHeight="0" ClipToBounds="True" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="0" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: candidates -->
            <Border Grid.Column="0" Style="{StaticResource GlassImportPanel}"
                    MinWidth="0">
                <Grid MinWidth="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="수신된 체크인" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassInk}"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GlassGhostButton}" Content="전체 선택"
                                    Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                    Command="{Binding SelectAllCommand}" />
                            <Button Style="{StaticResource GlassGhostButton}" Content="선택 해제"
                                    Padding="10,4" FontSize="11" Margin="0"
                                    Command="{Binding ClearSelectionCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Text="가져온 TFS 체크인 내역이 없습니다."
                               Foreground="{StaticResource WlGlassMuted}" FontSize="13"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer Grid.Row="1" Padding="8,0,8,8"
                                  Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MinWidth="0">
                        <ItemsControl ItemsSource="{Binding Candidates}"
                                      MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="10" Cursor="Hand"
                                            BorderThickness="1" HorizontalAlignment="Stretch" MinWidth="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WlGlassRowBg}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowBorder}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WlGlassRowHoverBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowHoverBorder}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WlGlassRowSelectedBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowSelectedBorder}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.FocusCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid HorizontalAlignment="Stretch" MinWidth="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource DoneCheckBox}"
                                                      IsChecked="{Binding IsImportSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Top" Margin="0,2,10,0" />
                                            <Grid Grid.Column="1" MinWidth="0">
                                                <StackPanel MinWidth="0" Margin="0,0,28,0">
                                                    <TextBlock Text="{Binding ChangesetId, StringFormat=CS {0}}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource WlGlassAccent}" />
                                                    <TextBlock Text="{Binding AuthorDisplay}" FontSize="12"
                                                               Foreground="{StaticResource WlGlassMuted}" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CheckedInAtDisplay}" FontSize="11"
                                                               Foreground="#94A3B8" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding OriginalComment}" FontSize="12"
                                                               Foreground="{StaticResource WlGlassInk}" Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               MinWidth="0"
                                                               HorizontalAlignment="Stretch" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource WlGlassMuted}"
                                                               Margin="0,6,0,0"
                                                               Text="{Binding FileCountSummary}" />
                                                </StackPanel>
                                                <Button Width="22" Height="22" Padding="0" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.CycleMergeGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsCustomGroupsMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="그룹">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Width="22" Height="22" CornerRadius="6"
                                                                    Background="{Binding MergeGroupBackground}">
                                                                <TextBlock Text="{Binding MergeGroupLabel}"
                                                                           FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding MergeGroupForegroundBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: files -->
            <Border Grid.Column="2" Style="{StaticResource GlassImportPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="12,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="변경 파일" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassInk}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Style="{StaticResource GlassChipStyle}" Margin="0,0,6,0"
                                    Visibility="{Binding HasFocusedHiddenFiles, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource GlassChipTextStyle}"
                                           Foreground="#94A3B8"
                                           Text="{Binding FocusedHiddenFilesLabel}" />
                            </Border>
                            <Border Style="{StaticResource GlassChipStyle}">
                                <TextBlock Style="{StaticResource GlassChipTextStyle}"
                                           Text="{Binding FocusedFileCount, StringFormat=전체 {0}}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="체크인을 선택하면 변경 파일이 표시됩니다."
                               Foreground="{StaticResource WlGlassMuted}" FontSize="13"
                               Visibility="{Binding HasFocus, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding ShowFocusedFilesEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="이 체크인의 변경 파일 목록이 없습니다." FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="페이로드 files 배열이 비어 있거나 필드명이 다릅니다."
                                   FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,10"
                                  Visibility="{Binding HasFocusedFiles, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="흐린 항목은 숨김(메타/비후보)입니다. 클릭하면 포함됩니다."
                                       FontSize="11" Foreground="#94A3B8" Margin="4,0,4,8"
                                       Visibility="{Binding HasFocusedHiddenFiles, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding FocusedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand"
                                                Command="{Binding DataContext.ToggleFileIncludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding IncludeHint}"
                                                Margin="0,0,0,4"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Style="{StaticResource GlassImportFileRow}"
                                                            Opacity="{Binding RowOpacity}"
                                                            ToolTip="{Binding ServerPath}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Top"
                                                                    ToolTip="{Binding ChangeTypeMark}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource WlGlassDeployDoneBg}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                                                                <Setter Property="Background" Value="#F8EAEA" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource WlGlassChipBg}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Image Source="{StaticResource CodeLightIcon}" Width="14" Height="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="#94A3B8"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                                               Text="숨김"
                                                                               Visibility="{Binding IsDimmed, Converter={StaticResource BoolToVis}}" />
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource WlGlassInk}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding ServerPath}" FontSize="11" Foreground="#94A3B8"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding ChangeType}" FontSize="11"
                                                                           Foreground="{StaticResource WlGlassMuted}"
                                                                           Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="14,10,16,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                CornerRadius="0,0,14,14"
                Background="#B8FFFFFF">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource WlGlassMuted}"
                           Text="{Binding SelectedCount, StringFormat={}{0}건 선택됨}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GlassGhostButton}" Content="취소"
                            Command="{Binding CloseCommand}" />
                    <Button Style="{StaticResource GlassAccentButton}"
                            Content="{Binding ConfirmButtonLabel}"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
