<UserControl x:Class="GBCWorkHub.UI.Views.WorkLog.TfsImportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogGlassStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogEditGlassOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="PickerDateField" TargetType="Border" BasedOn="{StaticResource EditHeaderField}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="PickerDateInput" TargetType="TextBox">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
                <Setter Property="CaretBrush" Value="{StaticResource WlGlassAccent}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <Style x:Key="SessionPcChip" TargetType="Button">
                <Setter Property="Background" Value="#E5E7EB" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D1D5DB" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ImportModeChip" TargetType="Button">
                <Setter Property="Background" Value="#E5E7EB" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D1D5DB" />
                                </Trigger>
                                <Trigger Property="Tag" Value="On">
                                    <Setter TargetName="Bd" Property="Background" Value="#4F67D8" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#405CC3" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="Tag" Value="On" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#405CC3" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassImportPanel" TargetType="Border">
                <Setter Property="Background" Value="#B8FFFFFF" />
                <Setter Property="BorderBrush" Value="#E6FFFFFF" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="ClipToBounds" Value="True" />
            </Style>

            <Style x:Key="GlassImportFileRow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource WlGlassRowBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- 전역 Hidden 가로 스크롤 때문에 Comment 줄바꿈이 막히므로 이 팝업만 재정의 -->
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource GlassScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="CanContentScroll" Value="False" />
            </Style>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />

            <Style x:Key="DoneCheckBox" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="#F5FFFFFF" BorderBrush="#C5D0E0" BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Image x:Name="Mark" Source="{StaticResource DoneLightIcon}"
                                       Width="12" Height="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#8EA4E8" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource WlGlassDeployFocusBg}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WlGlassAccent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ImportBodyRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,10,16,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                CornerRadius="14,14,0,0"
                Background="#B8FFFFFF"
                Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource WlGlassInk}"
                               VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="TFS 가져오기" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCandidates}" Value="True">
                                        <Setter Property="Text" Value="TFS 체크인 가져오기" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{StaticResource WlGlassAccent}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                            Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                    <Button Content="Each"
                            Command="{Binding SetImportModeCommand}" CommandParameter="Separate">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparateMode}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                        <Setter Property="Background" Value="#4F67D8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#405CC3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Whole"
                            Command="{Binding SetImportModeCommand}" CommandParameter="MergeAll">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMergeAllMode}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                        <Setter Property="Background" Value="#4F67D8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#405CC3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Group"
                            Command="{Binding SetImportModeCommand}" CommandParameter="CustomGroups"
                            Visibility="{Binding ShowCustomGroupsTab, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomGroupsMode}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                        <Setter Property="Background" Value="#4F67D8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#405CC3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Existing"
                            Command="{Binding SetImportModeCommand}" CommandParameter="AppendExisting"
                            Visibility="{Binding HasAppendTargets, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ImportModeChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppendExistingMode}" Value="True">
                                        <Setter Property="Tag" Value="On" />
                                        <Setter Property="Background" Value="#4F67D8" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#405CC3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding ShowAppendTargetPicker, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SelectedAppendTargetSummary}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource WlGlassAccent}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                               Visibility="{Binding HasSelectedAppendTarget, Converter={StaticResource BoolToVis}}" />

                    <!-- WorkLogListGlassView 검색바와 동일 -->
                    <Border Height="32" Background="#CCFFFFFF" BorderBrush="#BFFFFFFF"
                            BorderThickness="1" CornerRadius="16"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBlock Text="티켓·이름·메뉴·프로젝트·소스·코멘트 검색" FontSize="{StaticResource FontSize.Base}" Foreground="#94A3B8"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AppendSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AppendSearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding AppendSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         Padding="12,0,4,0" FontSize="{StaticResource FontSize.Base}"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                            <Image Grid.Column="1" Source="{StaticResource SearchLightIcon}"
                                   Width="14" Height="14" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Opacity="0.65"
                                   IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GlassImportPanel}" MaxHeight="120" Padding="4,2" Margin="0,6,0,0"
                            Visibility="{Binding ShowAppendTargetList, Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding FilteredAppendTargets}"
                                 SelectedItem="{Binding SelectedAppendTarget}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Padding="8,5" CornerRadius="8"
                                                        Background="{StaticResource WlGlassRowBg}"
                                                        BorderBrush="{StaticResource WlGlassRowBorder}"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassRowHoverBg}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WlGlassRowHoverBorder}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource WlGlassRowSelectedBg}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WlGlassRowSelectedBorder}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WlGlassInk}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetailLabel}" FontSize="11"
                                                   Foreground="{StaticResource WlGlassMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0" LastChildFill="True"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource GlassGhostButton}" Content="취소" MinWidth="88"
                        Command="{Binding CloseCommand}" />
                <Button Style="{StaticResource GlassAccentButton}" Content="가져오기" MinWidth="88" Margin="0"
                        Command="{Binding FetchSessionQueryCommand}"
                        IsEnabled="{Binding CanFetchSessionQuery}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          MaxHeight="480"
                          Padding="0,0,8,0">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="CanContentScroll" Value="False" />
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="TFS 가져오기" FontSize="{StaticResource FontSize.Xl}" FontWeight="SemiBold"
                               Foreground="{StaticResource WlGlassInk}" Margin="0,0,0,16" />

                    <TextBlock Text="Site" Style="{StaticResource WorkLogFieldTitle}" />
                    <ctrl:InlineOptionPicker ItemsSource="{Binding SessionSiteOptions}"
                                             SelectedItem="{Binding SessionSite, Mode=TwoWay}"
                                             UsePopupChips="True"
                                             Placeholder="사이트" />

                    <TextBlock Text="날짜 · 시간" Style="{StaticResource WorkLogFieldTitle}" Margin="0,8,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PickerDateField}" Width="128">
                            <Grid>
                                <TextBlock Text="0000-00-00" FontSize="{StaticResource FontSize.Md}"
                                           Foreground="{StaticResource WlGlassMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SessionDateText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionDateText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource PickerDateInput}"
                                         Text="{Binding SessionDateText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PickerDateField}" Width="68">
                            <Grid>
                                <TextBlock Text="00:00" FontSize="{StaticResource FontSize.Md}"
                                           Foreground="{StaticResource WlGlassMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SessionStartTimeText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionStartTimeText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource PickerDateInput}"
                                         Text="{Binding SessionStartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="5" />
                            </Grid>
                        </Border>
                        <TextBlock Text="~" FontSize="{StaticResource FontSize.Md}" Foreground="{StaticResource WlGlassMuted}"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource PickerDateField}" Width="68" Margin="0">
                            <Grid>
                                <TextBlock Text="00:00" FontSize="{StaticResource FontSize.Md}"
                                           Foreground="{StaticResource WlGlassMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SessionEndTimeText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionEndTimeText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource PickerDateInput}"
                                         Text="{Binding SessionEndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="5" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="PC" Style="{StaticResource WorkLogFieldTitle}" Margin="0,12,0,8" />
                    <ItemsControl ItemsSource="{Binding SessionPcGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource WlGlassMuted}"
                                               Margin="0,0,0,6"
                                               Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Computers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SessionPcChip}"
                                                        Command="{Binding DataContext.SelectSessionPcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Value}"
                                                        Content="{Binding Value}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding SessionSearchMessage}" Style="{StaticResource WorkLogFieldError}"
                               Visibility="{Binding HasSessionSearchMessage, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Row="1" Margin="14,10,14,10" MinHeight="0" ClipToBounds="True" Background="Transparent"
              Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: 이력만 / 체크인 목록 -->
            <Border Grid.Column="0" MinWidth="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassImportPanel}">
                        <Setter Property="Grid.ColumnSpan" Value="3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCandidates}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid MinWidth="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,10" LastChildFill="False"
                               Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Left" Text="수신된 체크인" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassInk}"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GlassGhostButton}" Content="전체 선택"
                                    Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                    Command="{Binding SelectAllCommand}" />
                            <Button Style="{StaticResource GlassGhostButton}" Content="선택 해제"
                                    Padding="10,4" FontSize="11" Margin="0"
                                    Command="{Binding ClearSelectionCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" MinWidth="0"
                          Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer Padding="8,0,8,8"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MinWidth="0">
                        <ItemsControl ItemsSource="{Binding Candidates}"
                                      MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="10" Cursor="Hand"
                                            BorderThickness="1" HorizontalAlignment="Stretch" MinWidth="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WlGlassRowBg}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowBorder}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WlGlassRowHoverBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowHoverBorder}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WlGlassRowSelectedBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowSelectedBorder}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.FocusCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid HorizontalAlignment="Stretch" MinWidth="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource DoneCheckBox}"
                                                      IsChecked="{Binding IsImportSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Top" Margin="0,2,10,0" />
                                            <Grid Grid.Column="1" MinWidth="0">
                                                <StackPanel MinWidth="0" Margin="0,0,28,0"
                                                            HorizontalAlignment="Stretch">
                                                    <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Text="{Binding InboxStatusLabel}"
                                                               Visibility="{Binding HasInboxStatus, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding InboxStatusLabel}" Value="완료">
                                                                        <Setter Property="Foreground" Value="#246B4D" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding InboxStatusLabel}" Value="대기">
                                                                        <Setter Property="Foreground" Value="#405CC3" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding InboxStatusLabel}" Value="스킵">
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ChangesetId, StringFormat=CS {0}}"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Left" HorizontalAlignment="Left">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource WlGlassMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsImportSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource WlGlassAccent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding AuthorDisplay}" FontSize="12"
                                                               Foreground="{StaticResource WlGlassMuted}" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Left" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding CheckedInAtDisplay}" FontSize="11"
                                                               Foreground="#94A3B8" Margin="0,2,0,0"
                                                               TextAlignment="Left" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding OriginalComment}" FontSize="12"
                                                               Foreground="{StaticResource WlGlassInk}" Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Left"
                                                               MinWidth="0"
                                                               HorizontalAlignment="Stretch" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{StaticResource WlGlassMuted}"
                                                               Margin="0,6,0,0"
                                                               TextAlignment="Left" HorizontalAlignment="Left"
                                                               Text="{Binding FileCountSummary}" />
                                                </StackPanel>
                                                <Button Width="22" Height="22" Padding="0" Cursor="Hand"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.CycleMergeGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsCustomGroupsMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Group">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Width="22" Height="22" CornerRadius="6"
                                                                    Background="{Binding MergeGroupBackground}">
                                                                <TextBlock Text="{Binding MergeGroupLabel}"
                                                                           FontSize="11" FontWeight="Bold"
                                                                           Foreground="{Binding MergeGroupForegroundBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="14"
                    Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />

            <!-- Right: files -->
            <Border Grid.Column="2" Style="{StaticResource GlassImportPanel}"
                    Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="12,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="변경 파일" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassInk}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Style="{StaticResource GlassChipStyle}" Margin="0,0,6,0"
                                    Visibility="{Binding HasFocusedHiddenFiles, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource GlassChipTextStyle}"
                                           Foreground="#94A3B8"
                                           Text="{Binding FocusedHiddenFilesLabel}" />
                            </Border>
                            <Border Style="{StaticResource GlassChipStyle}">
                                <TextBlock Style="{StaticResource GlassChipTextStyle}"
                                           Text="{Binding FocusedFileCount, StringFormat=전체 {0}}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="체크인을 선택하면 변경 파일이 표시됩니다."
                               Foreground="{StaticResource WlGlassMuted}" FontSize="13"
                               Visibility="{Binding HasFocus, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding ShowFocusedFilesEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="이 체크인의 변경 파일 목록이 없습니다." FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource WlGlassMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text="페이로드 files 배열이 비어 있거나 필드명이 다릅니다."
                                   FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,10"
                                  Visibility="{Binding HasFocusedFiles, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="흐린 항목은 숨김(메타/비후보)입니다. 클릭하면 포함됩니다."
                                       FontSize="11" Foreground="#94A3B8" Margin="4,0,4,8"
                                       Visibility="{Binding HasFocusedHiddenFiles, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding FocusedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand"
                                                Command="{Binding DataContext.ToggleFileIncludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding IncludeHint}"
                                                Margin="0,0,0,4"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Style="{StaticResource GlassImportFileRow}"
                                                            Opacity="{Binding RowOpacity}"
                                                            ToolTip="{Binding ServerPath}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Top"
                                                                    ToolTip="{Binding ChangeTypeMark}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource WlGlassChipBg}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource WlGlassDeployDoneBg}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                                                                <Setter Property="Background" Value="#F8EAEA" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource WlGlassChipBg}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Image Source="{StaticResource CodeLightIcon}" Width="14" Height="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="#94A3B8"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                                               Text="숨김"
                                                                               Visibility="{Binding IsDimmed, Converter={StaticResource BoolToVis}}" />
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource WlGlassInk}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding ServerPath}" FontSize="11" Foreground="#94A3B8"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding ChangeType}" FontSize="11"
                                                                           Foreground="{StaticResource WlGlassMuted}"
                                                                           Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="14,10,16,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                CornerRadius="0,0,14,14"
                Background="#B8FFFFFF"
                Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource WlGlassMuted}"
                           Text="{Binding SelectedCount, StringFormat={}{0}건 선택됨}"
                           Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GlassGhostButton}" Content="취소"
                            Command="{Binding CloseCommand}" />
                    <Button Style="{StaticResource GlassAccentButton}" Content="가져오기"
                            Command="{Binding FetchSessionQueryCommand}"
                            IsEnabled="{Binding CanFetchSessionQuery}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource GlassAccentButton}"
                            Content="{Binding ConfirmButtonLabel}"
                            Command="{Binding ConfirmCommand}"
                            IsEnabled="{Binding CanConfirm}"
                            Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
