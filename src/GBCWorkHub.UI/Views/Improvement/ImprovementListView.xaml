<UserControl x:Class="GBCWorkHub.UI.Views.Improvement.ImprovementListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls"
             xmlns:imp="clr-namespace:GBCWorkHub.UI.ViewModels.Improvement"
             xmlns:views="clr-namespace:GBCWorkHub.UI.Views.Improvement"
             x:Name="ImpRoot">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/WorkLogGlassStyles.xaml" />
                <ResourceDictionary Source="/GBCWorkHub;component/Assets/SkeletonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 업무일지와 같이 쓰는 GlassTicketRowStyle의 hover가 이 목록에서는 너무 어둡게 느껴져서
                 여기서만 옅게 override(업무일지 쪽 스타일은 그대로 둔다) -->
            <Style x:Key="ImprovementTicketRowStyle" TargetType="Border" BasedOn="{StaticResource GlassTicketRowStyle}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E6FFFFFF" />
                        <Setter Property="BorderBrush" Value="{StaticResource WlGlassRowBorder}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- 목록: 업무일지 WorkLogListView와 동일한 로직 — 목록/작성·상세가 각자 독립된
             글래스 배경(구름 장식 포함)을 갖는 별개의 "페이지"로 전환된다. -->
        <Grid Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
              Background="{StaticResource WlGlassAtmosphereBrush}" ClipToBounds="True">
            <Ellipse Width="520" Height="520" Fill="#338BB4E0"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-240,-180,0" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" Fill="#288FBFB8"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-180" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="80" />
                </Ellipse.Effect>
            </Ellipse>

            <Grid Margin="24,68,24,24" HorizontalAlignment="Stretch">
            <!-- 업무일지 목록과 동일하게 최대 1180px로 제한하고 가운데 정렬(넓은 화면에서 카드가
                 지나치게 늘어나지 않게) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    MaxWidth="1180">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 툴바: 필터 + 검색 + 등록 (업무일지 툴바와 동일하게 아이콘 버튼을 오른쪽에 도킹) -->
                    <Border Grid.Row="0" Style="{StaticResource GlassSurfaceStyle}" Padding="14,12" Margin="0,0,0,14">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassToolbarIconButton}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="새로고침">
                                    <Image Source="{StaticResource RefreshLightIcon}" Width="18" Height="18" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource GlassToolbarIconButton}"
                                        Command="{Binding NewRequestCommand}"
                                        ToolTip="새 요청 등록" Margin="0">
                                    <Image Source="{StaticResource ChatPlusFillIcon}" Width="22" Height="22"
                                           Stretch="Uniform" SnapsToDevicePixels="True" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 사이트 선택: 업무일지와 동일한 라벨 버튼 + 칩 팝업 -->
                                <Button x:Name="SiteLabelButton" Style="{StaticResource GlassSiteLabelButton}"
                                        Click="SiteLabelButton_Click" ToolTip="사이트 선택">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FilterSite}"
                                                   FontSize="{StaticResource FontSize.Xl}" FontWeight="Bold"
                                                   Foreground="{StaticResource WlGlassInk}" VerticalAlignment="Center" />
                                        <Image Width="8" Height="8" Margin="5,1,0,0" VerticalAlignment="Center" Opacity="0.7" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{StaticResource ExpandDownIcon}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSitePickerOpen, ElementName=ImpRoot}" Value="True">
                                                            <Setter Property="Source" Value="{StaticResource ExpandUpIcon}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                </Button>
                                <!-- IsOpen은 ViewModel이 아니라 ImpRoot(View)의 로컬 상태에 바인딩 —
                                     이 ViewModel은 관리자 화면에도 동시에 임베드되므로 공유 상태로 두면
                                     안 보이는 사본의 팝업까지 같이 열려버린다. -->
                                <Popup IsOpen="{Binding IsSitePickerOpen, ElementName=ImpRoot, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=SiteLabelButton}"
                                       Placement="Bottom" HorizontalOffset="-4" VerticalOffset="6"
                                       AllowsTransparency="True" PopupAnimation="None" StaysOpen="False"
                                       Opened="Popup_Opened">
                                    <Border Background="Transparent" BorderThickness="0" Padding="2,4,0,6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#3B5070" />
                                        </Border.Effect>
                                        <ItemsControl ItemsSource="{Binding SiteFilterOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GlassSiteChipButton}" Content="{Binding}"
                                                            Command="{Binding DataContext.SelectSiteCommand, ElementName=ImpRoot}"
                                                            CommandParameter="{Binding}"
                                                            Click="SiteChip_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>

                                <!-- 검색: 업무일지와 동일한 밑줄 스타일 -->
                                <Border Width="220" Height="30" Background="Transparent" Margin="4,2,10,2" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBlock Text="제목/설명 검색" FontSize="{StaticResource FontSize.Base}" Foreground="#94A3B8"
                                                           Margin="2,0,0,4" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent"
                                                         Padding="2,0,4,4" FontSize="{StaticResource FontSize.Base}"
                                                         VerticalContentAlignment="Bottom" />
                                            </Grid>
                                            <Image Grid.Column="1" Source="{StaticResource SearchLightIcon}"
                                                   Width="14" Height="14" Margin="0,0,2,4"
                                                   VerticalAlignment="Bottom" Opacity="0.65" IsHitTestVisible="False" />
                                        </Grid>
                                        <Rectangle Grid.Row="1" Height="0.8" Fill="#222222" Opacity="0.65" SnapsToDevicePixels="True" />
                                    </Grid>
                                </Border>

                                <!-- 필터: 업무일지처럼 아이콘을 눌러야 유형/상태 드롭다운이 펼쳐진다 -->
                                <Button Style="{StaticResource GlassToolbarIconButton}" Margin="0,0,8,0"
                                        Click="FilterButton_Click" ToolTip="필터">
                                    <Grid>
                                        <Image Source="{StaticResource FilterSlidersIcon}" Width="16" Height="16" />
                                        <Ellipse Width="7" Height="7" Fill="#4F67D8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,-1,-1,0" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Button>
                                <!-- 유형/상태 필터: 업무일지 필터 알약(Pill)+팝업과 동일한 UI -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsFilterExpanded, ElementName=ImpRoot, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Button x:Name="TypeFilterPill" Style="{StaticResource GlassFilterTitlePill}"
                                                Click="TypeFilterPill_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeFilterDisplayLabel}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="120"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           VerticalAlignment="Center" />
                                                <Image Width="7" Height="7" Margin="3,1,0,0" VerticalAlignment="Center" Opacity="0.7" Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="{StaticResource ExpandDownIcon}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTypeMenuOpen, ElementName=ImpRoot}" Value="True">
                                                                    <Setter Property="Source" Value="{StaticResource ExpandUpIcon}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                        <Popup PlacementTarget="{Binding ElementName=TypeFilterPill}"
                                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="6"
                                               AllowsTransparency="True" PopupAnimation="None" StaysOpen="False"
                                       Opened="Popup_Opened">
                                            <Popup.IsOpen>
                                                <Binding Path="IsTypeMenuOpen" ElementName="ImpRoot" Mode="TwoWay" />
                                            </Popup.IsOpen>
                                            <Border Background="Transparent" BorderThickness="0"
                                                    Padding="2,4,0,2" RenderTransformOrigin="0,0" Opacity="0.5" MaxWidth="260">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#3B5070" />
                                                </Border.Effect>
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                </Border.RenderTransform>
                                                <ItemsControl ItemsSource="{Binding TypeFilterOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding}"
                                                                    Command="{Binding DataContext.SelectTypeFilterCommand, ElementName=ImpRoot}"
                                                                    CommandParameter="{Binding}" Click="TypeChip_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource GlassFilterChipButton}">
                                                                        <Style.Triggers>
                                                                            <!-- 지금 선택된 값과 같은 칩만 색을 다르게 해서 선택 여부를 표시 -->
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{StaticResource GlassStringEquals}">
                                                                                        <Binding Path="." />
                                                                                        <Binding Path="DataContext.FilterType" ElementName="ImpRoot" />
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Background" Value="#3B82F6" />
                                                                                <Setter Property="Foreground" Value="White" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <Grid Margin="6,0,0,0">
                                        <Button x:Name="StatusFilterPill" Style="{StaticResource GlassFilterTitlePill}"
                                                Click="StatusFilterPill_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusFilterDisplayLabel}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="120"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           VerticalAlignment="Center" />
                                                <Image Width="7" Height="7" Margin="3,1,0,0" VerticalAlignment="Center" Opacity="0.7" Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="{StaticResource ExpandDownIcon}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStatusMenuOpen, ElementName=ImpRoot}" Value="True">
                                                                    <Setter Property="Source" Value="{StaticResource ExpandUpIcon}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                        <Popup PlacementTarget="{Binding ElementName=StatusFilterPill}"
                                               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="6"
                                               AllowsTransparency="True" PopupAnimation="None" StaysOpen="False"
                                       Opened="Popup_Opened">
                                            <Popup.IsOpen>
                                                <Binding Path="IsStatusMenuOpen" ElementName="ImpRoot" Mode="TwoWay" />
                                            </Popup.IsOpen>
                                            <Border Background="Transparent" BorderThickness="0"
                                                    Padding="2,4,0,2" RenderTransformOrigin="0,0" Opacity="0.5" MaxWidth="260">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#3B5070" />
                                                </Border.Effect>
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                </Border.RenderTransform>
                                                <ItemsControl ItemsSource="{Binding StatusFilterOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding}"
                                                                    Command="{Binding DataContext.SelectStatusFilterCommand, ElementName=ImpRoot}"
                                                                    CommandParameter="{Binding}" Click="StatusChip_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource GlassFilterChipButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{StaticResource GlassStringEquals}">
                                                                                        <Binding Path="." />
                                                                                        <Binding Path="DataContext.FilterStatus" ElementName="ImpRoot" />
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Background" Value="#3B82F6" />
                                                                                <Setter Property="Foreground" Value="White" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 로딩 스켈레톤 -->
                    <StackPanel Grid.Row="1" Margin="16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SkeletonWorkLogRowStyle}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource SkeletonWorkLogRowStyle}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource SkeletonWorkLogRowStyle}" Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- 빈 목록: 문구 하나만, 등록 버튼 없음 -->
                    <TextBlock Grid.Row="1" Text="요청 사항이 없어요" FontSize="{StaticResource FontSize.Md}" Foreground="#94A3B8"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />

                    <!-- 목록 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16"
                                  Visibility="{Binding ShowListContent, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type imp:ImprovementListItemViewModel}">
                                    <Border Style="{StaticResource ImprovementTicketRowStyle}" Cursor="Hand"
                                            MouseLeftButtonUp="ListItemRow_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 유형 배지: 뱃지 자체는 내용 길이대로(내부 패딩 8,3 동일), 이 칸 안에서는
                                                 가운데 정렬 — 칸 너비 자체가 고정이라 옆 제목은 항상 같은 자리에서 시작함 -->
                                            <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    CornerRadius="10" Padding="8,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFEDD5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TypeLabel}" Value="기능 개선">
                                                                <Setter Property="Background" Value="#DBEAFE" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TypeLabel}" Value="기타">
                                                                <Setter Property="Background" Value="#EDE9FE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="{StaticResource FontSize.Md}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#C2410C" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeLabel}" Value="기능 개선">
                                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TypeLabel}" Value="기타">
                                                                    <Setter Property="Foreground" Value="#6D28D9" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" MinWidth="0" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TicketNoText}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Md}" Foreground="#94A3B8" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Md}" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding AuthorName}" FontSize="{StaticResource FontSize.Sm}" Foreground="#64748B" />
                                                    <TextBlock Text=" (삭제된 계정)" FontSize="{StaticResource FontSize.Sm}" Foreground="#94A3B8"
                                                               Visibility="{Binding HasDeletedAuthorSuffix, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text=" · " FontSize="{StaticResource FontSize.Sm}" Foreground="#CBD5E1" />
                                                    <TextBlock Text="{Binding SiteCode}" FontSize="{StaticResource FontSize.Sm}" Foreground="#64748B" />
                                                    <TextBlock Text=" · " FontSize="{StaticResource FontSize.Sm}" Foreground="#CBD5E1" />
                                                    <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="{StaticResource FontSize.Sm}" Foreground="#64748B" />
                                                    <TextBlock Text=" · " FontSize="{StaticResource FontSize.Sm}" Foreground="#CBD5E1" />
                                                    <TextBlock Text="{Binding CreatedAtText}" FontSize="{StaticResource FontSize.Sm}" Foreground="#64748B" />
                                                    <Image Source="{StaticResource SadFaceIcon}" Width="13" Height="13" Margin="8,0,3,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ReproducedCount}" FontSize="{StaticResource FontSize.Sm}" Foreground="#64748B" VerticalAlignment="Center" />
                                                    <Image Source="{StaticResource HappyFaceIcon}" Width="13" Height="13" Margin="8,0,3,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding NotReproducedCount}" FontSize="{StaticResource FontSize.Sm}" Foreground="#64748B" VerticalAlignment="Center" />
                                                    <Image Source="{StaticResource CommentLineIcon}" Width="13" Height="13" Margin="8,0,3,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CommentCount}" FontSize="{StaticResource FontSize.Sm}" Foreground="#64748B" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        CornerRadius="10" Padding="8,3" Margin="0,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E2E8F0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="확인중">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="수정중">
                                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="해결">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="반려">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource FontSize.Md}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusLabel}" Value="확인중">
                                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLabel}" Value="수정중">
                                                                        <Setter Property="Foreground" Value="#B45309" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLabel}" Value="해결">
                                                                        <Setter Property="Foreground" Value="#047857" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLabel}" Value="반려">
                                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding ResolvedNoteText}" FontSize="{StaticResource FontSize.Xs}" Foreground="#16A34A" Margin="0,4,0,0"
                                                           HorizontalAlignment="Right"
                                                           Visibility="{Binding HasResolvedNote, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 페이징 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12"
                                Visibility="{Binding ShowListContent, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource GlassPagerNavButton}" Command="{Binding PrevPageCommand}" ToolTip="이전">
                            <Image Source="{StaticResource ExpandLeftIcon}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center" Margin="12,0" Foreground="#64748B" />
                        <Button Style="{StaticResource GlassPagerNavButton}" Command="{Binding NextPageCommand}" ToolTip="다음">
                            <Image Source="{StaticResource ExpandRightIcon}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <!-- 사이트/유형/상태 팝업 뒤 전체 배경 딤 처리(업무일지 사이트/필터 팝업과 동일한 관례) -->
            <Border Background="#66000000" Panel.ZIndex="50"
                    Visibility="{Binding IsAnyPickerOpen, ElementName=ImpRoot, Converter={StaticResource BoolToVis}}"
                    MouseLeftButtonUp="PickerScrim_MouseLeftButtonUp" />
        </Grid>

        <!-- 등록/상세: 목록과 완전히 분리된 자기만의 페이지 — 업무일지 WorkLogListView의
             작성/상세 페이지와 동일한 구조(자체 배경 + 구름 장식 + 여백)를 그대로 따른다. -->
        <Grid Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}}"
              Background="{StaticResource WlGlassAtmosphereBrush}" ClipToBounds="True">
            <Ellipse Width="520" Height="520" Fill="#338BB4E0"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-240,-180,0" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="460" Height="460" Fill="#288FBFB8"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-180" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="80" />
                </Ellipse.Effect>
            </Ellipse>

            <Grid Margin="24,68,24,24">
                <!-- 목록 페이지와 동일하게 최대 1180px로 제한하고 가운데 정렬 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                        MaxWidth="1180">
                    <views:ImprovementEditDialog DataContext="{Binding EditDialog}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
