                        <Style TargetType="Button" BasedOn="{StaticResource AdminNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPcsSection}" Value="True">
                                    <Setter Property="Background" Value="#CCE8F0FF" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="사용자" Command="{Binding SelectSectionCommand}" CommandParameter="Users">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AdminNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsersSection}" Value="True">
                                    <Setter Property="Background" Value="#CCE8F0FF" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="점유 현황" Command="{Binding SelectSectionCommand}" CommandParameter="Occupancy">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AdminNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOccupancySection}" Value="True">
                                    <Setter Property="Background" Value="#CCE8F0FF" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="접속 이력" Command="{Binding SelectSectionCommand}" CommandParameter="UsageLogs">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AdminNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsageLogsSection}" Value="True">
                                    <Setter Property="Background" Value="#CCE8F0FF" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="업무 기록" Command="{Binding SelectSectionCommand}" CommandParameter="WorkLogs">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AdminNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkLogsSection}" Value="True">
                                    <Setter Property="Background" Value="#CCE8F0FF" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="개선사항 관리" Command="{Binding SelectSectionCommand}" CommandParameter="Requests">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AdminNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRequestsSection}" Value="True">
                                    <Setter Property="Background" Value="#CCE8F0FF" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="2">
            <!-- Requests: MainViewModel.Improvement와 동일 인스턴스 재사용(사용자 화면과 동일 데이터/뷰).
                 ImprovementListView는 자체 글래스 배경(Margin=24 전체)을 갖고 있어 WorkLogs 섹션과
                 동일하게 GlassSurfaceStyle 카드로 감싸고 음수 Margin으로 잘라내 이 패널 안에 맞춘다. -->
            <Grid Visibility="{Binding IsRequestsSection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource GlassSurfaceStyle}" Padding="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                    <imp:ImprovementListView DataContext="{Binding DataContext.Improvement, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="-8,-52,-8,-8" />
                </Border>
            </Grid>

            <!-- Users -->
            <Grid Visibility="{Binding IsUsersSection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource GlassSurfaceStyle}" Padding="16">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Background="#A6FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="10,6" Margin="0,0,0,12" Width="280" HorizontalAlignment="Left">
                            <TextBox Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                                     Background="Transparent" FontSize="13" />
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Margin="4,8,4,0" Text="{Binding AdminStatusMessage}"
                                   FontSize="12" Foreground="#DC2626" TextWrapping="Wrap"
                                   Visibility="{Binding HasAdminStatusMessage, Converter={StaticResource BoolToVis}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AdminUsers}" ItemTemplate="{StaticResource AdminUserCardTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- PCs -->
            <Grid Visibility="{Binding IsPcsSection, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassSurfaceStyle}" Padding="14">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="2,2,2,8" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}" Margin="8,0,0,0"
                                    ToolTip="새 PC" Command="{Binding NewAdminPcCommand}">
                                <Image Source="{StaticResource AddRingIcon}" Width="18" Height="18" />
                            </Button>
                            <ItemsControl ItemsSource="{Binding AdminPcSites}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Code}" Style="{StaticResource AdminSiteChip}"
                                                Command="{Binding DataContext.SelectAdminPcSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Code}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Background="#A6FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="10,6" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left">
                            <TextBox Text="{Binding PcSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                                     Background="Transparent" FontSize="13" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AdminPcGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#475569" Margin="12,8,12,4"
                                                       Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Computers}"
                                                          ItemTemplate="{StaticResource AdminPcCardTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ctrl:UniformWrapPanel MinItemWidth="150" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassSurfaceStyle}" Padding="18"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <TextBlock Text="PC를 선택하세요."
                                   FontSize="13" Foreground="#94A3B8"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding HasPcDetail, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <Grid Visibility="{Binding HasPcDetail, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AdminFieldLabel}" Text="사이트" />
                                    <TextBox Style="{StaticResource AdminTextBox}" Tag="AURORA"
                                             Text="{Binding AdminDraftSite, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource AdminFieldLabel}" Text="PC 이름" />
                                    <TextBox Style="{StaticResource AdminTextBox}" Tag="BESTCARE-01"
                                             Text="{Binding AdminDraftPcName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource AdminFieldLabel}" Text="IP" />
                                    <TextBox Style="{StaticResource AdminTextBox}" Tag="123.45.67.8"
                                             Text="{Binding AdminDraftPcIp, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource AdminFieldLabel}" Text="팀" />
                                    <TextBox Style="{StaticResource AdminTextBox}" Tag="진료지원"
                                             Text="{Binding AdminDraftTeamName, UpdateSourceTrigger=PropertyChanged}" />

                                    <Border Style="{StaticResource RemoteUsageHistoryRowStyle}" Margin="0,8,0,8" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="Domain" Style="{StaticResource RemoteUsageHistoryColHeader}" FontWeight="SemiBold" />
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ID" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{StaticResource AdminCredLineTextBox}"
                                                         Text="{Binding AdminDraftDomainId, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="PW" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{StaticResource AdminCredLineTextBox}"
                                                         Text="{Binding AdminDraftDomainPw, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RemoteUsageHistoryRowStyle}" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                            Visibility="{Binding ShowAdminExtraCredFields, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AdminExtraCredTitle}" Style="{StaticResource RemoteUsageHistoryColHeader}" FontWeight="SemiBold" />
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ID" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{StaticResource AdminCredLineTextBox}"
                                                         Text="{Binding AdminDraftExtraId, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="PW" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{StaticResource AdminCredLineTextBox}"
                                                         Text="{Binding AdminDraftExtraPw, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource RemoteUsageHistoryRowStyle}" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="COMMENT" Style="{StaticResource RemoteUsageHistoryColHeader}" FontWeight="SemiBold" />
                                            <TextBox Style="{StaticResource AdminMultilineTextBox}" Margin="0" Tag="접속 시 주의"
                                                     Text="{Binding AdminDraftPcComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="56" Height="Auto" />
                                        </StackPanel>
                                    </Border>

                                    <CheckBox Content="AGENT 설치 완료" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"
                                              Margin="0,10,0,0"
                                              IsChecked="{Binding AdminDraftAgentInstalled, Mode=TwoWay}" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 저장/삭제: 컨테이너 맨 아래 fixed -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="{Binding AdminPcStatusMessage}" FontSize="12" Foreground="#DC2626"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,160,0" />
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="삭제" Style="{StaticResource AdminDangerButton}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DeleteAdminPcCommand}"
                                            Visibility="{Binding CanDeleteAdminPc, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="2" Content="저장" Style="{StaticResource AdminPrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding SaveAdminPcCommand}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Occupancy -->
            <Grid Visibility="{Binding IsOccupancySection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource GlassSurfaceStyle}" Padding="16">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}" Margin="8,0,0,0"
                                    ToolTip="새로고침" Command="{Binding ReloadOccupancyCommand}">
                                <Image Source="{StaticResource RefreshLightIcon}" Width="18" Height="18" />
                            </Button>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="12.5" Foreground="#64748B">
                                <Run Text="접속 중 " />
                                <Run Text="{Binding OccupancyBusyCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E293B" />
                                <Run Text="대" />
                            </TextBlock>
                            <Border Background="#A6FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="10,6" Width="280" HorizontalAlignment="Left">
                                <TextBox Text="{Binding OccupancySearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                                         Background="Transparent" FontSize="13" />
                            </Border>
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Bottom" Margin="4,8,4,0" Text="{Binding OccupancyStatusMessage}"
                                   FontSize="12" Foreground="#DC2626" TextWrapping="Wrap"
                                   Visibility="{Binding HasOccupancyStatusMessage, Converter={StaticResource BoolToVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="점유 현황" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#475569" Margin="4,0,4,8" />
                                <ItemsControl ItemsSource="{Binding OccupancyStats}"
                                              ItemTemplate="{StaticResource AdminOccupancyStatRowTemplate}"
                                              Margin="0,0,0,16" />

                                <TextBlock Text="점유 세션 (강제 해제)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#475569" Margin="4,0,4,8" />
                                <ItemsControl ItemsSource="{Binding Occupancies}" ItemTemplate="{StaticResource AdminOccupancyCardTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Usage Logs -->
            <Grid Visibility="{Binding IsUsageLogsSection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource GlassSurfaceStyle}" Padding="16"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}" Margin="8,0,0,0"
                                    ToolTip="새로고침" Command="{Binding ReloadUsageLogsCommand}">
                                <Image Source="{StaticResource RefreshLightIcon}" Width="18" Height="18" />
                            </Button>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Button Command="{Binding OpenUsageLogDatePickerCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#A6FFFFFF" BorderBrush="#F2FFFFFF"
                                                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#CCE8F0FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{StaticResource DateRangeFillIcon}" Width="16" Height="16"
                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UsageLogDateChipText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#334155" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="2,0,0,0" Padding="0" Width="22" Height="22"
                                        VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="기간 조건 지우기"
                                        Command="{Binding ClearUsageLogDateFilterCommand}"
                                        Visibility="{Binding HasUsageLogDateFilter, Converter={StaticResource BoolToVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="×" FontSize="13" Foreground="#64748B"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="12.5" Foreground="#64748B">
                                <Run Text="{Binding UsageLogCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E293B" />
                                <Run Text="건" />
                            </TextBlock>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding UsageLogSites}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Code}" Style="{StaticResource AdminSiteChip}"
                                                    Command="{Binding DataContext.SelectUsageLogSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Code}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="#A6FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="10,6" Width="320" HorizontalAlignment="Left">
                                    <TextBox Text="{Binding UsageLogSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                                             Background="Transparent" FontSize="13" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <ItemsControl ItemsSource="{Binding UsageLogSiteGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#1E293B" Margin="4,0,4,8"
                                                       Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding DateGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,10">
                                                            <TextBlock Text="{Binding DateHeader}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="#475569" Margin="8,0,8,4" />
                                                            <ItemsControl ItemsSource="{Binding Items}"
                                                                          ItemTemplate="{StaticResource AdminUsageLogCardTemplate}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" Margin="4,8,4,0" Text="{Binding UsageLogStatusMessage}"
                                   FontSize="12" Foreground="#DC2626" TextWrapping="Wrap"
                                   Visibility="{Binding HasUsageLogStatusMessage, Converter={StaticResource BoolToVis}}" />
