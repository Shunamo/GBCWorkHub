<UserControl x:Class="GBCWorkHub.UI.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GBCWorkHub.UI.Converters"
             xmlns:ctrl="clr-namespace:GBCWorkHub.UI.Controls"
             xmlns:wl="clr-namespace:GBCWorkHub.UI.Views.WorkLog"
             xmlns:imp="clr-namespace:GBCWorkHub.UI.Views.Improvement"
             x:Name="AdminRoot"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GBCWorkHub.UI;component/Assets/WorkLogEditGlassOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="AdminPickerCard" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#D5DEE8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#3B5070" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AdminPickerGhostButton" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#D5DEE8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AdminPickerAccentButton" TargetType="Button" BasedOn="{StaticResource AdminPickerGhostButton}">
                <Setter Property="Background" Value="#76ADFF" />
                <Setter Property="BorderBrush" Value="#76ADFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>
            <Style x:Key="AdminCalendarDayButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.28" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <Style x:Key="AdminNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="AdminTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Base}" />
            <Setter Property="Foreground" Value="{StaticResource WlGlassInk}" />
            <Setter Property="CaretBrush" Value="{StaticResource WlGlassAccent}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#99FFFFFF" BorderBrush="#D9FFFFFF" BorderThickness="1"
                                CornerRadius="10" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#2F4466" />
                            </Border.Effect>
                            <Grid>
                                <!-- 힌트는 오른쪽 / 캐럿은 왼쪽 (login prompt와 동일) -->
                                <TextBlock Text="{TemplateBinding Tag}" Margin="16,0,10,0"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           Foreground="#94A3B8" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0,10,0"
                                              VerticalAlignment="Center" Focusable="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdminMultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource AdminTextBox}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#99FFFFFF" BorderBrush="#D9FFFFFF" BorderThickness="1"
                                CornerRadius="10" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#2F4466" />
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" Margin="16,6,10,6"
                                           VerticalAlignment="Top"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           Foreground="#94A3B8" IsHitTestVisible="False"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,6,10,6"
                                              VerticalAlignment="Stretch" Focusable="False"
                                              VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdminGhostButton" TargetType="Button">
            <Setter Property="Background" Value="#A6FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#F2FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE8F0FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F67D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdminPrimaryButton" TargetType="Button" BasedOn="{StaticResource AdminGhostButton}">
            <Setter Property="Background" Value="#4F67D8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B52C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdminDangerButton" TargetType="Button" BasedOn="{StaticResource AdminGhostButton}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Background" Value="#FEF2F2" />
        </Style>
        <Style x:Key="AdminSiteChip" TargetType="Button">
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#F2FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE8F0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#CCE8F0FF" />
                    <Setter Property="Foreground" Value="#1E293B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush" Value="#4F67D8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AdminCredLineTextBox" TargetType="TextBox" BasedOn="{StaticResource AdminTextBox}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style x:Key="AdminPcCardBorder" TargetType="Border" BasedOn="{StaticResource RemoteComputerCardStyle}">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#331E293B" />
                    <Setter Property="BorderBrush" Value="{StaticResource RemoteCardSelectedBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="AdminPcCardTemplate">
            <Border Style="{StaticResource AdminPcCardBorder}"
                    MouseLeftButtonUp="AdminPcCard_MouseLeftButtonUp">
                <StackPanel HorizontalAlignment="Stretch">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Image Width="72" Height="72" Stretch="Uniform"
                               Source="{StaticResource PcMonitorIcon}" />
                        <Ellipse Width="9" Height="9" Fill="#FACC15"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                 ToolTip="AGENT 설치 완료"
                                 Visibility="{Binding AgentInstalled, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- PC/점유 카드와 공유하는 AdminPcCardBorder의 선택 강조가 너무 진해서(진한 남색 배경 +
             굵은 파란 테두리) 사용자 카드만 옅게 override(다른 카드 쪽은 그대로 둔다) -->
        <Style x:Key="AdminUserCardBorder" TargetType="Border" BasedOn="{StaticResource AdminPcCardBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1A3B82F6" />
                    <Setter Property="BorderBrush" Value="#663B82F6" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="AdminUserCardTemplate">
            <Border Style="{StaticResource AdminUserCardBorder}" Margin="8,6" Padding="14,12"
                    MouseLeftButtonUp="AdminUserCard_MouseLeftButtonUp">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AdminGhostButton}" Padding="7"
                                Command="{Binding DataContext.ManageAdminUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanManageProfile, Converter={StaticResource BoolToVis}}"
                                ToolTip="사용자 정보 관리">
                            <Image Source="{StaticResource GearFillIcon}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource RemoteInUseBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource RemoteAvailableBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#64748B" Margin="16,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AdminOccupancyStatRowTemplate">
            <Border Background="#66FFFFFF" BorderBrush="#F2FFFFFF" BorderThickness="1" CornerRadius="12"
                    Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" MinWidth="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TeamName}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="AURORA " Foreground="#94A3B8" FontSize="11" />
                        <Run Text="{Binding AuroraCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="CMC " Foreground="#94A3B8" FontSize="11" />
                        <Run Text="{Binding CmcCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" />
                    </TextBlock>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="RC " Foreground="#94A3B8" FontSize="11" />
                        <Run Text="{Binding RcCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" />
                    </TextBlock>
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="MNGHA " Foreground="#94A3B8" FontSize="11" />
                        <Run Text="{Binding MnghaCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" />
                    </TextBlock>
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"
                               FontWeight="SemiBold" Foreground="#4F67D8">
                        <Run Text="총합 " />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AdminOccupancyCardTemplate">
            <Border Style="{StaticResource AdminPcCardBorder}" Margin="8,6" Padding="14,12"
                    MouseLeftButtonUp="AdminOccupancyCard_MouseLeftButtonUp">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="강제 해제" Style="{StaticResource AdminDangerButton}" FontSize="12"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.ForceReleaseOccupancyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanForceRelease, Converter={StaticResource BoolToVis}}" />
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{StaticResource RemoteInUseBrush}" />
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#64748B" Margin="16,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="16,4,0,0">
                            <Run Text="{Binding StartedAtText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding RemoteAccessIp, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AdminUsageLogCardTemplate">
            <Border Style="{StaticResource AdminPcCardBorder}" Margin="8,6" Padding="14,12"
                    MouseLeftButtonUp="AdminUsageLogCard_MouseLeftButtonUp">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                        <Button Content="수정" Style="{StaticResource AdminGhostButton}" Margin="0,0,6,0" FontSize="12"
                                Command="{Binding DataContext.EditUsageLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="삭제" Style="{StaticResource AdminDangerButton}" FontSize="12"
                                Command="{Binding DataContext.DeleteUsageLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <Border Background="#EEF2FF" CornerRadius="6" Padding="6,2" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowSiteBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SiteDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4338CA" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AdminWorkLogCardTemplate">
            <Border Margin="8,4" Padding="14,12" Cursor="Hand"
                    MouseLeftButtonUp="AdminWorkLogCard_MouseLeftButtonUp"
                    Background="#B8FFFFFF" BorderBrush="#E8EEF5" BorderThickness="1" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#CCE8F0FF" />
                                <Setter Property="BorderBrush" Value="#93B4F5" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                        <Button Content="상세" Style="{StaticResource AdminPrimaryButton}" Margin="0,0,6,0" FontSize="12"
                                Padding="12,6"
                                Command="{Binding DataContext.ViewWorkLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="삭제" Style="{StaticResource AdminDangerButton}" FontSize="12"
                                Command="{Binding DataContext.DeleteWorkLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DateDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#64748B" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="8" Padding="8,3" Margin="0,0,10,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SiteDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#4338CA" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding AuthorDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
